# Game and Harmony DLLs must never be committed.
*.dll

# Fetched or built at build time; the folder itself is recreated by tools/build-mod.sh.
unity/FoodTrucks/Dependencies/
unity/FoodTrucks/Dependencies.meta

# Art: only the finals and the review sheets are kept in git (Peter, 8 October 2026).
art/**/renders/*
!art/**/renders/review-sheet.png
!art/**/renders/look-*.png
art/truck/v1/
art/truck/v2/
art/**/__pycache__/
art/**/.*
art/**/*.log

# The truck art copied in by tools/build-mod.sh; the originals are in art/truck.
unity/FoodTrucks/Vehicles/TruckArt/*.fbx
unity/FoodTrucks/Vehicles/TruckArt/*.png

# The cart and equipment art, likewise; the originals are in art/cart and art/equipment.
unity/FoodTrucks/Vehicles/CartArt/*.fbx
unity/FoodTrucks/Vehicles/CartArt/*.png
unity/FoodTrucks/Vehicles/EquipmentArt/*.fbx
unity/FoodTrucks/Vehicles/EquipmentArt/*.png

# The commissary bay's art, likewise; the originals are in art/commissary.
unity/FoodTrucks/Commissary/BayArt/*.fbx
unity/FoodTrucks/Commissary/BayArt/*.png
unity/FoodTrucks/Vehicles/EquipmentArt/Icons/*.png
unity/FoodTrucks/Vehicles/PropArt/*.fbx
unity/FoodTrucks/Vehicles/PropArt/*.png
