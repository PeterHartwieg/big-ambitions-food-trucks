#!/usr/bin/env python3
"""Food Trucks, played from the command line. Your controls in the game, nothing more.

You run a street food business in Big Ambitions: buy a cart or a truck, rent a space at a commissary, order stock,
hire a crew, set a route and shifts, and watch the money. You only see what a player sees: the clock, your money,
your vehicles and crew, the phone's notices, the buttons on screen, a picture of the screen, and the buildings round
you on the map.

Commands (each also takes --help):

  look                         Where you are, the time, your money, how you feel, what you hold, your vehicles, crew,
                               commissary stock and orders.
  notices [--follow]           Notices and phone texts since you last looked.
  places [--radius M]          Buildings near you: address, type, business, commissaries.
  map filters | map FILTER [--limit N]
                               The city map's highlights: the filters there are, or the buildings one lights, nearest
                               first. For example: commissaries, for_rent, for_rent:ba:buildingtype_residential,
                               business:ba:businesstype_supermarket, offices, nightlife, pitches, yours.
  walk X Z | walk --to PLACE   Walk there on foot, as a click on the ground does. Holding a cart (vehicle ID enter),
                               you push it along. PLACE: address:ADDRESS, bay:SITE (a commissary's bay, to push a
                               cart into it), commissary:SITE (its door), vehicle:ID (beside it) or exit (out of the
                               building you're in). The clock runs at speed 1 while you walk, and stops again if it
                               was stopped.
  use [--radius M] | use ID
                               The things near you that react to a click (a door, a shelf, a till, a bed, a taxi, a
                               building's entrance), or a click on one by its number in the last list. The clock runs
                               at speed 1 while you walk over to it.
  go ADDRESS                   Tell the taxi you got into where to go (address as places or map prints it, e.g.
                               ba:street_secondavenue#8). You get into one with use.
  eat [ITEM]                   Eat from the bag of food you hold.
  floorplan                    The floor you stand on: labelled 0.5 m squares, walls, openings, furniture and use spots.
  place SQUARE | place X Z [--rotation DEG] [--move NAME] [--check]
                               Set down the furniture in the box you hold, on the floor of a building you rent.
                               With --move, pick up furniture already standing there (nearest with NAME in its name)
                               and set it down there instead. SQUARE (for example C4) is the item's anchor on floorplan.
                               --check tries the same placement and reach test, then cancels it without keeping changes.
  drop [X Z]                  Put the box or bag you hold down, still packed, on an editable building's floor
                               (at your feet if no point is given); return a mop to its station. No street drop.
  pickup ID                    Pick up a placed box or bag, by its number in the last use list.
  handtruck                    List nearby hand trucks and the boxes on them.
  handtruck ID grab|load        Grab it (loading what you hold first), or load your held item without grabbing it.
  handtruck ID take ITEM        Take one cargo box by key or name; taking it while pushing also lets go.
  handtruck release            Let go using the game's Park button; its cargo stays on it.
  phone APP                    Open the phone on an app: contacts, employees, bizman, econoview, market, persona or
                               rivals.
  call list | call CONTACT     Your phone's contacts, or call one (by name or id). Its options are then on screen (ui).
  screen NAME [--fetch DIR]    A picture of the screen.
  ui list | ui click TEXT | ui click --id N | ui set ID VALUE | ui type ID TEXT | ui escape
                               The buttons, options, sliders and texts on screen; pressing one, moving a slider, or
                               closing what is open. A click that starts a time skip (sleep, a course) waits for it.
  time pause | time speed N | time until [DAY] HH:MM [--speed N]
                               Pause, set the game speed (at most 20), or let time run until a moment (then pause).
                               DAY is a day number or +N days from today.
  buy truck|cart               Buy a vehicle; it is delivered next to you.
  drive TRUCK PLACE [--speed N]
                               Drive your truck while you sit in it (vehicle ID enter first). PLACE: bay:SITE (its
                               commissary's bay), address:ADDRESS (a building) or stop:N (stop N of the truck's route
                               today). You pull out of your space onto the road, the truck drives itself there with the
                               traffic (the self-driving system, at N times real time, 1 to 3, 3 if left out), and you
                               park on arrival: in the bay, or in a free space by the kerb with the hatch to the
                               pavement. It takes real minutes; the clock runs at speed 1 meanwhile. You stay in the
                               driver's seat: vehicle ID exit gets you out.
  vehicle ID open|close|enter|exit|back_to_hatch|restock|rent_bay
  vehicle ID take|return ITEM [UNITS]
                               Use a vehicle. take/return move stock or equipment between it and the commissary.
  order SITE ITEM BOXES [ITEM BOXES ...]
                               Order stock by phone from a commissary where you rent a space; it arrives at 08:00.
  crew assign VEHICLE EMPLOYEE | crew schedule VEHICLE EMPLOYEE DAY START END [STATION] | crew auto VEHICLE
                               Put a hire on a vehicle's crew; set a shift (whole hours); or auto-fill the week.
  price VEHICLE ITEM DOLLARS|auto
                               Set what a vehicle charges for a food (look shows the item names), or go back to the
                               automatic price.
  route add VEHICLE ADDRESS [--days monday,...] [--open HH:MM --close HH:MM]
  route paste VEHICLE FROM_DAY TO_DAY[,TO_DAY...]|all
                               A vehicle's weekly route: add a stop by a building, or copy one day onto others.
  save NAME                    Save the game (the name must start with "FT playtest").
  load NAME                    Load a save whose name starts with "FT playtest".

How the city works (hints, not a plan):

  - You are a person in the city. You get hungry and tired as the hours pass, and look tells you when it shows. Food
    comes from places that sell it; what you buy is packed for you to eat from or carry.
  - You need a home to sleep in. Buildings for rent are on the map; a building you can't walk into may offer itself
    for rent when you click its entrance. A rented flat starts empty: a bed is furniture, sold in shops, and you set it
    down yourself. Sleep is a click on your bed. Without sleep you collapse, and the hospital sends a bill.
  - You also have a happiness level, the sum of what is going on in your life (look lists it, as the phone's Persona
    app does). Having no home weighs on it; a home, a good sleep, rest and things to do lift it, and some lifts wear
    off after a while. Low happiness wears you out faster and makes sleep restore less, and some staff only stay
    content working for a boss who is happy.
  - Taxis wait in the street; a ride costs money and takes time. Walking is free but slow.
  - A truck is driven, a cart is pushed. A vehicle left where parking isn't allowed is fined; a truck back in its
    commissary's bay for the night is safe.
  - Selling street food needs the city's vendor licence, and a permit for each vehicle. The City of New York sells
    them by phone, and the licence first wants a food safety course, taught at the business school.
  - Staff come through a recruitment agency. It works only with people who have passed the business school's HR
    course, and once you own a cart or a truck it recruits for your street food fleet. A campaign costs money and
    takes days; the candidates it finds wait on your phone, where you hire them, and a hire then joins a vehicle's
    crew.
  - Schools, shops and offices keep opening hours.

If the referee stops the game, every command that acts refuses and says why (the file named by FT_PLAY_STOP)."""
import argparse
import json
import os
import re
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ftlib.bridge import Bridge, BridgeError  # noqa: E402

PREFIX = 'FT playtest'
MAX_SPEED = 20
WEEK = ('monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday')
VEHICLE_OPS = ('open', 'close', 'enter', 'exit', 'back_to_hatch', 'restock', 'rent_bay')
PHONE_APPS = ('contacts', 'employees', 'bizman', 'econoview', 'market', 'persona', 'rivals')
FEELINGS = {'hungry': 'you are hungry', 'very_hungry': 'you are starving', 'tired': 'you are tired',
            'exhausted': 'you are exhausted', 'out_of_energy': 'you have no energy left: you can barely walk and will soon collapse'}
# How long a click may hold a time skip (sleep, a course) before the tool stops waiting, in real seconds.
SKIP_WAIT_S = 600
# How long a drive may take before the tool stops waiting, in real seconds (the self-driving ride gives up after 20 minutes).
DRIVE_WAIT_S = 25 * 60


class Refused(Exception):
    pass


def money(value):
    return '-' if value is None else f"{'-' if value < 0 else ''}${abs(value):,.2f}"


class Play:
    def __init__(self, bridge, out=print, stop_file=None, memory=None):
        self.bridge = bridge
        # Where `notices` remembers what you've read, per game session.
        self.memory = memory or os.environ.get('FT_PLAY_MEMORY') or os.path.expanduser('~/.ft-play.json')
        self.out = out
        self.stop_file = stop_file if stop_file is not None else os.environ.get('FT_PLAY_STOP')

    def call(self, cmd, args=None, timeout_s=30):
        return self.bridge.call(cmd, args or {}, timeout_s)['result']

    def acting(self):
        """Every command that changes the game: refused once the referee stopped it, or outside an FT playtest save."""
        if self.stop_file and os.path.exists(self.stop_file):
            with open(self.stop_file) as f:
                raise Refused('The referee stopped the game: ' + f.read().strip())
        health = self.bridge.health()
        if health.get('scene') != 'city' or not (health.get('save') or '').startswith(PREFIX):
            raise Refused(f"You can only play in a save whose name starts with '{PREFIX}' (now: {health.get('save')!r}, {health.get('scene')}).")

    # ---- looking ----
    def look(self):
        s = self.call('state')
        c = s.get('clock') or {}
        p = s.get('player') or {}
        self.out(f"Day {c.get('day')} ({c.get('weekday')}) {c.get('time')}{', paused' if c.get('paused') else ', speed ' + str(c.get('speed'))}. "
                 f"Money {money(s.get('money'))}.")
        truck = p.get('handtruck')
        where = 'in a taxi' if p.get('riding') else f"pushing {truck['name']} ({truck['id']})" if truck else f"in {p['in_vehicle']}" if p.get('in_vehicle') else f"at the hatch of {p['at_hatch']}" if p.get('at_hatch') else p.get('activity') or 'on foot'
        inside = f", inside {p['inside']}" if p.get('inside') else ''
        self.out(f"You: {where}{inside} at x {p.get('x')}, z {p.get('z')}.")
        needs = p.get('needs') or {}
        feelings = [FEELINGS.get(w, w.replace('_', ' ')) for w in needs.get('warnings') or []]
        self.out(f"How you feel: energy {needs.get('energy')}, hunger {needs.get('hunger')}, happiness {needs.get('happiness')} (of {needs.get('max', 100)})"
                 + (f"; {'; '.join(feelings)}." if feelings else '.'))
        for m in needs.get('happiness_modifiers') or []:
            name = m.get('name') or m.get('type', '').replace('ba:happinessmodifier_', '').replace('_', ' ')
            amount = m.get('amount')
            left = m.get('hours_left')
            when = (f", {round(left / 24)} days left" if left > 24 else f", {left} hours left") if m.get('shows_time') and left is not None else ''
            self.out(f"  happiness: {name}{f' {amount:+d}%' if amount is not None else ''}{when}")
        if p.get('clock_held_by'): self.out(f"  The clock is held by: {p['clock_held_by']}.")
        hands = p.get('hands')
        if truck: self.out(f"  On the hand truck: {self.cargo_text(truck.get('contents'))}.")
        if hands:
            inside_ = ', '.join(f"{c['amount']} {c['item']}{'' if c.get('paid', True) else ' (not paid)'}" for c in hands.get('contents') or [])
            self.out(f"You hold: {hands['item']}{': ' + inside_ if inside_ else ''}.")
        homes = p.get('homes')
        if homes is not None: self.out(f"Home: {', '.join(homes) if homes else 'none'}.")
        lic = s.get('licence') or {}
        self.out(f"Licence: {'until day ' + str(lic['until_day']) if lic.get('until_day') else 'none'}, permits {lic.get('permits', 0)}, "
                 f"food safety course {'done' if lic.get('course_done') else 'not done'}.")
        for t in lic.get('todos') or []:
            self.out(f"  to-do: {t.get('text') or t['kind'].replace('_', ' ')}")
        for v in s.get('vehicles') or []:
            com = v.get('commissary') or {}
            self.out(f"{v['kind'].title()} {v['id']}: {'OPEN' if v.get('open') else 'closed'}, serving {v.get('serving')}, "
                     f"{'parked legally' if v.get('legal') else 'not parked legally'} at x {v.get('x')}, z {v.get('z')}"
                     f"{', in the bay at ' + com['bay_site'] if com.get('in_bay') else ''}; space at {com.get('site') or 'no commissary'}.")
            self.out(f"  equipment: {', '.join(x['item'] for x in v.get('pieces') or []) or 'none'}; "
                     f"stock: {', '.join(str(x['amount']) + ' ' + x['item'] + (f" (price ${x['set_price']:.2f})" if x.get('set_price') is not None else '') for x in v.get('stock') or []) or 'none'}; crew: {', '.join(v.get('crew') or []) or 'none'}.")
            route = v.get('route') or {}
            for d in route.get('week') or []:
                if d['stops']:
                    self.out(f"  {d['day']}: " + '; '.join(f"{x['open']}-{x['close']} at x {x['x']}, z {x['z']}" for x in d['stops']))
            for shift in route.get('shifts') or []:
                self.out(f"  shifts of {shift['employee']} ({shift['id']}): " + ', '.join(f"{x['day']} {x['start']}-{x['end']}" for x in shift['shifts']))
            for t in v.get('todos') or []:
                self.out(f"  to-do: {t.get('text') or t['kind'].replace('_', ' ') + (' (' + t['item'] + ')' if t.get('item') else '')}")
        com = s.get('commissary') or {}
        for sp in com.get('spaces') or []:
            self.out(f"Commissary space at {sp['site']} for {sp['vehicle']}.")
        for line in com.get('stock') or []:
            self.out(f"Commissary stock at {line['site']}: {line['amount']} {line['item']} ({line.get('key')}).")
        for o in com.get('orders') or []:
            self.out(f"On order: {o['items']} to {o['site']}, arriving day {o['due_day']} at 08:00, {money(o.get('total'))} on delivery.")
        for e in s.get('employees') or []:
            self.out(f"Unassigned hire: {e['name']} ({e['id']}), customer service {e['skill']}, {money(e['wage'])} an hour.")
        for t in (s.get('transactions_today') or [])[-8:]:
            self.out(f"Bank: day {t['day']} {t['time']} {t['label']}: {money(t['amount'])}")

    def notices(self, follow=False, since=None):
        session = self.bridge.health().get('session')
        try:
            with open(self.memory) as f: remembered = json.load(f)
        except (OSError, ValueError):
            remembered = {}
        cursor = since or (remembered.get('next', 1) if remembered.get('session') == session else 1)
        while True:
            batch = self.bridge.events(cursor)
            for e in batch['events']:
                if e['kind'] in ('notice', 'phone'):
                    self.out(f"[day {e['day']} {e['time']}] {e['text']}")
            cursor = batch['next']
            try:
                with open(self.memory, 'w') as f: json.dump({'session': session, 'next': cursor}, f)
            except OSError:
                pass
            if not follow: return cursor
            time.sleep(1)

    def places(self, radius):
        r = self.call('places', {'radius': radius})
        for p in r['places']:
            what = p['business'] or p['business_type'] or p['building_type']
            extra = f"; commissary {p['commissary']['name']} (site {p['commissary']['site']})" if p.get('commissary') else ''
            mine = ' (yours)' if p.get('yours') else ''
            self.out(f"{p['distance']:>4} m  {p['address']}  {p['name']}: {what}{mine}{extra}")

    def screen(self, name, fetch=None):
        s = self.call('state')
        p = s['player']
        r = self.call('shoot', {'name': name, 'x': p['x'], 'y': p['y'] + 30, 'z': p['z'] - 20, 'look_at': {'x': p['x'], 'y': p['y'], 'z': p['z']},
                                'game_view': True}, 60)
        path = r.get('game_path') or r['path']
        if fetch:
            from ftlib.shots import fetch_shot
            path = str(fetch_shot(path, fetch))
        self.out(f"Screen: {path}{' (' + r['game_error'] + ')' if r.get('game_error') else ''}")

    # ---- acting ----
    def go(self, address):
        self.acting()
        r = self.call('taxi', {'address': address}, 150)
        if r['done']:
            self.out(f"The taxi set you down at {address} (x {r['x']}, z {r['z']}) after {r['minutes']:.0f} minutes; fare {money(r['fare'])}, money {money(r['money'])}.")
            c = self.call('state')['clock']
            self.out(f"Day {c['day']} {c['time']}, {'paused' if c.get('paused') else 'speed ' + str(c.get('speed'))}.")
        else:
            self.out(f"No ride: {'; '.join(r.get('notices') or []) or 'the taxi did not go'}.")

    def clock_at_one(self, work):
        """Walking takes real time; at a higher speed the day would run past while you walk. Runs work at speed 1 and puts
        the clock back as it was, also when the game refuses."""
        clock = self.call('state')['clock']
        was_paused, was_speed = clock.get('paused'), clock.get('speed')
        if was_paused or was_speed != 1: self.call('time', {'speed': 1})
        try:
            return work()
        finally:
            try:
                if was_paused: self.call('time', {'pause': True, **({'speed': was_speed} if was_speed not in (None, 1) else {})})
                elif was_speed not in (None, 1): self.call('time', {'speed': was_speed})
            except BridgeError:
                # The click opened a screen that holds the clock (the map, a panel): the game keeps it until that closes.
                self.out('The clock is held by the screen that opened; it runs again once you close it.')

    def use(self, ident=None, radius=None):
        if ident is None:
            r = self.call('use', {'op': 'list', **({'radius': radius} if radius else {})})
            self.out(f"Near you{' inside ' + r['inside'] if r.get('inside') else ''} (within {r['radius']:.0f} m):")
            for t in r['things']:
                what = t['name'] + (f" ({t['address']})" if t.get('address') else '')
                extra = ''
                if t.get('sells'): extra += f"; sells {t['sells']}"
                if t.get('for_rent'): extra += '; for rent'
                if t.get('yours'): extra += '; yours'
                if t.get('business') and t['business'] != t['name']: extra += f"; {t['business']}"
                self.out(f"[{t['id']}] {t['distance']:>5} m  {what}{' - ' + t['click'] if t.get('click') else ''}{extra}")
            if not r['things']: self.out('  nothing that reacts to a click.')
            return
        self.acting()
        cursor = self.bridge.events(1)['next']
        r = self.clock_at_one(lambda: self.call('use', {'op': 'click', 'id': ident}, 150))
        why = r.get('why')
        if not why and not r['handled']:
            why = '; '.join(r.get('notices') or []) or 'the game declined the click without giving a reason; inspect look and ui list'
        self.out(f"Clicked {r['clicked']}{' (' + r['click'] + ')' if r.get('click') else ''}"
                 + (f": {why.rstrip('.')}" if why else '') + '.')
        if r.get('inside') != r.get('inside_before'):
            self.out(f"You're now {'inside ' + r['inside'] if r.get('inside') else 'outside'}.")
        if r.get('open'): self.out(f"Open now: {', '.join(r['open'])} (ui list shows it).")
        for n in r.get('notices') or []: self.out(f'  {n}')
        self.notices(since=cursor)

    def eat(self, item=None):
        self.acting()
        r = self.call('eat', {'item': item} if item else {})
        self.out(f"{'Ate' if r['done'] else 'Did not eat'} {r['item']}: hunger {r['hunger']}, energy {r['energy']}.")
        for n in r.get('notices') or []: self.out(f'  {n}')

    @staticmethod
    def cargo_text(contents):
        return ', '.join(f"{c['amount']} {c['item']}{'' if c.get('paid', True) else ' (not paid)'}" for c in contents or []) or 'empty'

    def drop(self, coords):
        if len(coords) not in (0, 2): raise Refused('drop [X Z]')
        self.acting()
        r = self.call('drop', dict(zip(('x', 'z'), coords)))
        self.out(f"Put down {r['item']}." if r['placed'] else f"Not put down: {r.get('why') or 'the game refused'}.")
        for n in r.get('notices') or []: self.out(f'  {n}')

    def pickup(self, ident):
        self.acting()
        r = self.clock_at_one(lambda: self.call('pickup', {'id': ident}, 150))
        self.out(f"Clicked {r['clicked']} to pick it up{' (still walking)' if r.get('still_walking') else ''}; look shows what you hold.")
        for n in r.get('notices') or []: self.out(f'  {n}')

    def handtruck(self, words):
        if not words or words == ['list']:
            trucks = self.call('handtruck', {'op': 'list'})['handtrucks']
            if not trucks: self.out('No hand trucks nearby on this floor.')
            for t in trucks:
                self.out(f"{t['id']}: {t['name']}, {t['distance']} m{' (pushing)' if t['pushing'] else ''}; {self.cargo_text(t.get('contents'))}.")
                for c in t.get('contents') or []: self.out(f"  {c['key']}: {c['amount']} {c['item']}")
            return
        if words == ['release']: args = {'op': 'release'}
        elif len(words) == 2 and words[1] in ('grab', 'load', 'release'): args = {'id': words[0], 'op': words[1]}
        elif len(words) == 3 and words[1] == 'take': args = {'id': words[0], 'op': 'take', 'item': words[2]}
        else: raise Refused('handtruck [list | release | ID grab|load|release | ID take ITEM]')
        self.acting()
        r = self.clock_at_one(lambda: self.call('handtruck', args, 150))
        t = r['handtruck']
        self.out(f"{args['op']}: {'done' if r['done'] else r.get('why') or 'the game refused'}; "
                 f"{'pushing' if t['pushing'] else 'not pushing'} {t['id']}; on it: {self.cargo_text(t.get('contents'))}.")
        hands = r.get('hands')
        self.out(f"You hold: {hands['item']}: {self.cargo_text(hands.get('contents'))}." if hands else 'Your hands are empty.')
        for n in r.get('notices') or []: self.out(f'  {n}')

    def floorplan(self):
        r = self.call('floorplan')
        self.out(f"Floor plan: {r['address']}, floor {r['floor']}; {r['square_size']:g} m squares. Columns +X, rows +Z.")
        columns = r['columns']
        width = len(str(r['rows']))
        # Multiple header lines keep each map square exactly one character wide, even past column Z.
        header_height = max(map(len, columns))
        for digit in range(header_height):
            self.out(' ' * (width + 1) + ''.join(c.rjust(header_height)[digit] for c in columns))
        for row, line in reversed(list(enumerate(r['map'], 1))): self.out(f"{row:>{width}} {line}")
        self.out('Legend: . floor, # wall, = door/opening, X blocked, space void, @ you, letters/digits items, * shared items.')
        self.out(f"You: {r['player'].get('square') or 'outside plan'}. A1 anchor: x {r['origin']['x']}, z {r['origin']['z']}.")
        for item in r['items']:
            uses = ', '.join(f"{u.get('square') or 'outside plan'} ({'reachable' if u['reachable'] else 'unreachable'})" for u in item.get('use') or []) or 'none'
            self.out(f"{item['label']}: {item['item']} [{item['id']}]; covers {', '.join(item['squares']) or 'none'}; "
                     f"turned {item['rotation']:g} degrees; use {uses}; {'reachable' if item['reachable'] else 'unreachable'}.")
        if r.get('geometry'): self.out(r['geometry'])

    def place(self, x, z=None, rotation=None, move=None, check=False):
        self.acting()
        if z is None:
            if not re.fullmatch(r'[A-Za-z]+[1-9][0-9]*', str(x)): raise Refused('place takes SQUARE (for example C4), or X Z.')
            target = {'square': str(x).upper()}
        else:
            try: target = {'x': float(x), 'z': float(z)}
            except ValueError: raise Refused('place takes SQUARE (for example C4), or X Z.')
        r = self.call('place', {**target, **({'rotation': rotation} if rotation is not None else {}),
                               **({'move': move} if move else {}), **({'check': True} if check else {})})
        where = f"{r.get('square') or 'outside plan'} (x {r['x']}, z {r['z']}), turned {r['rotation']:g} degrees"
        if check:
            self.out(f"{r['item']}: {'fits' if r['fits'] else 'blocked'} at {where}." + (f" {r['why']}." if r.get('why') else ''))
            self.out('  Cancelled; original item and cargo restored.' if r.get('restored') else '  Restoration not confirmed; inspect the game before another placement.')
        elif r['placed']: self.out(f"{r['item']}: placed at {where}.")
        else:
            self.out(f"{r['item']}: not placed ({r['why']}).")
            if r.get('restored'): self.out('  Original item and cargo restored.')
        if r.get('blocked_by'): self.out(f"  Blocked by: {r['blocked_by']}.")
        self.out('  Reachable from you: ' + ('yes' if r.get('reachable') is True else 'no' if r.get('reachable') is False else 'unknown') + '.')
        for n in r.get('notices') or []: self.out(f'  {n}')

    def phone(self, app):
        self.acting()
        if app not in PHONE_APPS: raise Refused(f"No phone app {app}: {', '.join(PHONE_APPS)}.")
        r = self.call('phone', {'app': app})
        self.out(f"The phone is {'open on ' + app if r['open'] else 'not open'}; ui list shows its screen.")
        for n in r.get('notices') or []: self.out(f'  {n}')

    def call_contact(self, contact):
        if contact == 'list':
            for c in self.call('call', {'op': 'list'})['contacts']:
                self.out(f"{c['name']}{' (' + c['id'] + ')' if c['id'] != c['name'] else ''}{', unread messages' if c.get('unread') else ''}")
            return
        self.acting()
        r = self.call('call', {'contact': contact})
        self.out(f"{'Calling' if r['calling'] else 'Not calling'} {r['name']}; ui list shows the call's options.")
        for n in r.get('notices') or []: self.out(f'  {n}')

    def walk(self, x=None, z=None, place=None):
        self.acting()
        args = {'place': place} if place else {'x': x, 'z': z}
        r = self.clock_at_one(lambda: self.call('walk', args, 630))
        pushing = f", pushing {r['holding']}" if r.get('holding') else ''
        if r.get('left'):
            self.out(f"You walked out of {r['left']}; now outside at x {r['x']}, z {r['z']}.")
        elif r['arrived']:
            self.out(f"You walked {r['metres']} m{pushing}; now at x {r['x']}, z {r['z']}.")
        else:
            self.out(f"You stopped {r['from_goal']} m short{pushing}, at x {r['x']}, z {r['z']}"
                     f"{' (the way there only goes part of the way)' if r.get('path') == 'partial' else ''}.")

    def map(self, what, limit=None):
        if what == 'filters':
            for f in self.call('map', {'op': 'filters'})['filters']:
                self.out(f"{f['filter']}: {f['label']} ({f['buildings']} buildings)")
            return
        args = {'filter': what}
        if limit: args['limit'] = limit
        r = self.call('map', args)
        self.out(f"{r['count']} buildings lit by {what}; nearest first:")
        for b in r['buildings']:
            what_ = b.get('business') or b.get('business_type') or b.get('building_type')
            extra = f", for rent at {money(b['rent_per_day'])} a day" if b.get('for_rent') else ''
            com = f"; commissary {b['commissary']['name']} (site {b['commissary']['site']})" if b.get('commissary') else ''
            self.out(f"{b['distance']:>5} m  {b['address']}  {b['name']}: {what_}{', ' + b['size'] if b.get('size') else ''}"
                     f"{', ' + b['neighbourhood'] if b.get('neighbourhood') else ''}{extra}{com}")

    def ui(self, op, text=None, ident=None):
        if op == 'list':
            r = self.call('ui', {'op': 'list'})
            for b in r['buttons']:
                kind = b.get('kind')
                extra = (' (option)' if kind == 'option' else
                         f" (slider {b.get('value')}, from {b.get('min')} to {b.get('max')})" if kind == 'slider' else
                         f" (toggle, {'on' if b.get('on') else 'off'})" if kind == 'toggle' else
                         f" (text field: \"{b.get('value') or ''}\")" if kind == 'text field' else '')
                self.out(f"[{b['id']}] {b['text']}{extra}")
            for t in r['texts']:
                self.out(f"text: {t}")
            return
        self.acting()
        if op == 'click':
            cursor = self.bridge.events(1)['next']
            r = self.call('ui', {'op': 'click', **({'id': ident} if ident is not None else {'text': text})})
            self.out(f"Clicked {r['clicked']}.")
            self.wait_for_skip(cursor)
        elif op == 'set':
            if ident is None or text is None: raise Refused('ui set ID VALUE (a slider from the last ui list)')
            try: value = float(text)
            except ValueError: raise Refused('ui set ID VALUE: the value is a number.')
            r = self.call('ui', {'op': 'set', 'id': ident, 'value': value})
            self.out(f"{r['set']}: {r['value']} (from {r['min']} to {r['max']}).")
            for t in r.get('texts') or []: self.out(f'text: {t}')
        elif op == 'type':
            if ident is None or text is None: raise Refused('ui type ID TEXT (a text field from the last ui list)')
            r = self.call('ui', {'op': 'type', 'id': ident, 'text': text})
            self.out(f"{r['typed']}: \"{r['value']}\".")
            for t in r.get('texts') or []: self.out(f'text: {t}')
        elif op == 'escape':
            self.out(f"Closed {self.call('ui', {'op': 'escape'})['closed']}.")
        else:
            raise Refused(f'Unknown ui op {op}: list, click, set, type or escape.')

    def wait_for_skip(self, cursor):
        """A click that started a time skip (sleep, a course, a ride): wait until the game's clock is back, then say what
        came in meanwhile."""
        deadline = time.time() + SKIP_WAIT_S
        skipped = False
        # A skip can start a moment after the click (a ride's fade, the walk to the bed or the school's chair): it counts
        # as started while the player walks there, rides or the skip runs.
        settle = time.time() + 1
        while time.time() < deadline:
            player = self.call('state').get('player') or {}
            health = self.bridge.health()
            busy = health.get('time_skip') or player.get('riding') or (player.get('activity') == 'walking' and not health.get('paused'))
            if busy: skipped = True
            elif skipped or time.time() > settle: break
            time.sleep(.3)
        if skipped:
            c = self.call('state')['clock']
            self.out(f"Time passed: now day {c['day']} {c['time']}.")
            self.notices(since=cursor)

    def time(self, op, value=None, speed=None, day=None, wait=True):
        self.acting()
        if op == 'pause':
            self.call('time', {'pause': True}); self.out('Paused.'); return
        if op == 'speed':
            if not 0 < value <= MAX_SPEED: raise Refused(f'Speed is above 0 and at most {MAX_SPEED}.')
            self.call('time', {'speed': value}); self.out(f'Speed {value}.'); return
        if op != 'until': raise Refused(f'Unknown time op {op}: pause, speed or until.')
        speed = speed or MAX_SPEED
        if not 0 < speed <= MAX_SPEED: raise Refused(f'Speed is above 0 and at most {MAX_SPEED}.')
        clock = self.call('state')['clock']
        target_day = clock['day'] if day is None else (clock['day'] + int(day[1:]) if str(day).startswith('+') else int(day))
        if day is None and value <= clock['time']: target_day += 1
        cursor = self.bridge.events(1)['next']
        # Your needs run down as in any game: nothing tops them up.
        self.call('time', {'run_until': {'day': target_day, 'time': value}, 'speed': speed, 'keep_needs': False})
        if not wait:
            self.out(f'Running until day {target_day} {value}.'); return
        while True:
            c = self.call('state')['clock']
            if c.get('arrived_at') == f'day {target_day} {value}' or (c.get('paused') and c.get('run_until') is None): break
            if self.stop_file and os.path.exists(self.stop_file): break
            time.sleep(.5)
        self.out(f"Day {c['day']} {c['time']}, paused.")
        self.notices(since=cursor)

    def buy(self, kind):
        self.acting()
        r = self.call('vehicle', {'op': 'buy', 'kind': kind})
        self.out(f"Bought a {kind} ({r['id']}) for {money(r['price'])}; money {money(r['money'])}." if r['done'] else
                 f"Not bought: {'; '.join(r['notices']) or 'no room here'}.")

    def drive(self, ident, place, speed=None):
        self.acting()
        if speed is not None and speed not in (1, 2, 3): raise Refused('--speed is 1, 2 or 3 (times real time).')
        args = {'op': 'start', 'id': ident, 'place': place, **({'speed': speed} if speed else {})}

        def work():
            status = self.call('drive', args)
            deadline = time.time() + DRIVE_WAIT_S
            while status.get('running') and time.time() < deadline:
                time.sleep(1)
                status = self.call('drive', {'op': 'status'})
            return status
        s = self.clock_at_one(work)
        if s.get('running'):
            self.out(f"The drive is still going after {DRIVE_WAIT_S // 60} minutes; look shows where the truck is.")
            return
        out = s.get('pull_out')
        if out: self.out(f"You pulled {ident} out of its space onto the road (x {out['x']}, z {out['z']}).")
        ride = s.get('ride')
        if ride:
            end = ride.get('end') or ride.get('refused') or ride.get('error')
            hits = ride.get('contactsCaused')
            self.out(f"The drive: {end}, {ride.get('seconds', 0):.0f} s"
                     + (f", it stopped {ride['carMetres']:.0f} m from where it was going" if ride.get('carMetres') is not None else '')
                     + (f", {hits} bump{'s' if hits != 1 else ''} it caused" if hits else '') + '.')
        park = s.get('park')
        if park:
            self.out(('Parked in the bay.' if park.get('where', '').startswith('bay:') else 'Parked by the kerb.') if park.get('parked')
                     else f"Not parked: {park.get('why')}.")
        if s.get('error'): self.out(f"The drive failed: {s['error']}.")
        v = s.get('vehicle') or {}
        com = v.get('commissary') or {}
        mins = s.get('game_minutes')
        self.out(f"{ident} stands at x {v.get('x')}, z {v.get('z')}, {'parked legally' if v.get('legal') else 'not parked legally'}"
                 + (f", in the bay at {com['bay_site']}" if com.get('in_bay') else '')
                 + (', hatch to the pavement' if v.get('hatch_to_pavement') else ', hatch not to the pavement' if v.get('hatch_to_pavement') is False else '')
                 + f". It took {s.get('seconds', 0):.0f} s" + (f" ({mins:.0f} game minutes)" if mins is not None else '') + '.')
        c = self.call('state')['clock']
        self.out(f"Day {c['day']} {c['time']}, {'paused' if c.get('paused') else 'speed ' + str(c.get('speed'))}.")

    def vehicle(self, ident, op, item=None, units=None):
        self.acting()
        args = {'id': ident, 'op': op}
        if op in ('take', 'return'):
            args.update(op='transfer', direction=op, item=item)
            if units is not None: args['units'] = units
        elif op not in VEHICLE_OPS:
            raise Refused(f"Unknown vehicle action {op}: {', '.join(VEHICLE_OPS)}, take or return.")
        r = self.call('vehicle', args)
        self.out(f"{op}: {'done' if r['done'] else 'not done'}{' (' + r['why'] + ')' if r.get('why') else ''}.")
        for n in r.get('notices') or []: self.out(f'  {n}')

    def order(self, site, pairs):
        self.acting()
        if not pairs or len(pairs) % 2: raise Refused('order SITE ITEM BOXES [ITEM BOXES ...]')
        items = [{'item': pairs[i], 'boxes': int(pairs[i + 1])} for i in range(0, len(pairs), 2)]
        r = self.call('commissary', {'op': 'order', 'site': site, 'items': items})
        for o in r['orders']:
            self.out(f"Ordered {o['units']} {o['item']} for {money(o['total'])}, paid on delivery, arriving day {o['due_day']} at 08:00.")

    def crew(self, op, rest):
        self.acting()
        if op == 'assign' and len(rest) == 2:
            r = self.call('crew', {'op': 'assign', 'vehicle': rest[0], 'employee_id': rest[1]})
        elif op == 'schedule' and len(rest) in (5, 6):
            args = {'op': 'schedule', 'vehicle': rest[0], 'employee_id': rest[1], 'day': rest[2], 'start': int(rest[3]), 'end': int(rest[4])}
            if len(rest) == 6: args['station'] = rest[5]
            r = self.call('crew', args)
        elif op == 'auto' and len(rest) == 1:
            r = self.call('crew', {'op': 'auto_schedule', 'vehicle': rest[0]})
        else:
            raise Refused('crew assign VEHICLE EMPLOYEE | crew schedule VEHICLE EMPLOYEE DAY START END [STATION] | crew auto VEHICLE')
        self.out(f"{op}: {'done' if r['done'] else 'not done'}.")
        for n in r.get('notices') or []: self.out(f'  {n}')

    def price(self, vehicle, item, price):
        self.acting()
        r = self.call('price', {'vehicle': vehicle, 'item': item, 'price': price})
        set_ = r.get('price')
        self.out(f"{r['name']}: " + (f"${set_:.2f}" if set_ is not None else 'automatic price') + ('.' if r['done'] else ' (not changed).'))
        for n in r.get('notices') or []: self.out(f'  {n}')

    def route(self, op, rest, days=None, open_=None, close=None):
        self.acting()
        if op == 'add' and len(rest) == 2:
            args = {'op': 'add_stop', 'vehicle': rest[0], 'address': rest[1], 'days': days.split(',') if days else 'all'}
            if open_ or close: args.update(open=open_, close=close)
            r = self.call('route', args)
            self.out(f"Stop by {rest[1]}: " + ', '.join(f"{d['day']} {'added' if d['added'] else 'refused'}" for d in r['days']) + '.')
        elif op == 'paste' and len(rest) == 3:
            to = 'all' if rest[2] == 'all' else rest[2].split(',')
            r = self.call('route', {'op': 'paste_day', 'vehicle': rest[0], 'from': rest[1], 'to': to})
            self.out(f"Pasted: {'done' if r['done'] else 'refused (' + str(r.get('problem')) + ')'}.")
        else:
            raise Refused('route add VEHICLE ADDRESS [--days ...] [--open HH:MM --close HH:MM] | route paste VEHICLE FROM TO')
        for n in r.get('notices') or []: self.out(f'  {n}')

    def save(self, name):
        self.acting()
        if not name.startswith(PREFIX): raise Refused(f"Save names start with '{PREFIX}'.")
        self.call('save', {'name': name}, 120)
        self.out(f"Saved '{name}'.")

    def load(self, name):
        if self.stop_file and os.path.exists(self.stop_file): self.acting()
        if not name.startswith(PREFIX): raise Refused(f"You can only load saves whose name starts with '{PREFIX}'.")
        self.call('load', {'name': name}, 60)
        while (self.call('state').get('load') or {}).get('status') == 'pending': time.sleep(1)
        self.out(f"Loaded '{name}': {(self.call('state').get('load') or {}).get('status')}.")


def parser():
    p = argparse.ArgumentParser(prog='play', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest='cmd', required=True)
    sub.add_parser('look', help='the time, your money, vehicles, crew and commissary')
    n = sub.add_parser('notices', help='notices and phone texts'); n.add_argument('--follow', action='store_true')
    n = sub.add_parser('places', help='buildings near you'); n.add_argument('--radius', type=float, default=150)
    n = sub.add_parser('go', help='tell the taxi you are in where to go'); n.add_argument('address')
    n = sub.add_parser('use', help='things near you that react to a click, or click one'); n.add_argument('id', nargs='?', type=int)
    n.add_argument('--radius', type=float)
    n = sub.add_parser('eat', help='eat from the bag you hold'); n.add_argument('item', nargs='?')
    n = sub.add_parser('drop', help='put down a packed box or bag on an editable floor, or return a mop'); n.add_argument('coords', nargs='*', type=float)
    n = sub.add_parser('pickup', help='pick up a placed box or bag from the last use list'); n.add_argument('id', type=int)
    n = sub.add_parser('handtruck', help='list, grab, release, load, or take a box from a hand truck'); n.add_argument('words', nargs='*')
    sub.add_parser('floorplan', help='the floor you stand on, in grid squares, with furniture and use spots')
    n = sub.add_parser('place', help='place furniture at SQUARE or X Z; --check tries and cancels'); n.add_argument('x', metavar='SQUARE|X'); n.add_argument('z', nargs='?', type=float)
    n.add_argument('--rotation', type=float); n.add_argument('--move'); n.add_argument('--check', action='store_true')
    n = sub.add_parser('phone', help='open the phone on an app'); n.add_argument('app', choices=PHONE_APPS)
    n = sub.add_parser('call', help='your contacts, or call one'); n.add_argument('contact')
    n = sub.add_parser('walk', help='walk somewhere, pushing a cart you hold'); n.add_argument('coords', nargs='*', type=float)
    n.add_argument('--to')
    n = sub.add_parser('map', help="the city map's highlights"); n.add_argument('what'); n.add_argument('--limit', type=int)
    n = sub.add_parser('screen', help='a picture of the screen'); n.add_argument('name'); n.add_argument('--fetch')
    n = sub.add_parser('ui', help='buttons and texts on screen'); n.add_argument('op', choices=('list', 'click', 'set', 'type', 'escape'))
    n.add_argument('text', nargs='*'); n.add_argument('--id', type=int)
    n = sub.add_parser('time', help='pause, speed or run until a moment'); n.add_argument('op', choices=('pause', 'speed', 'until'))
    n.add_argument('value', nargs='*'); n.add_argument('--speed', type=float); n.add_argument('--no-wait', action='store_true')
    n = sub.add_parser('buy', help='buy a truck or a cart'); n.add_argument('kind', choices=('truck', 'cart'))
    n = sub.add_parser('drive', help='drive your truck somewhere'); n.add_argument('truck'); n.add_argument('place')
    n.add_argument('--speed', type=int)
    n = sub.add_parser('vehicle', help='use a vehicle'); n.add_argument('id'); n.add_argument('op'); n.add_argument('item', nargs='?')
    n.add_argument('units', nargs='?', type=int)
    n = sub.add_parser('order', help='order stock from a commissary'); n.add_argument('site'); n.add_argument('pairs', nargs='+')
    n = sub.add_parser('crew', help='crew and shifts'); n.add_argument('op', choices=('assign', 'schedule', 'auto')); n.add_argument('rest', nargs='+')
    n = sub.add_parser('price', help='what a vehicle charges for a food'); n.add_argument('vehicle'); n.add_argument('item'); n.add_argument('price')
    n = sub.add_parser('route', help='a vehicle\'s route'); n.add_argument('op', choices=('add', 'paste')); n.add_argument('rest', nargs='+')
    n.add_argument('--days'); n.add_argument('--open'); n.add_argument('--close')
    n = sub.add_parser('save', help='save the game'); n.add_argument('name')
    n = sub.add_parser('load', help='load a playtest save'); n.add_argument('name')
    return p


def main(argv=None, bridge=None, out=print, stop_file=None, memory=None):
    args = parser().parse_args(argv)
    play = Play(bridge or Bridge(), out, stop_file, memory)
    try:
        c = args.cmd
        if c == 'look': play.look()
        elif c == 'notices': play.notices(args.follow)
        elif c == 'places': play.places(args.radius)
        elif c == 'go': play.go(args.address)
        elif c == 'use': play.use(args.id, args.radius)
        elif c == 'eat': play.eat(args.item)
        elif c == 'drop': play.drop(args.coords)
        elif c == 'pickup': play.pickup(args.id)
        elif c == 'handtruck': play.handtruck(args.words)
        elif c == 'floorplan': play.floorplan()
        elif c == 'place': play.place(args.x, args.z, args.rotation, args.move, args.check)
        elif c == 'phone': play.phone(args.app)
        elif c == 'call': play.call_contact(args.contact)
        elif c == 'walk':
            if args.to and not args.coords: play.walk(place=args.to)
            elif len(args.coords) == 2 and not args.to: play.walk(args.coords[0], args.coords[1])
            else: raise Refused('walk X Z | walk --to PLACE')
        elif c == 'map': play.map(args.what, args.limit)
        elif c == 'screen': play.screen(args.name, args.fetch)
        elif c == 'ui':
            if args.op == 'set':
                if len(args.text) != 2 or not args.text[0].isdigit(): raise Refused('ui set ID VALUE (a slider from the last ui list)')
                play.ui('set', args.text[1], int(args.text[0]))
            elif args.op == 'type':
                if len(args.text) < 2 or not args.text[0].isdigit(): raise Refused('ui type ID TEXT (a text field from the last ui list)')
                play.ui('type', ' '.join(args.text[1:]), int(args.text[0]))
            else:
                play.ui(args.op, ' '.join(args.text) if args.text else None, args.id)
        elif c == 'time':
            if args.op == 'until':
                if len(args.value) not in (1, 2): raise Refused('time until [DAY] HH:MM [--speed N]')
                play.time('until', args.value[-1], args.speed, args.value[0] if len(args.value) == 2 else None, not args.no_wait)
            else:
                play.time(args.op, float(args.value[0]) if args.value else None)
        elif c == 'buy': play.buy(args.kind)
        elif c == 'drive': play.drive(args.truck, args.place, args.speed)
        elif c == 'vehicle': play.vehicle(args.id, args.op, args.item, args.units)
        elif c == 'order': play.order(args.site, args.pairs)
        elif c == 'crew': play.crew(args.op, args.rest)
        elif c == 'price': play.price(args.vehicle, args.item, args.price)
        elif c == 'route': play.route(args.op, args.rest, args.days, args.open, args.close)
        elif c == 'save': play.save(args.name)
        elif c == 'load': play.load(args.name)
        return 0
    except Refused as exc:
        out(f'Refused: {exc}')
        return 2
    except BridgeError as exc:
        out(f'The game says: {exc}')
        return 1


if __name__ == '__main__':
    sys.exit(main())
