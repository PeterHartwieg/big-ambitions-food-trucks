#!/usr/bin/env python3
import argparse
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ftlib.scenario import read_scenario, Runner
from ftlib.shots import ROOT
parser = argparse.ArgumentParser(description='Run Food Trucks game scenarios')
sub = parser.add_subparsers(dest='cmd', required=True)
sub.add_parser('list')
p = sub.add_parser('validate')
p.add_argument('file')
p = sub.add_parser('run')
p.add_argument('file')
p.add_argument('--report-dir')
p.add_argument('--keep-going', action='store_true')
args = parser.parse_args()
try:
    if args.cmd == 'list':
        for path in sorted((ROOT / 'tests/game/scenarios').glob('*.json')):
            scenario = read_scenario(path)
            print(f"{path.name}: {scenario['checks']}")
    elif args.cmd == 'validate':
        read_scenario(args.file)
        print('Valid scenario')
    else:
        report, directory = Runner().run(read_scenario(args.file), args.report_dir, args.keep_going)
        print(f"{'PASS' if report['ok'] else 'FAIL'} {report['name']}: {directory / 'report.md'}")
        if not report['ok']:
            print('; '.join(report['summary']), file=sys.stderr)
        sys.exit(0 if report['ok'] else 1)
except (OSError, ValueError) as exc:
    sys.exit(f'Could not read scenario: {exc}; check the file and schema with tools/scenario validate')
