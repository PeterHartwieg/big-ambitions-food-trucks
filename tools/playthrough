#!/usr/bin/env python3
"""The AI playthrough runner (docs/ai-playtest-plan.md, Phase A): set up from a plan file, run whole days, check, report.

  tools/playthrough setup tests/game/playthrough/phase-a.json --run phase-a-1
  tools/playthrough run --run phase-a-1 --days 6
  tools/playthrough check --run phase-a-1 [--log Player.log] [--version 0.10.0]
  tools/playthrough report --run phase-a-1 [--balance auto|off|FILE]

Runs only in a loaded save whose name starts with "FT playtest". Stops at the first broken rule, says which and why,
and keeps it in build/playtest/<run>/run.json."""
import argparse
import json
import os
from pathlib import Path
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ftlib.bridge import Bridge, BridgeError
from ftlib import playthrough as pt
from ftlib.shots import ROOT


def folder(name, base=None):
    return Path(base or ROOT / 'build/playtest') / name


def main(argv=None, bridge=None, out=print):
    parser = argparse.ArgumentParser(description='The Food Trucks AI playthrough runner')
    parser.add_argument('--dir', help='Where run folders go (default build/playtest)')
    sub = parser.add_subparsers(dest='cmd', required=True)
    p = sub.add_parser('setup', help="Phase A's day 1 from a plan file, then the delivery and fitting the next morning")
    p.add_argument('plan')
    p.add_argument('--run', required=True)
    p.add_argument('--speed', type=float, default=20)
    p = sub.add_parser('run', help='Run whole days, each to the next 05:00, with the checks, the ledger and a save each day')
    p.add_argument('--run', required=True)
    p.add_argument('--days', type=int, required=True)
    p.add_argument('--speed', type=float, default=20)
    p.add_argument('--day-timeout', type=float, default=900, help='Real seconds a game day may take (default 900)')
    p.add_argument('--reload-every', type=int, default=7, help='Load the day\'s save again every N days (days 1+N, 1+2N, ...; default 7, 0 never)')
    p = sub.add_parser('watch', help='The referee: check a game someone else plays after each in-game 05:00, without acting')
    p.add_argument('--run', required=True)
    p.add_argument('--stop-file', help='Written with the reason on a hard failure (default build/playtest/<run>/STOP)')
    p.add_argument('--poll', type=float, default=2.0, help='Real seconds between looks at the clock (default 2)')
    p.add_argument('--polls', type=int, help=argparse.SUPPRESS)
    p = sub.add_parser('check', help="The checks again over a run's snapshots, and the log rules on a Player.log")
    p.add_argument('--run', required=True)
    p.add_argument('--log')
    p.add_argument('--version')
    p = sub.add_parser('report', help='build/playtest/<run>/report.md')
    p.add_argument('--run', required=True)
    p.add_argument('--balance', default='auto', help='auto (run tools/balance), off, or a JSON file of its playthrough report')
    args = parser.parse_args(argv)
    run_dir = folder(args.run, args.dir)
    try:
        if args.cmd in ('setup', 'run'):
            runner = pt.Run(bridge or Bridge(), run_dir, speed=args.speed, day_timeout_s=getattr(args, 'day_timeout', 900), log=out,
                            reload_every=getattr(args, 'reload_every', 7))
            if args.cmd == 'setup':
                plan = json.loads(Path(args.plan).read_text())
                runner.setup(plan)
                out(f'Setup done: {run_dir}')
            else:
                runner.run_days(args.days)
                out(f'{args.days} days run, every check passed: {run_dir / "ledger.csv"}')
            return 0
        if args.cmd == 'watch':
            runner = pt.Run(bridge or Bridge(), run_dir, log=out)
            stop = args.stop_file or str(run_dir / 'STOP')
            out(f'Watching; on a hard failure the game is paused and the reason written to {stop}.')
            return runner.watch(stop, args.poll, getattr(args, 'polls', None))
        if args.cmd == 'check':
            results, log = pt.check_folder(run_dir, args.log, args.version)
            ok = all(r['ok'] for r in results)
            for r in results:
                if not r['ok']: out(f"FAIL {r['window']}: {r['check']}: {r['message']}")
            out(f"{'PASS' if ok else 'FAIL'}: {sum(r['ok'] for r in results)} of {len(results)} windows pass the money, stock, moves and log checks.")
            if log is not None:
                from ftlib.logcheck import format_report
                out(format_report(log))
                ok = ok and log['ok']
            return 0 if ok else 1
        rows, note = None, None
        if args.balance != 'off':
            snaps = [json.loads(line) for line in (run_dir / 'snapshots.jsonl').read_text().splitlines()]
            meta = json.loads((run_dir / 'run.json').read_text())
            plan = {**meta['plan'], 'vehicles': [{**v, 'id': meta['vehicles'].get(v['name'])} for v in meta['plan']['vehicles']]}
            if args.balance == 'auto':
                plan_file = run_dir / 'balance-plan.json'
                plan_file.write_text(json.dumps(pt.balance_plan(snaps[-1], plan), indent=2))
                try:
                    expected = pt.run_balance(plan_file, run_dir / 'balance.json')
                except (RuntimeError, OSError) as exc:
                    expected, note = None, f'Not compared: {exc}'
            else:
                expected = json.loads(Path(args.balance).read_text())
            if expected is not None:
                rows = pt.compare_balance(pt.read_ledger(run_dir / 'ledger.csv'), expected, meta.get('first_run_day', 1))
        out(f'Report: {pt.write_report(run_dir, rows, note)}')
        return 0
    except pt.Violation as exc:
        out(f'STOPPED at the {exc.check} check: {exc.message}')
        if (run_dir / 'run.json').exists(): out(f'See {run_dir / "run.json"} (stopped) and {run_dir / "events.jsonl"}.')
        return 2
    except BridgeError as exc:
        out(f'Bridge: {exc}')
        return 3
    except (OSError, ValueError, KeyError) as exc:
        out(f'Could not run: {exc}')
        return 1


if __name__ == '__main__':
    sys.exit(main())
