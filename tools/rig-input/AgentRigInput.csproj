<Project Sdk="Microsoft.NET.Sdk">
  <!-- Rig-only assembly: built by build.py against an explicit game Managed folder, installed only into the agent
       test player's Managed folder by the rig runtime's installer. Never part of the mod's SDK build or packages. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <AssemblyName>AgentRigInput</AssemblyName>
    <RootNamespace>AgentRigInput</RootNamespace>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- The test project and its build output are not part of this assembly (nor candidate references). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <Target Name="RequireRigReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameManaged)' == '' Or !Exists('$(GameManaged)/UnityEngine.CoreModule.dll')" Text="Set -p:GameManaged to the game's Managed folder (read as references only)." />
    <Error Condition="'$(HarmonyDll)' == '' Or !Exists('$(HarmonyDll)')" Text="Set -p:HarmonyDll to the checksum-verified 0Harmony.dll (build.py does this)." />
  </Target>
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameManaged)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManaged)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManaged)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(GameManaged)/Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManaged)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
