class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def reply(self, data, status=200):
        data.setdefault('session',self.server.mock.session)
        payload = json.dumps(data).encode()
        self.send_response(status)
        self.send_header('Content-Type','application/json; charset=utf-8')
        self.send_header('Content-Length',str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self):
        url = urlsplit(self.path)
        try:
            with self.server.mock.lock:
                if url.path.rstrip('/') == '/health':
                    result = self.server.mock.health()
                elif url.path.rstrip('/') == '/events':
                    try: since=int(parse_qs(url.query).get('since',['0'])[0])
                    except ValueError: since=0
                    if not -(2**63)<=since<2**63: since=0
                    result = self.server.mock.events(since)
                else:
                    self.reply({'ok':False,'error':'Unknown endpoint: use GET /health, POST /call or GET /events?since=N.'},404)
                    return
                self.reply(result)
        except (ValueError, TypeError) as exc:
            self.reply({'ok':False,'error':f'Cannot read endpoint: {exc}; use /health or /events?since=<sequence>'})

    def do_POST(self):
        try:
            if urlsplit(self.path).path.rstrip('/') != '/call':
                self.reply({'ok':False,'error':'Unknown endpoint: use GET /health, POST /call or GET /events?since=N.'},404)
                return
            if self.headers.get('Origin') is not None or self.headers.get('Sec-Fetch-Site') is not None:
                self.reply({'ok':False,'error':'Browser-origin calls are refused; use the CLI or MCP bridge client.'},403)
                return
            if self.headers.get('Content-Type','').split(';',1)[0].strip().lower() != 'application/json':
                self.reply({'ok':False,'error':'POST /call requires Content-Type: application/json.'},415)
                return
            size = int(self.headers.get('Content-Length',0))
            if not 0 < size <= 1048576:
                raise ValueError('Invalid request size: send a JSON object smaller than 1 MB')
            body = json.loads(self.rfile.read(size))
            if not isinstance(body,dict): raise ValueError('The body is not a JSON object: expected an object.')
            if not body.get('cmd'): raise ValueError('The body has no "cmd".')
            args=body.get('args') if isinstance(body.get('args'),dict) else {}
            result=self.server.mock.operation(body['cmd'],args,body.get('expect_session'))
            self.reply(result)
            if body['cmd'] == 'quit' and result['ok']:
                threading.Timer(.5, self.server.shutdown).start()
        except (ValueError, KeyError, TypeError, AttributeError) as exc:
            message = str(exc)
            self.reply({'ok':False,'error':message})


def stop_server(signum, frame):
    raise KeyboardInterrupt


