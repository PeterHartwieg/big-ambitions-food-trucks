    parser.add_argument('--clock-rate',type=float,default=1,help='Normal game minutes per real second, like Options game speed')
    args = parser.parse_args()
    with tempfile.TemporaryDirectory(prefix='foodtrucks-mock-') as shots:
        server = ThreadingHTTPServer(('127.0.0.1',args.port),Handler)
        server.mock = Mock(shots, args.clock_rate)
        thread = threading.Thread(target=server.mock.run_clock,daemon=True)
        thread.start()
        print(f'Mock bridge at http://127.0.0.1:{server.server_port}',flush=True)
        try:
            server.serve_forever(poll_interval=.1)
        except KeyboardInterrupt:
            pass
        finally:
            server.mock.unload()
            server.mock.stop.set()
            thread.join()
            server.server_close()


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as exc:
        sys.exit(f'Could not start mock bridge: {exc}; use a free --port')
