            for s in here: add(LOCALE['foodtrucks:commissary_stock_take'].format(f"{s['amount']:,}",s['item']),'option')
            for s in v['stock']:
                if s['amount']>0: add(LOCALE['foodtrucks:commissary_stock_return'].format(f"{s['amount']:,}",s['item']),'option')
            add('Confirm')
            add('Cancel')
        elif self.dialog == 'phone':
            add(LOCALE['foodtrucks:dialog_commissary_order_stock'])
