    # ---- walk: the game's click-to-move, pushing a held cart (the mock moves at once) ----
    def walk(self, args):
        player=self.state['player']
        if self.state['clock']['paused']: raise ValueError('The game is paused: walking takes real time. Set a speed first.')
        held=self.vehicle(player['in_vehicle']) if player['in_vehicle'] else None
        if held is not None and held['kind'] not in ('cart','handtruck'):
            raise ValueError("You're in a vehicle you drive: get out first (vehicle ID exit), or push a cart instead.")
        if player['at_hatch']: raise ValueError("You're at a truck's hatch: step out first (vehicle ID exit).")
        if self.work: self.finish_work()
        place=args.get('place'); bay=None
        if place is not None:
            kind,_,identifier=str(place).partition(':')
            if kind in ('bay','commissary'):
                if identifier not in SITES: raise ValueError(f"No commissary '{identifier}'. Commissaries: {', '.join(SITES)}.")
                if kind=='bay': self.require_bay(identifier); bay=identifier
                x,z=393.2+SITES.index(identifier)*100,217.6
            elif kind=='vehicle':
                v=self.vehicle(identifier); x,z=v['x']+(2.6 if v['kind']=='truck' else 2.1),v['z']
            elif kind=='exit':
                if not self.life['inside']: raise ValueError("You're not inside a building.")
                left=self.life['inside']; self.life['inside']=None
                door=self.door(left)
                player.update(x=door[0],z=door[1])
                if held and held['kind']=='handtruck': held.update(x=door[0],z=door[1],inside=None)
                self.event(f'Test bridge: walking to x {door[0]:.1f}, z {door[1]:.1f} (out of {left}).')
                return {'x':round(door[0],2),'y':0.,'z':round(door[1],2),'heading':round(player['heading'],2),'arrived':True,'from_goal':0.,
                        'goal':{'x':round(door[0],2),'z':round(door[1],2)},'path':'complete','metres':8,'holding':held['id'] if held else None,'inside':None,'left':left}
            elif kind=='address':
                if not re.fullmatch(r'ba:street_[a-z0-9]+#[0-9]+',identifier):
                    raise ValueError(f"address: takes a building's address as the game writes it, ba:street_<name>#<number>; got '{identifier}'.")
                building=next((b for b in CITY if b['key']==identifier),None)
                if building is None: raise ValueError(f'no building at {identifier} in this city')
                x,z=building['x']+6.,building['z']
            else: raise ValueError(f"Unknown place '{place}': use bay:<site>, commissary:<site>, vehicle:<id>, address:<address> or exit.")
        else:
            x,z=num(args,'x'),num(args,'z')
            if x is None or z is None: raise ValueError('walk needs "x" and "z", or "place".')
        if self.life['inside']: raise ValueError('The mock walks only outside: walk --to exit first.')
        metres=math.hypot(player['x']-x,player['z']-z)
        player.update(x=float(x),z=float(z))
        if held is not None:
            if bay and held['kind']!='handtruck': self.place_vehicle(held,bay)
            else: held.update(x=float(x),z=float(z),commissary=None)
            player.update(x=held['x'],z=held['z'])
        self.event(f"Test bridge: walking to x {x:.1f}, z {z:.1f} ({metres:.0f} m{', pushing '+held['id'] if held else ''}).")
        return {'x':round(player['x'],2),'y':0.,'z':round(player['z'],2),'heading':round(player['heading'],2),'arrived':True,'from_goal':0.,
                'goal':{'x':round(x,2),'z':round(z,2)},'path':'complete','metres':round(metres),'holding':held['id'] if held else None,'inside':None}

    # ---- map: the city map's highlights as data (the mock's city: the balance tool's buildings) ----
    def map_command(self, args):
        p=self.state['player']
