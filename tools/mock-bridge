        if run and run['running']: raise ValueError(f"A drive is under way ({run['id']} to {run['place']}): wait for it (drive status).")
        v=self.vehicle(identifier)
        if v['kind']!='truck': raise ValueError(f'{identifier} is a cart: a cart is pushed (walk), not driven.')
        player=self.state['player']
        if player['in_vehicle']!=identifier: raise ValueError(f"You're not in {identifier}: get in first (vehicle {identifier} enter).")
        if not self.mod_loaded: raise ValueError("The mod's save data isn't loaded.")
        if v['open']: raise ValueError(f'{identifier} is open for business: close it first (vehicle close).')
        if self.life['inside']: raise ValueError('The truck is inside a building: drive it out into the street first.')
        c=self.state['clock']
        if c['paused']: raise ValueError('The game is paused: driving takes real time. Set a speed first.')
        if self.until is not None: raise ValueError('run_until is running, and a time skip would end the ride: wait for it to stop.')
        if self.time_skip: raise ValueError('A time skip (sleep, a paid activity) is running; wait for it to end.')
        if not self.self_driving: raise ValueError("HART. Self Driving isn't loaded: the truck can't drive itself. Switch it on in the Mods menu.")
        kind,_,what=place.partition(':')
        site=None
        if kind=='bay':
            if what not in SITES: raise ValueError(f"No commissary '{what}'. Commissaries: {', '.join(SITES)}.")
            self.require_bay(what); site=what
            goal=(393.2+SITES.index(what)*100,217.6)
