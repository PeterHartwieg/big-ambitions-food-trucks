            v = next((v for v in self.state['vehicles'] if v['id'] == self.selected), None)
            if v and not v['open']: add(LOCALE['foodtrucks:overlay_open'])
        if self.work and self.dialog=='closed':
            add('Fast forward','toggle','Work/FastForward'); entries[-1]['on']=self.work['fast_forward']
