                        'building_type':(b.get('buildingType') or '').replace('ba:buildingtype_','').title(),'size':b.get('size'),
                        'business':business.replace('ba:businesstype_','').title() if business else None,'business_type':business,
                        'for_rent':'for_rent' in lit(b),'rent_per_day':round(b.get('m2',100)*0.5,2) if 'for_rent' in lit(b) else None,
                        'neighbourhood':b.get('hood'),
                        'commissary':{'site':site['id'],'name':LOCALE.get(site['name'],site['id'])} if site else None,
                        # The mock's city announces no events; a premium spot carries its name.
                        'pitch':{'premium':LOCALE.get(spots[b['key']]['name']),'events':[]} if b['key'] in pitches else None})
        return {'filter':f,'count':len(matched),'buildings':out}

    # ---- vehicle buy: the debug spawn beside the player, paid at the dealer's price ----
    def buy(self, args):
        kind=need(args,'kind','truck or cart')
        if kind not in ('truck','cart'): raise ValueError(f"Unknown kind '{kind}': truck or cart.")
        player=self.state['player']
        if player['in_vehicle']: raise ValueError(f"The player is in {player['in_vehicle']}: vehicle exit first (the vehicle spawns beside the player on foot).")
        cents=int(round(PRICES[kind]*100))
        if self.state['money']*100<cents:
            raise ValueError(f"Not enough money for the {kind}: it costs ${cents/100:,.2f} and the player has ${math.floor(self.state['money']*100)/100:,.2f}.")
        start=self.seq
        v=self.spawn(kind, announce=False)
        v.update(x=player['x']+3.,z=player['z']+(6. if kind=='truck' else 2.))
        # Bought at a commissary's door, the mock puts it in that commissary's bay (in game: wherever the spawn finds room).
        for site in json.loads((ROOT / 'data/commissaries.json').read_text())['commissaries']:
            building=next((b for b in CITY if b['key']==site['address']),None)
            if building and math.hypot(building['x']-player['x'],building['z']-player['z'])<=40: self.place_vehicle(v,site['id'])
        self.pay(-cents,'ba:transaction_vehiclebought')
        self.event(f'You bought a {kind} for ${cents/100:,.2f}.', 'notice')
        self.event(f"Test bridge: vehicle buy {kind}: {v['id']} for ${cents/100:,.2f}.")
        notices=[e['text'][8:] for e in self.ring if e['seq']>start and e['kind']=='notice']
        return {'done':True,'id':v['id'],'kind':kind,'price':cents/100,'money':round(self.state['money'],2),'notices':notices,
                'state':next(x for x in self.read_state()['vehicles'] if x['id']==v['id'])}

    # ---- routes by address (the bridge's route command) ----
    def price_command(self, args):
        v=self.vehicle(need(args,'vehicle',"the food vehicle's id"))
        if not self.mod_loaded: raise ValueError("The mod's save data isn't loaded.")
        if not self.can_write: raise ValueError("The mod's save data is read-only.")
        wanted=need(args,'item',"the food's key or name, as look shows it")
