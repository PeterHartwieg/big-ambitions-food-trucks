    def course(self):
        return BASIC_HR if (self.life['activity'] or {}).get('course')=='basic_hr' else TUNING['fleet']['course']

    def agency_open(self):
        # The game's order: an active campaign, then the Basic HR course, then a business (the mod adds the fleet).
        life=self.life
        if 'basic_hr' not in life['diplomas']: self.dialog='agency'; life['agency_says']='diploma'; return
        if not self.state['vehicles']: self.dialog='agency'; life['agency_says']='no_business'; return
        self.dialog='agency_form'; life['form']={'business':False,'skill':False,'part':False,'full':False,'days':AGENCY_DAYS,'candidates':1}
        self.event('Fleet recruiting: the agency offers a campaign for the street food fleet (no building business).')

    def agency_price(self):
        form=self.life['form']
        return 50.*(AGENCY_DAYS-form['days']+1)*form['candidates']

    def life_hour(self):
        # The game's hourly run (RecruitmentHelper.RunHourly): candidates at their find times, unassigned for the fleet.
        c=self.state['clock']; day=c['day']; hour=int(c['time'][:2]); life=self.life
        for campaign in list(life['campaigns']):
            for when in [w for w in campaign['times'] if w==(day,hour)]:
                n=len(life['candidates'])+len(self.employees)+1
                life['candidates'].append({'id':f'candidate-{n}','name':f'Mock candidate {n}','skill':35.,'satisfaction':50.,'wage':9.5})
                campaign['found']+=1
                self.event(f'Candidate received: Mock candidate {n} (customer service, unassigned).')
            if campaign['found']>=campaign['candidates']: life['campaigns'].remove(campaign)

