    def building_use_blocker(self):
        life=self.life
        if self.dialog in ('phone_app','presentation','crew','fleet','taxi_map'):
            return 'Close the phone or map before clicking a building in the world (ui escape).'
        if life['use_navigation_blockers'] and not self.state['player']['in_vehicle']:
            return "The player can't interact now; navigation blocked by " + ', '.join(life['use_navigation_blockers']) + '.'
        if not life['use_on_navmesh']:
            return 'Leave the motor vehicle before walking to a building entrance.'
        if life['use_route']!='complete':
            self.event("Can't reach item.",'notice')
            return ('The game found no reachable interaction point for this entrance.' if life['use_route']=='missing'
                    else 'The game found no complete walking route to this entrance.')
        return None

    def life_use(self, t):
        life=self.life; p=self.state['player']; kind=t['kind']
        if kind=='DroppedContainer':
            box=next((b for b in life['dropped'] if b['id']==t['box_id'] and b['inside']==life['inside']),None)
            if not box: raise ValueError('That placed box or bag is gone; list again.')
            if life['hands'] or p['in_vehicle']:
                self.event('Your hands are full.','notice'); return True
            life['hands']=box['hands']; life['dropped'].remove(box); return True
        if kind=='HandTruck':
            truck=next(h for h in life['handtrucks'] if h['id']==t['truck_id'])
            if p['in_vehicle']: self.dialog='handtruck_cargo'; return True
            if life['hands']: self.handtruck_load(truck); return True
            self.handtruck_command({'op':'grab','id':truck['id']}); return True
        if kind=='TaxiController':
            self.dialog='taxi_map'; life['taxi']=True; return True
        if kind=='CityBuildingController':
            address=t['address']; b=self.building(address) or {}
            p.update(x=t['x'],z=t['z'])
            if t['for_rent']:
                self.dialog='presentation'; life['presentation']=address; return True
            if b.get('buildingType')=='ba:buildingtype_residential' and address not in life['homes']:
                self.event('Private property.','notice'); return True
            life['inside']=address
            held=next((h for h in life['handtrucks'] if h['id']==p['in_vehicle']),None)
            if held: held.update(x=p['x'],z=p['z'],inside=address)
            if address in life['homes'] and not any(h.get('home')==address for h in life['handtrucks']):
                life['handtrucks'].append({'id':f'handtruck-{len(life["handtrucks"])+1}','name':'Hand truck','kind':'handtruck','home':address,
                                           'inside':address,'x':p['x'],'y':p['y'],'z':p['z'],'contents':[],'capacity':4})
            self.event(f'Entered {address}.')
            return True
        if kind=='BedController':
            if life['hands']: self.event('You need empty hands to do that.','notice'); return True
            self.dialog='sleep'; life['activity']={'minutes':480}; return True
        if kind=='EducationDoorController':
            if t['name']=='Basic HR':
                if 'basic_hr' in life['diplomas']: return True
                self.dialog='course'; life['activity']={'hours':1,'course':'basic_hr'}; return True
            if self.state['licence']['course_done']: self.dialog='closed'; return True
            self.dialog='course_choice'; return True
        if kind=='BusinessEmployeeController':
            self.agency_open(); return True
        b=self.building(life['inside']) or {}
        goods=SHOPS.get(b.get('businessType'),[])
        if kind=='ItemController':
            key,name,price,what,saturation=next(g for g in goods if g[1]==t['name'])
            cargo={'item':name,'key':key,'amount':1,'paid':False,'food':what=='food','furniture':what=='furniture','price':price,'saturation':saturation}
            if life['hands'] and life['hands']['key']=='ba:itemname_closedcardboardbox': life['hands']['contents'].append(cargo)
            elif life['hands']: self.event('Your hands are full.','notice'); return True
            else: life['hands']={'item':'Closed cardboard box','key':'ba:itemname_closedcardboardbox','contents':[cargo]}
            return True
        if kind=='CashRegisterController':
            if b.get('businessType') in FULL_SERVICE:
                if life['hands'] or p['in_vehicle']: self.event('You need empty hands to order.','notice'); return True
                self.dialog='purchase'; life['purchase']={'choice':None,'goods':goods}; return True
            unpaid=[c for c in (life['hands'] or {}).get('contents',[]) if not c['paid']]
            if not unpaid: self.event('Nothing to pay for.','notice'); return True
            self.dialog='purchase'; life['purchase']={'choice':None,'goods':None}; return True
        return False

