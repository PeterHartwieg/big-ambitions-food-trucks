    def parks(self):
        # The bridge's shape from made-up boxes, with the balance tool's buildings as entrances: the 5 nearest within
        # 150 m of each box on the ground, the neighbourhood of the building nearest the centre.
        def flat(x,z,box):
            dx=max(box[0]-x,0,x-box[3]); dz=max(box[2]-z,0,z-box[5])
            return math.hypot(dx,dz)
        parks=[]
        for name,kind,box in PARKS:
            cx,cz=(box[0]+box[3])/2,(box[2]+box[5])/2
            hood=min(CITY,key=lambda b:math.hypot(b['x']-cx,b['z']-cz))['hood']
            near=sorted(((flat(b['x'],b['z'],box),b) for b in CITY if flat(b['x'],b['z'],box)<=150),key=lambda t:t[0])[:5]
            parks.append({'name':name,'kind':kind,'neighbourhood':hood,'colliders':1,'concave_colliders':0,
                          'bounds':{'min':dict(zip('xyz',box[:3])),'max':dict(zip('xyz',box[3:]))},
                          'centre':{'x':round(cx,2),'z':round(cz,2)},
                          'entrances':[{'address':b['key'],'x':b['x'],'z':b['z'],'distance':round(d,2)} for d,b in near]})
        return {'entrance_radius':150,'parks':parks,'skipped':[{'name':'Park_Trigger_Closed','kind':'parkarea','reason':'inactive'}]}

    def bay_candidates(self, args):
        # The bridge's shape with made-up spots: one the automatic search takes, one past a long walk, one across the road
        # from the door, one beyond 30 m. With "address" any building's entrances are the origins (no status). A site
        # with a measured bay has one "data" origin at that point, checked for its side from the nearest door.
        site=args.get('site'); address=args.get('address')
        if (site is None)==(address is None):
            raise ValueError('bay_candidates needs "site" (a commissary\'s id) or "address" (any building, as ba:street_…#N), not both.')
        if address is not None and not (isinstance(address,str) and re.fullmatch(r'ba:street_[a-z0-9]+#[0-9]+',address)):
            raise ValueError(f'"address" is a building\'s address as the game writes it, ba:street_<name>#<number>; got \'{address}\'.')
        if address is not None and address not in BUILDINGS:
            raise ValueError(f'no building at {address} in this city')
        radius=num(args,'radius')
        radius=60 if radius is None else float(round(radius))
        if radius<5 or radius>80: raise ValueError('radius is 5 to 80 metres.')
        if site is not None:
            site=str(site)
            if site not in SITES: raise ValueError(f'no commissary {site}')
            i=SITES.index(site)
        else:
            i=len(SITES)
        dx=393.2+i*100+5; dz=217.6
        measured=MEASURED.get(site) if site is not None else None
        across=site in self.measured_across
        x,z=(measured['x'],measured['z']) if measured else (dx,dz)
        spots=[(x-11.4,z-5.6,180.,12.7,'short',14.2,12.5,True,True,None),
               (x+9.0,z+14.0,90.,16.6,'too_long',61.0,16.0,True,False,'too long a walk from the door'),
               (x-14.0,z+12.0,180.,18.4,'short',19.0,18.4,False,False,'across the road from the door'),
               (x-36.0,z+20.0,180.,41.2,'short',44.0,41.0,True,False,"beyond the automatic search's 30 m")]
        if measured:
            # From a point set in data: no walks, the side checked from the nearest door; nothing automatic when the
            # point itself is across the road. With a heading (nose-in in a lot) every spot faces that way and the
            # automatic pick is the point itself.
            measured_text='the point set in data is across the road from the door, so the automatic search takes nothing from it'
            heading=measured.get('heading')
            if heading is not None:
                spots=[(x,z,heading,0.0,'short',None,None,True,True,None)]+[(a,b,heading,d,w,wm,sm,side,False,why) for a,b,h,d,w,wm,sm,side,auto,why in spots]
            def reason(d,side,auto,why):
                if d>30: return why
                if across: return measured_text
                if side is False: return 'across the road from the door'
                return None if auto else 'farther than the automatic pick'
            spots=[(a,b,h,d,None,None,None,side,auto and not across,reason(d,side,auto,why)) for a,b,h,d,w,wm,sm,side,auto,why in spots]
        origin={'kind':'data' if measured else 'entrance','x':x,'z':z,'door':{'x':dx,'y':0.1,'z':dz},
                'walk_start':'none (a point set in data is trusted for its walk; its side is checked from the nearest door)' if measured else 'door',
                'same_side':(not across) if measured else None,'parking_colliders':42,'truncated':False,
                'candidates':[{'x':round(a,2),'z':round(b,2),'heading':h,'distance':d,'walk':w,'walk_m':wm,'straight_m':sm,'same_side':side,'automatic':auto,'rejected':why}
                              for a,b,h,d,w,wm,sm,side,auto,why in spots if d<=radius]}
        return {'site':site,'address':address,'status':None if site is None else self.bay_status.get(site,'resolved'),'radius':radius,'max_metres':30,
                'origins':[origin]}

    def require_bay(self, site):
        if self.bay_status.get(site)=='pending':
            raise ValueError(f"The bay of {site} isn't resolved yet (the city's parking lanes load after the city); try again in a few seconds.")
        if self.bay_status.get(site)=='failed':
            raise ValueError(f'{site} has no bay: the search found no legal parking near it.')

    def transaction(self, kind, amount, day=None, **data):
        day=self.state['clock']['day'] if day is None else day
        label=LOCALE[kind].format(day=day,**data) if kind in LOCALE else kind
        self.state['transactions_today'].append({'type':kind,'label':label,'amount':round(amount,2),
                                                'balance':math.floor(self.state['money']),'day':day,'time':self.state['clock']['time']})

    def pay(self, cents, kind, day=None, **data):
        # Money moves in whole cents, as the mod's Payments do, and the game books the transaction.
        self.state['money']=round(self.state['money']+cents/100,2)
        self.transaction(kind,cents/100,day=day,**data)

    # The mod's per-vehicle ledger (Core SalesLedger, VehicleDay), sold counts (SoldCounts) and spots worked (DayRecord).
    def book(self, day, vehicle_id, line, cents):
        entry=self.ledger.setdefault(str(day),{'vehicles':{},'delivery_fees':0,'revenue':0,'stock_cost':0})
        lines=entry['vehicles'].setdefault(vehicle_id,{k:0 for k in ('sales','catering','stock_cost','wages','parking','permit','commissary_rent','overnight_fines','marketing')})
        lines[line]+=cents
        if line=='sales': entry['revenue']+=cents
        if line=='stock_cost': entry['stock_cost']+=cents

    def day_summary(self, args):
        today=self.state['clock']['day']
        asked=num(args,'day')
        day=today if asked is None else int(asked)
        if asked is not None and (asked!=int(asked) or day<1 or day>today): raise ValueError(f'day is a whole day number from 1 to today ({today}).')
        entry=self.ledger.get(str(day),{'vehicles':{},'delivery_fees':0,'revenue':0,'stock_cost':0})
        detailed=today-1<=day<=today
        ids=sorted({v['id'] for v in self.state['vehicles']}|set(entry['vehicles']))
        vehicles=[]
        for vid in ids:
            lines=entry['vehicles'].get(vid,{k:0 for k in ('sales','catering','stock_cost','wages','parking','permit','commissary_rent','overnight_fines','marketing')})
            profit=lines['sales']+lines['catering']-sum(lines[k] for k in ('stock_cost','wages','parking','permit','commissary_rent','overnight_fines','marketing'))
            v=next((x for x in self.state['vehicles'] if x['id']==vid),None)
            if v is None and profit==0 and lines['sales']==0: continue
            sold=self.sold.get(vid,{}).get(str(day),{})
            visits=self.visits.get(vid,{}).get(str(day),{})
            vehicles.append({'id':vid,'kind':v['kind'] if v else None,**{k:lines[k]/100 for k in lines},'profit':profit/100,
                             'sold':sorted(({'item':k,'units':n} for k,n in sold.items() if n>0),key=lambda r:(-r['units'],r['item'])) if detailed else None,
                             'stops_served':sum(1 for m in visits.values() if m>0) if detailed else None,
                             'minutes_open':sum(visits.values()) if detailed else None,
                             'stock_now':None if v is None else [{'key':s['key'],'amount':s['amount']} for s in v['stock'] if s['amount']>0]+
                                         [{'key':next(k for k,n in PIECES.items() if n==p['item']),'amount':1} for p in v['pieces'] if p['item'] in PIECES.values()]})
        fleet_profit=entry['revenue']-entry['stock_cost']-entry['delivery_fees']-sum(l[k] for l in entry['vehicles'].values() for k in ('wages','parking','permit','commissary_rent','overnight_fines','marketing'))
        return {'day':day,'today':today,'in_summary':str(day) in self.ledger and day<today,
                'fleet':{'revenue':entry['revenue']/100,'stock_cost':entry['stock_cost']/100,'licence':0.0,'event_places':0.0,
                         'delivery_fees':entry['delivery_fees']/100,'profit':fleet_profit/100},
                'fees_paid_at':sorted({site for site,d in self.fees_paid if d==day}),'vehicles':vehicles}

    def places(self, args):
        # The buildings round the player as the map shows them (the balance tool's city), no demand figures.
        radius=max(20,min(500,num(args,'radius') if num(args,'radius') is not None else 150))
