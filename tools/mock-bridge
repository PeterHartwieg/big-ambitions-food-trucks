    def operation(self, cmd, args, expect_session=None):
        def refusal():
            if self.stopped: return {'ok':False,'session':self.session,'error':'the bridge stopped'}
            if expect_session is not None and expect_session != self.session:
                return {'ok':False,'session':self.session,'error':f'the bridge restarted (session {self.session}); reconnect first.'}
        with self.ops_lock:
            refused=refusal()
            if refused: return refused
        if self.stopped: return {'ok':False,'session':self.session,'error':'the bridge stopped'}
        if cmd=='op':
            identifier=num(args,'id')
            if identifier is None: return {'ok':False,'session':self.session,'error':'op needs "id": the number a /call reply gave as "op".'}
            with self.ops_lock:
                refused=refusal()
                if refused: return refused
                op=self.operations.get(int(identifier))
                if op is None: return {'ok':False,'session':self.session,'error':f'No operation {identifier:g} (the bridge keeps the last 500).'}
                return {'ok':True,'session':self.session,'result':copy.deepcopy(op)}
        with self.ops_lock:
            refused=refusal()
            if refused: return refused
            identifier=self.next_op
            self.next_op+=1
            session=self.session
            op={'id':identifier,'cmd':cmd,'status':'pending','session':session}
            self.operations[identifier]=op
            finished=threading.Event()
            files=[]
            self.operation_waiters[identifier]=(op,finished,files)
            lifecycle=self.lifecycle
            while len(self.operations)>500: del self.operations[next(iter(self.operations))]
        def work():
            try:
                with self.call_gate:
                    with self.lock:
                        if self.stopped or lifecycle!=self.lifecycle: raise ValueError('the bridge stopped')
                        result=copy.deepcopy(self.call(cmd,args))
                        if cmd=='shoot': files.append(Path(result['path']))
                # Deferred work lets the main thread and health/events keep running.
                delay=self.operation_delays.get(cmd,.12 if cmd=='shoot' else 0)
                if delay: finished.wait(delay)
                with self.ops_lock:
                    if op['status']=='pending': op.update(status='done',result=result)
            except Exception as exc:
                with self.ops_lock:
                    if op['status']=='pending': op.update(status='failed',error=str(exc))
            finally:
                with self.ops_lock: self.operation_waiters.pop(identifier,None)
                finished.set()
        threading.Thread(target=work,daemon=True).start()
        if not finished.wait(min(600,max(1,num(args,'timeout_s') if num(args,'timeout_s') is not None else 10))):
            return {'ok':False,'session':session,'op':identifier,'error':f'timed out on the main thread; the command goes on: ask {{"cmd": "op", "args": {{"id": {identifier}}}}} for its outcome'}
        with self.ops_lock:
            return {'ok':op['status']=='done','session':session,'op':identifier, **({'result':copy.deepcopy(op['result'])} if op['status']=='done' else {'error':op['error']})}

    def unload(self):
        with self.lock:
            with self.ops_lock:
                self.stopped=True
                self.lifecycle+=1
                for op,waiter,files in self.operation_waiters.values():
                    if op['status']=='pending':
                        op.update(status='failed',error='the bridge stopped')
                        for path in files: path.unlink(missing_ok=True)
                    waiter.set()
                self.operations.clear()
                self.operation_waiters.clear()
            self.ring.clear()
            self.seq=0
            self.last_ui=[]
            self.pending=[]
            self.walks=[]
            self.activity_starting=False
            self.load=None
            if self.until is not None: self.state['clock']['speed']=1
            self.until=None
            self.state['clock'].update(run_until=None,arrived_at=None)
            self.pause_menu_open=False
            self.confirmation_open=False

    def start_bridge(self):
        with self.lock:
            with self.ops_lock:
                self.session=uuid.uuid4().hex
                self.stopped=False

    def serving(self, v):
        player=self.state['player']
        if not v['open'] or player['in_vehicle']==v['id']: return 'nobody'
        if v['kind']=='truck' and player['at_hatch']==v['id']: return 'player'
        if v['kind']=='cart' and ((player['x']-v['x'])**2+(player['y']-v['y'])**2+(player['z']-v['z'])**2)**.5<=8: return 'player'
        return 'crew' if v['crew'] else 'nobody'

    def read_state(self):
        if self.state['scene'] == 'city':
            result=copy.deepcopy(self.state)
            result['load']=copy.deepcopy(self.load)
            result['transactions_today']=[t for t in result['transactions_today'] if t['day'] >= result['clock']['day']-1]
            assigned={name for v in result['vehicles'] for name in v['crew']}
            result['employees']=[{k:e[k] for k in ('id','name','skill','satisfaction','wage')} for e in self.employees if e['name'] not in assigned]
            player=result['player']
            player['activity']='driving' if player['in_vehicle'] and self.vehicle(player['in_vehicle'])['kind']=='truck' else 'pushing' if player['in_vehicle'] else 'starting' if self.activity_starting else 'at_hatch' if player['at_hatch'] else 'walking' if self.walks else 'on_foot'
            player['clock_held_by']=self.clock_held_by()
            # The mock's game camera hangs over the player; nothing is faded for it.
            result['game_camera']={'x':round(player['x'],2),'y':round(player['y']+18,2),'z':round(player['z']-12,2),'yaw':0.,'pitch':55.}
            result['view_blocked']=[]
            result['commissary']['bays']=self.bays()
            result['clock']['speed']=round(result['clock']['speed'],2)
            result['money']=round(result['money'],2)
            for order in result['commissary']['orders']:
                for key in ('goods','fee'): order.pop(key,None)
            for v in result['vehicles']:
                v['serving']=self.serving(v)
                if v['kind']=='cart' and not v['open']: v['hatch_side']=None
            for position in [result['player'],*result['vehicles']]:
                for key in ('x','y','z','heading'):
                    if position[key] is not None: position[key]=round(position[key],2)
            if not self.mod_loaded: result.update(licence=None,vehicles=[],commissary=None,ledger_today=None,employees=[])
            return result
        return {'save': self.state['save'], 'scene':self.state['scene'], 'vehicles':[],
                'notices_recent':self.state['notices_recent'], 'load':copy.deepcopy(self.load), 'transactions_today':[], 'employees':[],
                'view_blocked':[], **{key:None for key in ('clock','money','player','licence','commissary','ledger_today','game_camera')}}

    def health(self):
        c = self.state['clock'] if self.state['scene'] == 'city' else {}
        if self.stopped:
            return dict(ok=True,session=self.session,mod_version='0.9.10',bridge_version=1,scene='menu',save=None,day=None,time=None,paused=None,time_skip=None,frame=0,load=None)
        return dict(ok=True, session=self.session, mod_version='0.9.10', bridge_version=1, scene=self.state['scene'],
                    save=self.state['save'], day=c.get('day'), time=c.get('time'), paused=c.get('paused'), time_skip=self.time_skip if self.state['scene']=='city' else None,
                    frame=self.frame, load=None if self.load is None else {k:self.load[k] for k in ('name','status')})

    def events(self, since):
        since = max(since, 1)
        oldest = self.ring[0]['seq'] if self.ring else self.seq + 1
        return {'ok': True, 'session':self.session, 'next': self.seq + 1, 'dropped': max(0, oldest - since),
                'events': [event for event in self.ring if event['seq'] >= since]}

    def vehicle(self, identifier=None):
        identifier = identifier or self.state['player']['in_vehicle'] or self.selected
        found = next((v for v in self.state['vehicles'] if v['id'] == identifier), None)
        if found is None:
            ids = ', '.join(v['id'] for v in self.state['vehicles']) or 'none'
            raise ValueError(f"No food cart or truck with id '{identifier}'. Food vehicles: {ids}.")
        return found

    def spawn(self, kind):
        identifier = f'{kind}-{len(self.state["vehicles"])+1}'
        v = dict(id=identifier,kind=kind,name='Food '+kind,x=0.,y=0.,z=0.,heading=0.,legal=True,
                 legal_reason='wheel parking test: legal, mock wheels' if kind=='truck' else 'pavement rule: legal; nearest entrance 10.0 m',hatch_side='right' if kind=='truck' else None,
                 hatch_to_pavement=True if kind=='truck' else None, open=False,serving='nobody',crew=[],pieces=[],stock=[],
                 queue=None,commissary=None,route=None,parking={'state':'Legal','neighbourhood':'ba:neighborhood_hellskitchen','hourly_price':5.0,'unpaid':0.})
        self.state['vehicles'].append(v)
        self.selected = identifier
        self.event(f'Spawned foodtrucks:vehicletype_food{kind}: id {identifier}, controller mock.')
        self.event(f'Spawned foodtrucks:vehicletype_food{kind}.', 'notice')
        return v

    def place_vehicle(self, v, site):
        index = SITES.index(site)
        v.update(x=393.2+index*100,y=0.,z=217.6,heading=0.,legal=v['kind']=='truck',legal_reason='wheel parking test: legal, mock wheels' if v['kind']=='truck' else 'pavement rule: inside a parking lane')
        space = next((s['site'] for s in self.state['commissary']['spaces'] if s['vehicle']==v['id']), None)
        v['commissary'] = {'site':space,'in_bay':True,'bay_site':site}

    def add_order(self, site, boxes, emit=True, item='ba:itemname_hotdog'):
        self.order_number += 1
        name,box,price=CATALOG[item]
        units=boxes*box
        goods=round(units*price,2)
        # The fee is set on delivery (one per commissary and morning); a waiting order carries none.
        order = {'n':self.order_number, 'site':site, 'items':f'{units} {name}',
                 'item':item,'units':units,'goods':goods,'fee':0.0,'total':goods,
                 'due_day':self.state['clock']['day']+1}
        self.state['commissary']['orders'].append(order)
        if emit:
            self.event(f"Commissary order {order['n']}: {boxes} boxes, {units} {name} at {site} for ${goods:.2f}, paid on delivery; due day {order['due_day']} at 08:00.")
            self.event(LOCALE['foodtrucks:message_commissary_ordered'].format(units=units,item=name,total=f"${goods:.2f}",time='08:00'), 'phone')
        return order

    def deliver(self, force=False):
        c = self.state['clock']
        for order in list(self.state['commissary']['orders']):
            if not force and (order['due_day'] > c['day'] or c['time'] < '08:00'):
                continue
            self.state['commissary']['orders'].remove(order)
            units=order['units']
            name=CATALOG[order['item']][0]
            delivery=(order['site'],order['due_day'])
            goods=order['goods']; fee=0.0 if delivery in self.fees_paid else TUNING['commissary']['deliveryFeeCents']/100
            order['fee']=fee; order['total']=round(goods+fee,2)
            if self.state['money'] < order['total']:
                self.event(f"Commissary delivery: order {order['n']}, {units} {name} not delivered: the payment of ${order['total']:.2f} was refused (not enough money); the order is cancelled.")
                self.event(f"We couldn't deliver {units} {name}: the payment of ${order['total']:.2f} didn't go through. The order is cancelled; order again when you have the money.", 'phone')
            else:
                self.state['money'] -= order['total']
                self.fees_paid.add(delivery)
                self.transaction('foodtrucks:transaction_commissary_order', -order['total'], commissary=LOCALE['foodtrucks:commissary_'+order['site']])
                stock = next((s for s in self.state['commissary']['stock'] if s['site'] == order['site'] and s['key'] == order['item']), None)
                if stock:
                    stock['amount'] += units
                else:
                    self.state['commissary']['stock'].append({'site': order['site'], 'item': name, 'key':order['item'], 'amount': units})
                self.event(f"Commissary delivery: order {order['n']}, {units} {name} at {order['site']} (ordered day {order['due_day']-1}, due day {order['due_day']}), paid ${order['total']:.2f} on delivery (goods ${goods:.2f}, fee ${fee:.2f}).")
                self.event(LOCALE['foodtrucks:message_commissary_delivered_fee' if fee else 'foodtrucks:message_commissary_delivered'].format(units=units,item=name,commissary=LOCALE['foodtrucks:commissary_'+order['site']],total=f"${order['total']:.2f}",fee=f"${fee:.2f}"),'phone')

    def flush_hour(self, day, hour):
        for v in self.state['vehicles']:
            count = self.hours.pop(v['id'], 0)
            if count:
                self.event(f"Crew sales: {v['id']}, day {day} {hour:02d}:00 hour: {count} customers, {count} items, ${count*13:.2f}, paid in after midnight; {sum(s['amount'] for s in v['stock'])} units left.", day=day)

    def spend_needs(self):
        # The game's average burn (0.056 energy a minute, 1.5 hunger per energy); the bridge tops both up below 40 while
        # keep_needs is on, as the game side does through the game's needs API.
        needs=self.state['player']['needs']
        needs['energy']=max(needs['collapse_at'],round(needs['energy']-.056,3))
        needs['hunger']=max(0.,round(needs['hunger']-.084,3))
        if self.state['clock']['keep_needs']:
            # Only for an FT save of a character with FT saves only, as the bridge checks every frame (review round 6).
            why=None
            if not (self.state['save'] or '').startswith('FT'): why=f"the save is now '{self.state['save']}', which doesn't start with FT"
            else:
                try: self.require_character()
                except ValueError: why='the save\'s character now also has a save not starting with FT'
            if why:
                self.state['clock']['keep_needs']=False
                self.event(f'Test bridge: needs top-ups stopped: {why}.')
        needs['kept_up']=self.state['clock']['keep_needs']
        if self.state['clock']['keep_needs'] and (needs['energy']<40 or needs['hunger']<40):
            energy,hunger=needs['energy'],needs['hunger']
            needs.update(energy=100.,hunger=100.)
            c=self.state['clock']
            self.event(f"Test bridge: needs topped up while the clock runs (energy {energy:.1f} to 100.0, hunger {hunger:.1f} to 100.0), day {c['day']} {c['time']}.")

    def tick(self):
        before = self.absolute
        self.absolute += 1
        c = self.state['clock']
        day = self.absolute // 1440 + 1
        m = self.absolute % 1440
        c.update(day=day, time=f'{m//60:02d}:{m%60:02d}', weekday=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'][(day-1)%7])
        self.spend_needs()
        if m % 60 == 0:
            self.flush_hour(before // 1440 + 1, (before % 1440) // 60)
        if m == 0:
            for v in self.state['vehicles']:
                if v['crew'] and (v['route'] or {}).get('stops',0):
                    self.event(f"Route: truck {v['id']} caught up to minute {self.absolute} for the day's close.")
                total = self.takings.pop(v['id'], 0)
                if total:
                    self.state['money'] += total * 13
                    self.transaction('foodtrucks:transaction_crew_sales',total*13,day=day-1,vehicle=v['name'],sales=total)
                    self.event(f"Crew sales paid in: {v['name']} ({v['id']}), day {day-1}: {total} items, ${total*13:.2f}.", day=day-1)
            self.state['ledger_today'] = {'street_food': 0., 'crew_waiting': 0.}
            self.event(f'Day summary: day {day-1}.')
        if m == 480:
            self.deliver()
        for v in self.state['vehicles']:
            route = self.routes.get(v['id'])
            if route and v['crew'] and self.state['player']['in_vehicle'] != v['id']:
                active = route[0] <= m < route[1] if route[1] > route[0] else m >= route[0] or m < route[1]
                if active and not v['open']:
                    self.event(f"Route: truck {v['id']} leaves for stop 1, arriving about {c['time']}.")
                    self.event(f"Route: truck {v['id']} arrived at stop 1: legal parking, 0 m from the stop.")
                    v.update(open=True, serving='crew', queue={'length':0,'places':[]})
                    self.event(f"Truck {v['id']} open by its crew at stop 1; 1 serving.")
                elif not active and v['open']:
                    v.update(open=False, serving='nobody', queue=None)
                    self.event(f"Truck {v['id']}: closing notice not shown (the crew's window, the player away or asleep).")
            v['serving']=self.serving(v)
            waiting = self.__dict__.get('paused_notice', set())
            if v['id'] in waiting:
                waiting.discard(v['id'])
                if v['open'] and v['serving'] == 'nobody':
                    self.event(LOCALE['foodtrucks:notification_paused_truck'], 'notice')
            if v['open'] and v['serving'] != 'nobody' and m % 10 == 0:
                stock = next((s for s in v['stock'] if s['amount'] > 0), None)
                if stock:
                    stock['amount'] -= 1
                    if v['pieces']:
                        v['pieces'][0]['units'] = sum(s['amount'] for s in v['stock'])
                    self.state['ledger_today']['street_food'] += 13
                    if v['serving'] == 'crew':
                        self.state['ledger_today']['crew_waiting'] += 13
                        self.takings[v['id']] = self.takings.get(v['id'], 0) + 1
                        self.hours[v['id']] = self.hours.get(v['id'], 0) + 1
                    else:
                        self.state['money'] += 13
                        self.event(f"Sale: foodtrucks:itemname_tacos for $13.00 on day {day}, {stock['amount']} of it left.")
        if self.until is not None and self.absolute >= self.until:
            self.until = None
            c.update(paused=True, speed=1, run_until=None, arrived_at=f"day {c['day']} {c['time']}", keep_needs=False)
            self.event(f"Test bridge: run_until {self.until_text} reached at day {c['day']} {c['time']}; paused, speed 1.")

    def run_clock(self):
        previous = time.monotonic()
        credit = 0.
        while not self.stop.wait(.01):
            now = time.monotonic()
            with self.lock:
                if self.stopped:
                    credit=0
                    previous=now
                    continue
                self.frame += 1
                c = self.state['clock']
                for due, action in list(self.pending):
                    if now >= due:
                        self.pending.remove((due,action))
                        action()
                c = self.state['clock']
                for due, action in list(self.walks):
                    if c['paused']:
                        self.walks.remove((due,action))
                        self.walks.append((due+now-previous,action))
                    elif now >= due:
                        self.walks.remove((due,action))
                        action()
                if c['paused'] or self.state['scene']!='city':
                    credit = 0
                else:
                    credit += (now - previous) * c['speed'] * self.clock_rate
                    while credit >= 1 and not c['paused']:
                        self.tick()
                        credit -= 1
            previous = now

