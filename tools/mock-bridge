            if rule.get('office',0)>0: out.append('offices')
            if rule.get('industrial',0)>0: out.append('factories')
            if not show and rule.get('nightlife',0)>0: out.append('nightlife')
            if show: out.append('shows')
            if b['key'] in pitches: out.append('pitches')
            if b['key'] in sites: out.append('commissaries')
            return out
        rows=[(math.hypot(b['x']-p['x'],b['z']-p['z']),b,lit(b)) for b in CITY]
        if args.get('op')=='filters':
            counts={}
            for _,_,fs in rows:
                for f in fs: counts[f]=counts.get(f,0)+1
            return {'filters':[{'filter':f,'label':f,'buildings':n} for f,n in sorted(counts.items())]}
        f=need(args,'filter','a map filter (op "filters" lists them)')
        limit=int(max(1,min(100,num(args,'limit') if num(args,'limit') is not None else 30)))
        matched=sorted(((d,b) for d,b,fs in rows if f in fs),key=lambda t:t[0])
        out=[]
        for d,b in matched[:limit]:
            street,number=b['key'].replace('ba:street_','').split('#')
