            add(LOCALE['foodtrucks:dialog_commissary_order_change'])
            add('Hang up')
        elif self.dialog == 'crew':
            for slot in range(3):
                add('Unassigned','option',f'Crew{slot+1}/option[0]')
                for i,e in enumerate(self.employees):
                    if e['name'] not in self.vehicle()['crew'] or self.vehicle()['crew'][slot:slot+1]==[e['name']]:
                        add(e['label'],'option',f'Crew{slot+1}/option[{i+1}]')
            add(LOCALE['foodtrucks:bizman_page_add_here'])
            add(LOCALE['foodtrucks:bizman_page_back'])
        elif self.dialog in ('opens','closes'):
            for text in ('08:30','11:00','22:00') if self.dialog=='opens' else ('00:00','14:00','02:00'):
