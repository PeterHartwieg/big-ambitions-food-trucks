    def drive_status(self, advance=True):
        run=self.drive_run
        if run is None: return {'running':False,'phase':'none'}
        # The mock's ride ends at the first look after its start.
        if advance and run['running']: self.finish_drive(run)
        v=next((x for x in self.state['vehicles'] if x['id']==run['id']),None)
        out={k:copy.deepcopy(val) for k,val in run.items() if not k.startswith('_')}
        out['truck']=None if v is None else {'x':round(v['x'],2),'y':0.,'z':round(v['z'],2),'heading':round(v['heading'],2)}
        return out

    def finish_drive(self, run):
        v=self.vehicle(run['id'])
        goal=(run['goal']['x'],run['goal']['z'])
        if run['phase']=='riding':
            if self.ride_refusal:
                # Refused before it drove, from each of three places on the lane; then back into the space.
                run['ride']={'kind':'own','refused':self.ride_refusal}
                run['attempts']=[{'pull_out':run['pull_out'],'refused':self.ride_refusal} for _ in range(3)]
                x,z,h=run['_start']; v.update(x=x,z=z,heading=h,legal=True)
                return self.end_drive(run,f"Self Driving refused the ride from 3 places on the lane: {self.ride_refusal}; the truck is back where it stood")
            run['ride']={'kind':'own','end':'Complete: arrived','seconds':round(run['_distance']/8,1),'contacts':0,'contactsCaused':0,'arrivedMetres':9.5,'carMetres':12.0,'inCar':True}
            run['seconds']=run['ride']['seconds']; run['game_minutes']=round(run['_distance']*0.04,1)
            v.update(x=goal[0],z=goal[1]+12.)
        run['phase']='parking'
        space=next((s['site'] for s in self.state['commissary']['spaces'] if s['vehicle']==v['id']),None)
        if run['_site']:
            self.place_vehicle(v,run['_site'])
            run['park']={'x':round(v['x'],2),'y':0.,'z':round(v['z'],2),'heading':0.,'in_the_way_after':[],'parked':True,'where':'bay:'+run['_site']}
        else:
            v.update(x=goal[0],z=goal[1]+4.,heading=90.,legal=True,hatch_to_pavement=True,commissary={'site':space,'in_bay':False,'bay_site':None} if space else None)
            run['park']={'x':round(v['x'],2),'y':0.,'z':round(v['z'],2),'heading':90.,'in_the_way_after':[],'parked':True,'where':'kerb','from_goal':4.}
        return self.end_drive(run,None)

    def end_drive(self, run, error):
        run.update(running=False,phase='failed' if error else 'done',error=error,vehicle=copy.deepcopy(self.vehicle(run['id'])))
        self.event(f"Test bridge: drive {run['id']} to {run['place']}: {'failed: '+error if error else 'done after '+format(run['seconds'],'.0f')+' s'}.")

