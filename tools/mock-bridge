        return entries

    def click(self, args):
        if num(args, 'id') is not None:
            identifier = int(args['id'])
            entry = next((b for b in self.last_ui if b['id']==identifier),None)
            if not entry: raise ValueError(f'No entry {identifier} in the last ui list; list again.')
            buttons=self.buttons()
            current=next((b for b in buttons if b['path']==entry['path'] and b['kind']==entry['kind']),None)
            if current is None:
                if entry['kind']=='option' and any(b['kind']=='option' and b['path'].split('/option[')[0]==entry['path'].split('/option[')[0] for b in buttons):
                    raise ValueError(f"the control with id {identifier} now reads ''; list again.")
                raise ValueError(f"Entry {identifier} ({entry['text']}) is no longer on screen; list again.")
            if current['text'] != entry['text']:
                raise ValueError(f"the control with id {identifier} now reads '{current['text']}'; list again.")
        elif args.get('text') is not None:
            text = str(args['text'])
            self.last_ui = entries = self.buttons()
            matches = [b for b in entries if b['text'].casefold()==clean(text).casefold()]
            if not matches:
                near = [f"{b['id']} \"{b['text']}\"" for b in entries if clean(text).casefold() in b['text'].casefold()][:8]
                raise ValueError(f'No button or option reads "{text}"' + ('; close ones: '+', '.join(near) if near else '') + '.')
            if len(matches)>1:
                places = ', '.join(f"{b['id']} ({b['path']})" for b in matches)
                raise ValueError(f'{len(matches)} entries read "{text}": {places}; click by id.')
            entry = matches[0]
            current=entry
        else: raise ValueError('ui click needs "id" (from the last list) or "text".')
        if self.work and current['path'].startswith('Mock/closed/Work/'):
            if current['kind']=='slider': raise ValueError('Work duration is a slider: ui set with its id and a value.')
            self.work_control(self.vehicle(self.work['vehicle']), 'fast_forward' if current['kind']=='toggle' else 'skip_work',
                              {'enabled':not self.work['fast_forward'],'minutes':self.work['minutes']})
            return {'clicked':entry['text']}
        if self.dialog in LIFE_DIALOGS:
            if current.get('kind')=='slider': raise ValueError(f"\"{current['text']}\" is a slider: ui set with its id and a value.")
            self.event(f'Test bridge: clicked "{entry["text"]}" ({entry["path"]}).')
            self.life_click(current['text'])
            return {'clicked':entry['text']}
        text = current['text']
        native=re.search(r'(?:LoadGame|SaveGameCompatibilityUI|FuneralUI)',current['path'])
        in_pause=re.search(r'(?:MiniMenu|Pause)(?:/|$)',current['path'])
        confirm=re.search(r'(?:HudConfirm|Confirmation)',current['path'])
        if native or (in_pause and re.search(r'save|load',current['path']+' '+text,re.I)) or (self.pause_menu_open and self.confirmation_open and confirm):
            raise ValueError("ui click refuses the game's save and load controls; use the save and load commands.")
        if entry['kind']=='option':
            self.choice = text
            if self.dialog=='crew':
                v=self.vehicle()
                v['crew']=[] if text=='Unassigned' else [next(e['name'] for e in self.employees if e['label']==text)]
        elif text==LOCALE['foodtrucks:itempanel_commissary_stock']:
            self.dialog='commissary'
        elif text==LOCALE['foodtrucks:bizman_page_add_here']:
            self.dialog='opens'
        elif text=='Confirm':
            if self.dialog=='commissary':
                taken=re.match(r'(Take|Return) (.+): [\d,]+ (?:here|on board)$',self.choice)
                if taken:
                    self.operate(self.vehicle(),'transfer',{'direction':taken.group(1).lower(),'item':taken.group(2)})
                else: self.operate(self.vehicle(),'restock')
                self.dialog='closed'
            elif self.dialog=='items':
                self.boxes=max(1,self.boxes)
                self.dialog='order'
            elif self.dialog=='opens':
                self.open_minute=minute(self.choice)
                self.dialog='closes'
            elif self.dialog=='closes':
                v=self.vehicle()
                end=minute(self.choice)
                if end<=self.open_minute: end+=1440
                self.routes[v['id']]=(self.open_minute,end)
                v['route']=week_route(self.open_minute, end, v['x'], v['z'])
                self.dialog='closed'
        elif text==LOCALE['foodtrucks:dialog_commissary_order_stock']:
            self.dialog='order'; self.boxes=0
        elif text=='ADD ITEM': self.dialog='items'
        elif text==LOCALE['foodtrucks:dialog_commissary_order_check']:
            if self.boxes: self.dialog='confirm'
            else: self.event(LOCALE['foodtrucks:notification_commissary_order_empty'],'notice')
        elif text==LOCALE['foodtrucks:dialog_commissary_order_confirm']:
            self.add_order(self.vehicle()['commissary']['bay_site'], self.boxes)
            self.dialog='phone'
        elif text==LOCALE['foodtrucks:dialog_commissary_order_change']: self.dialog='order'
        elif text==LOCALE['foodtrucks:bizman_page_back']: self.dialog='fleet'
        elif text in ('Hang up', 'Cancel'): self.dialog='closed'
        elif text==LOCALE['foodtrucks:overlay_open']: self.operate(self.vehicle(),'open')
        self.event(f'Test bridge: clicked "{entry["text"]}" ({entry["path"]}).')
        return {'clicked':entry['text']}

    def at_hatch(self, v, how):
        self.activity_starting=False
        self.state['player'].update(in_vehicle=None, at_hatch=v['id'])
        self.start_work(v)
        v['serving']='player'
        self.event(f"Truck window: player placed at the hatch of truck {v['id']} ({how}) at (0, 0, 0).")

    def place_cart_server(self, v):
        angle = math.radians(v['heading'])
        side = -1 if v['hatch_side'] == 'left' else 1
        outward = (side*math.cos(angle), -side*math.sin(angle))
        forward = (math.sin(angle), math.cos(angle))
        candidates = [('behind the cart, opposite the queue', -outward[0]*.85, -outward[1]*.85),
                      ('at the front end beside the window', forward[0]*1.07, forward[1]*1.07),
                      ('at the rear end beside the window', -forward[0]*1.07, -forward[1]*1.07)]
        for placement, dx, dz in candidates:
            point = (v['x']+dx, v['y'], v['z']+dz)
            if not self.cart_serving_safe(v, point): continue
            facing = (math.degrees(math.atan2(outward[0]*1.05-dx, outward[1]*1.05-dz)) + 360) % 360
            self.state['player'].update(x=point[0], y=point[1], z=point[2], heading=facing)
            self.start_work(v)
            self.event(f"Cart serving: {v['id']}: player placed {placement} at {point}; pedestrian ground, off street, complete player path (mock).")
            return
        self.event(f"Cart serving: {v['id']}: no safe reachable serving point behind the cart or at either end; player left where they stand.")

    def start_work(self, v):
        self.finish_work()
        self.work = {'vehicle': v['id'], 'minutes': 60, 'fast_forward': False, 'time_skip': False, 'stock_read_only': True}

    def finish_work(self):
        if self.work and self.work['fast_forward']:
            self.state['clock'].update(speed=1, paused=False)
        if self.work and self.work['time_skip']:
            self.time_skip=False
            self.state['clock'].update(speed=1, paused=False)
        self.work=None
        self.work_goal=None

    def work_control(self, v, op, args):
        if not self.work or self.work['vehicle']!=v['id'] or not v['open']:
            raise ValueError("Stand at this vehicle's serving window and wait for its work panel first.")
        if self.time_skip: raise ValueError('A time skip is running; wait for it to end.')
        if op=='fast_forward':
            on=args.get('enabled',True)
            if not isinstance(on,bool): raise ValueError('enabled must be true or false.')
            self.work['fast_forward']=on
            self.state['clock'].update(speed=60 if on else 1,paused=False)
        elif op=='skip_work':
            minutes=num(args,'minutes')
            if minutes is None or not math.isfinite(minutes) or int(minutes)!=minutes or not 5<=minutes<=720:
                raise ValueError('minutes must be a whole number from 5 to 720.')
            self.work.update(minutes=int(minutes), time_skip=True)
            self.work_goal=self.absolute+int(minutes)
            self.time_skip=True
            self.state['clock'].update(paused=True,keep_needs=False)
        else:
            self.finish_work()
            self.state['player']['at_hatch']=None
        return {'done':True,'why':None,'notices':[],'state':next(vehicle for vehicle in self.read_state()['vehicles'] if vehicle['id']==v['id'])}

    def operate(self, v, op, args=None):
        player = self.state['player']
        args=args or {}
        if op in ('fast_forward','skip_work','stop_work'): return self.work_control(v,op,args)
        if op in ('step_out','close','enter') and self.work and self.work['vehicle']==v['id']: self.finish_work()
        start=self.seq
        why=None
        cargo_before=copy.deepcopy(v['stock'])
        pieces_before=len(v['pieces'])
        space_before=(v['commissary'] or {}).get('site')
        if not self.mod_loaded: raise ValueError("The mod's save data isn't loaded.")
        label={'exit':'Park','restock':'Commissary stock','transfer':'Commissary stock'}.get(op)
        if label and player['in_vehicle'] != v['id']:
            raise ValueError(f"{label} is on the vehicle's panel, shown while the player drives the truck or pushes the cart: vehicle enter first.")
        if op=='open':
            if player['in_vehicle']:
                raise ValueError(f"Open for business is in the parked vehicle's on-foot menu: vehicle exit first (the player is in {player['in_vehicle']}).")
            if v['open']: raise ValueError(f"Vehicle {v['id']} is open already.")
            expiry=self.state['licence']['until_day']
            reason=None
            if not v['pieces']: reason='notification_open_no_equipment'
            elif not any(s['amount']>0 for s in v['stock']): reason='notification_open_no_stock'
            elif expiry is None: reason='notification_open_no_licence'
            elif expiry<self.state['clock']['day']: reason='notification_open_licence_expired'
            elif not v['hatch_to_pavement'] and v['kind']=='truck': reason='legality_truck_hatch'
            if reason:
                self.event(LOCALE.get('foodtrucks:'+reason, LOCALE['foodtrucks:legality_truck_parking']).format(vehicle=v['kind']),'notice')
            else:
                v.update(open=True, serving='nobody',queue={'length':0,'places':[]})
                player['in_vehicle']=None
                if v['kind']=='truck':
                    self.activity_starting=True
                    self.walks.append((time.monotonic()+.05,lambda:self.at_hatch(v,'opened')))
                else:
                    v['hatch_side'] = v['hatch_side'] or 'right'
                    self.place_cart_server(v)
                    v['serving'] = self.serving(v)
        elif op=='work_window':
            if v['kind']!='cart' or not v['open'] or player['in_vehicle'] or self.work:
                raise ValueError('Work the window needs an open cart and the player free on foot.')
            self.place_cart_server(v)
        elif op=='back_to_hatch':
            if v['kind']!='truck' or not v['open'] or player['in_vehicle'] or player['carrying'] or player['at_hatch'] or self.walks:
                raise ValueError("Back to the hatch isn't offered now: it needs an open truck and the player on foot, empty-handed and not at a hatch.")
            self.event(f"Truck window: back to the hatch of truck {v['id']}: walking to the rear door.")
            self.walks.append((time.monotonic()+.05,lambda:self.at_hatch(v,'back to the hatch')))
        elif op=='step_out':
            if player['at_hatch']!=v['id']: raise ValueError(f"The player isn't at the hatch of {v['id']}.")
            player['at_hatch']=None
            v['serving']='crew' if v['crew'] else 'nobody'
            self.event(f"Truck window: player stepped out of truck {v['id']} at (0, 0, 0) (stepped out).")
            if not v['crew']:
                self.event(f"Window {v['id']}: nobody serving the truck; the player left the hatch: stepped out.")
                # As in game: the notice comes from the next per-minute sales check, not with the step-out.
                self.__dict__.setdefault('paused_notice', set()).add(v['id'])
        elif op=='close':
            if not v['open']: raise ValueError(f"Vehicle {v['id']} isn't open.")
            v.update(open=False,serving='nobody',queue=None)
            if player['at_hatch']==v['id']: player['at_hatch']=None
        elif op=='enter':
            if player['in_vehicle']==v['id']: raise ValueError(f"The player is in {v['id']} already.")
            if player['in_vehicle']: raise ValueError(f"The player is in another vehicle ({player['in_vehicle']}): vehicle exit first.")
            def arrive():
                player.update(in_vehicle=v['id'],at_hatch=None,x=v['x'],y=v['y'],z=v['z'])
                v.update(open=False,serving='nobody',queue=None)
            if ((player['x']-v['x'])**2+(player['z']-v['z'])**2)**.5>2.5:
                self.walks.append((time.monotonic()+.05,arrive))
            else: arrive()
        elif op=='exit':
            if self.state['clock']['paused']: raise ValueError("The game's Park button refused: paused, no parking here, or the panel isn't showing.")
            player['in_vehicle']=None
        elif op in ('rent_bay','restock','transfer'):
            c=v['commissary']
            refused="the commissary's Spaces refused (see the notice)" if op=='rent_bay' else 'the Commissary stock button refused (see the notice)'
            if op=='transfer':
                args=args or {}
                direction=need(args,'direction','take or return'); item=need(args,'item','an item key or name')
                units=num(args,'units')
                if units is not None and units<1: raise ValueError('units is a whole number from 1, or left out for as many as fit (take) or all on board (return).')
            if not self.can_write:
                why=refused
                self.event(LOCALE['foodtrucks:notification_data_readonly'],'notice')
            elif not c or not c['in_bay']:
                why=refused
                self.event(LOCALE['foodtrucks:notification_commissary_not_here'].format(vehicle=v['kind']),'notice')
            elif op=='rent_bay' and c['site']==c['bay_site']:
                why="the commissary's Spaces offer release for this vehicle here, not rent or move"
            elif op=='transfer':
                why=self.transfer(v,direction,item,units)
            else:
                self.commissary_panel(v,op)
        else: raise ValueError(f"Unknown op '{op}': open, close, fast_forward, skip_work, stop_work, work_window, step_out, back_to_hatch, enter, exit, restock, transfer, rent_bay or buy.")
        done = {'open':v['open'], 'close':not v['open'], 'step_out':player['at_hatch']!=v['id'],
                'work_window':bool(self.work and self.work['vehicle']==v['id']),
                'back_to_hatch':bool(self.walks) or player['at_hatch']==v['id'],
                'enter':player['in_vehicle']==v['id'] or bool(self.walks), 'exit':player['in_vehicle']!=v['id'],
                'restock':v['stock']!=cargo_before, 'transfer':v['stock']!=cargo_before or len(v['pieces'])!=pieces_before,
                'rent_bay':(v['commissary'] or {}).get('site') is not None and (v['commissary'] or {}).get('site')!=space_before}[op]
        self.event(f"Test bridge: vehicle {v['id']} {op}: {'done' if done else 'not done'}.")
        notices=[e['text'][8:] for e in self.ring if e['seq']>start and e['kind']=='notice']
        return {'done':done,'why':None if done else why,'notices':notices,'state':next(vehicle for vehicle in self.read_state()['vehicles'] if vehicle['id']==v['id'])}

    # Commissary stock's take or return of one item (by key or name), as TransferForTesting: a take loads what the
    # item's piece still holds, a return gives back all on board (or units). Returns why not, or None.
    def transfer(self, v, direction, item, units):
        if direction not in ('take','return'): return f"direction is take or return, not '{direction}'"
        site=v['commissary']['bay_site']
        here=[s for s in self.state['commissary']['stock'] if s['site']==site and s['amount']>0]
        source=here if direction=='take' else [s for s in v['stock'] if s['amount']>0]
        line=next((s for s in source if s['key']==item or s['item'].casefold()==str(item).casefold()),None)
        if line is None:
            return f"Commissary stock offers no {direction} of '{item}' here ({', '.join(s['key'] for s in source) or 'none'})"
        if direction=='take' and line['key'] in PIECES:
            # A piece of equipment goes on one at a time, into a free slot.
            if len(v['pieces'])>=SLOTS[v['kind']]:
                self.event(f"The {v['kind']} has no free place for {line['item']}.",'notice'); return 'refused by the cargo: NoSlot'
            line['amount']-=1
            v['pieces'].append({'item':PIECES[line['key']],'units':0,'cap':PER_PIECE[v['kind']]})
            self.event(LOCALE['foodtrucks:notification_commissary_stock_took'].format(units=1,item=line['item'],vehicle=v['kind'],capped='',left=line['amount']),'notice')
            return None
        if direction=='take':
            holds=HOLDS.get(line['key'])
            pool=next((p for p in v['pieces'] if p['item']==holds),None)
            room=max(0,int(pool['cap']-pool['units'])) if pool else 0
            amount=min(line['amount'],room,units if units is not None else room)
            if amount<=0:
                self.event(f"Nothing on this {v['kind']} holds {line['item']}.",'notice'); return f'refused by the cargo: {"PieceFull" if pool else "NoPiece"}'
            pool['units']+=amount; line['amount']-=amount
            cargo=next((s for s in v['stock'] if s['key']==line['key']),None)
            if cargo: cargo['amount']+=amount
            else: v['stock'].append({'item':line['item'],'key':line['key'],'amount':amount})
            left=line['amount']
            self.event(LOCALE['foodtrucks:notification_commissary_stock_took'].format(units=amount,item=line['item'],vehicle=v['kind'],capped='',left=left),'notice')
        else:
            amount=min(line['amount'],units if units is not None else line['amount'])
            line['amount']-=amount
            for pool in v['pieces']:
                if pool['item']==HOLDS.get(line['key']): pool['units']=max(0,pool['units']-amount)
            stock=next((s for s in self.state['commissary']['stock'] if s['site']==site and s['key']==line['key']),None)
            if stock: stock['amount']+=amount
            else: self.state['commissary']['stock'].append({'site':site,'item':line['item'],'key':line['key'],'amount':amount})
            here_now=sum(s['amount'] for s in self.state['commissary']['stock'] if s['site']==site and s['key']==line['key'])
            self.event(LOCALE['foodtrucks:notification_commissary_stock_returned'].format(units=amount,item=line['item'],here=here_now),'notice')
        return None

    def commissary_panel(self, v, op):
        c=v['commissary']
        site=c['bay_site']
        if op=='rent_bay':
            if c['site']==site:
                return
            self.state['commissary']['spaces']=[s for s in self.state['commissary']['spaces'] if s['vehicle']!=v['id']]+[{'site':site,'vehicle':v['id']}]
            previous=c['site']
            c['site']=site
            monthly=TUNING['commissary']['rentPerMonthCents'][v['kind']]
            charge=int(monthly*12/365+.5)/100
            if previous is None:
                if self.state['money']>=charge:
                    self.pay(-int(round(charge*100)),'foodtrucks:transaction_commissary_rent',commissary=LOCALE['foodtrucks:commissary_'+site])
                    self.book(self.state['clock']['day'],v['id'],'commissary_rent',int(round(charge*100)))
                else: self.state['commissary']['unpaid']['rent']+=charge
                text=LOCALE['foodtrucks:notification_commissary_rented'].format(vehicle=v['kind'],commissary=LOCALE['foodtrucks:commissary_'+site],rent=f'${monthly/100:,.2f}')
            else:
                text=LOCALE['foodtrucks:notification_commissary_moved'].format(vehicle=v['kind'],commissary=LOCALE['foodtrucks:commissary_'+site],**{'from':LOCALE['foodtrucks:commissary_'+previous]})
            self.event(text,'notice')
        elif not any(s['site']==site and s['amount']>0 for s in self.state['commissary']['stock']):
            self.event(LOCALE['foodtrucks:notification_commissary_nostock'].format(commissary=LOCALE['foodtrucks:commissary_'+site]),'notice')
        else:
            loaded=[]
            for stock in self.state['commissary']['stock']:
                if stock['site']!=site: continue
                holds=HOLDS.get(stock['key'])
                pool=next((p for p in v['pieces'] if p['item']==holds),None)
                if not pool: continue
                amount=min(stock['amount'],max(0,int(pool['cap']-pool['units'])))
                pool['units']+=amount; stock['amount']-=amount
                cargo=next((s for s in v['stock'] if s['key']==stock['key']),None)
                if cargo: cargo['amount']+=amount
                else: v['stock'].append({'item':stock['item'],'key':stock['key'],'amount':amount})
                if amount: loaded.append(f'{amount} {stock["item"]}')
            left=sum(s['amount'] for s in self.state['commissary']['stock'] if s['site']==site)
            if loaded: self.event(LOCALE['foodtrucks:notification_commissary_restocked'].format(vehicle=v['kind'],loaded=', '.join(loaded),full='',left=left),'notice')
            else: self.event(LOCALE['foodtrucks:notification_commissary_restock_full'].format(vehicle=v['kind'],left=left),'notice')

    # The fixture and logistics commands (docs/test-bridge.md): a warehouse, a headquarters and a plan to a commissary,
    # kept as one record per save; the run moves what is missing up to each target from the warehouse to the commissary.
    FIXTURE_STEPS = ('commissary_space','warehouse','pallets','stock','headquarters','logistics_manager','vehicle','driver','plan')
    ITEM_NAMES = {'ba:itemname_hotdog':'Hotdog'}

    def fixture(self, args):
        name=need(args,'name',"the fixture's name: logistics")
        if name!='logistics': raise ValueError(f"No fixture '{name}'. Fixtures: logistics.")
        if self.inside_building:
            raise ValueError("The player is inside a building; the game places furniture and vehicles only in buildings the player isn't in. Teleport the player outside first.")
        site=args.get('site') or 'hells-kitchen'
        if site not in SITES: raise ValueError(f"No commissary '{site}'. Commissaries: {', '.join(SITES)}.")
        def rows(key, amount, default):
            value=args.get(key)
            if value is None: return default
            if not isinstance(value,list) or not value: raise ValueError(f'"{key}" is a list: [ {{ "item", "{amount}" }} ].')
            return [(r['item'],int(r[amount])) for r in value]
        stock=rows('stock','units',[('ba:itemname_hotdog',200)])
        targets=rows('targets','amount',[('ba:itemname_hotdog',40)])
        steps=[]
        def step(name,status,detail):
            steps.append({'step':name,'status':status,'detail':detail})
            self.event(f'Test bridge: fixture logistics, {name}: {status}: {detail}')
        spaces=self.state['commissary']['spaces']
        if any(s['site']==site for s in spaces):
            step('commissary_space','already',f'{site} has a space')
        else:
            free=[v for v in self.state['vehicles'] if not any(s['vehicle']==v['id'] for s in spaces)]
            if not free:
                step('commissary_space','failed','no food cart or truck in this save; a space is rented for a vehicle (debug spawn truck, or buy one), then run the fixture again')
                for rest in self.FIXTURE_STEPS[1:]: step(rest,'not_run','an earlier step failed')
                return {'fixture':'logistics','complete':False,'site':site,'steps':steps,'warehouse':None,'headquarters':None,'plan':None}
            v=free[0]
            spaces.append({'site':site,'vehicle':v['id']})
            v['commissary']={**(v['commissary'] or {'in_bay':False,'bay_site':None}),'site':site}
            step('commissary_space','done',f"{v['kind']} {v['id']} rented a space at {site}")
        made=self.logistics is None
        if made:
            self.logistics={'warehouse':{'name':'FT Fixture Warehouse','address':'ba:street_mockstreet#2','type':'ba:businesstype_warehouse'},
                            'headquarters':{'name':'FT Fixture HQ','address':'ba:street_mockstreet#4','type':'ba:businesstype_headquarters'},
                            'stock':{}, 'plan':{'id':'mockplan','destinations':[]}}
        lg=self.logistics
        for name in ('warehouse','pallets'): step(name,'done' if made else 'already','mock')
        added=[f'{amount-lg["stock"].get(item,0)} {item}' for item,amount in stock if lg['stock'].get(item,0)<amount]
        for item,amount in stock: lg['stock'][item]=max(amount,lg['stock'].get(item,0))
        step('stock','done' if added else 'already',', '.join(added) or 'mock')
        for name in ('headquarters','logistics_manager','vehicle','driver'): step(name,'done' if made else 'already','mock')
        dest=next((d for d in lg['plan']['destinations'] if d['site']==site),None)
        changed=dest is None
        if dest is None:
            dest={'site':site,'targets':{}}
            lg['plan']['destinations'].append(dest)
        for item,amount in targets:
            if dest['targets'].get(item)!=amount: dest['targets'][item]=amount; changed=True
        step('plan','done' if changed else 'already',f'destination {lg["plan"]["destinations"].index(dest)+1} of 1')
        return {'fixture':'logistics','complete':True,'site':site,'steps':steps,'warehouse':lg['warehouse'],'headquarters':lg['headquarters'],
                'plan':self.plan_json()}

    def held(self, site, item):
        return sum(s['amount'] for s in self.state['commissary']['stock'] if s['site']==site and s.get('key')==item)

    def plan_json(self):
        lg=self.logistics
        items=sorted({item for d in lg['plan']['destinations'] for item in d['targets']})
        return {'id':lg['plan']['id'],'headquarters':lg['headquarters']['address'],
                'warehouse':{**{k:lg['warehouse'][k] for k in ('name','address')},'stock':[{'item':i,'amount':lg['stock'].get(i,0)} for i in items]},
                'manager':{'id':'mockmanager','name':'Mock Manager','skill':60.0},'max_destinations':1,
                'destinations':[{'index':n+1,'site':d['site'],'address':None,
                                 'targets':[{'item':i,'target':t,'held':self.held(d['site'],i)} for i,t in d['targets'].items()]}
                                for n,d in enumerate(lg['plan']['destinations'])]}

    def logistics_command(self, args):
        op=need(args,'op','status or run')
        only=args.get('warehouse')
        plans=lambda: [self.plan_json()] if self.logistics and only in (None,self.logistics['warehouse']['address']) else []
        if op=='status': return {'plans':plans()}
        if op!='run': raise ValueError(f"Unknown logistics op '{op}': status, run.")
        self.require_ft('logistics run')
        before=plans()
        planned=0
        if self.logistics:
            lg=self.logistics
            for d in lg['plan']['destinations'][:1]:
                planned+=1
                moved=[]
                for item,target in d['targets'].items():
                    take=min(max(0,target-self.held(d['site'],item)),lg['stock'].get(item,0))
                    if take<=0: continue
                    lg['stock'][item]-=take
                    line=next((s for s in self.state['commissary']['stock'] if s['site']==d['site'] and s.get('key')==item),None)
                    if line: line['amount']+=take
                    else: self.state['commissary']['stock'].append({'site':d['site'],'item':self.ITEM_NAMES.get(item,item),'key':item,'amount':take})
                    moved.append((item,take))
                text=', '.join(f'{n} {i}' for i,n in moved) if moved else 'nothing brought'
                self.event(f"Commissary logistics: {lg['warehouse']['name']} to {d['site']}: {text} ({sum(n for _,n in moved)} units).")
        c=self.state['clock']
        self.event(f"Test bridge: logistics run now (the game's 02:00 warehouse deliveries), day {c['day']} {c['time']}: {planned} destinations planned.")
        return {'deliveries':planned,'before':before,'after':plans()}

    # ---- the player's life: clicks on things, the taxi, the phone, eating and furniture ----
    def door(self, address):
        b=next((b for b in CITY if b['key']==address),None)
        if b is None: raise ValueError(f'no building at {address} in this city')
        return (b['x']+6.,b['z'])

    def building(self, address):
        return next((b for b in CITY if b['key']==address),None)

    def things(self, radius):
        p=self.state['player']; life=self.life; out=[]
        for box in life['dropped']:
            d=math.hypot(box['x']-p['x'],box['z']-p['z'])
            if box['inside']==life['inside'] and d<=radius:
                out.append({'kind':'DroppedContainer','name':box['hands']['item'],'click':'Click to grab','x':box['x'],'z':box['z'],
                            'distance':round(d,1),'box_id':box['id']})
        for t in self.near_handtrucks():
            out.append({'kind':'HandTruck','name':t['name'],'click':'Click to use','x':t['x'],'z':t['z'],
                        'distance':self.handtruck_entry(t)['distance'],'truck_id':t['id']})
        if life['inside']:
            b=self.building(life['inside']) or {}
            business=b.get('businessType')
            def thing(kind,name,click,**extra): out.append({'kind':kind,'name':name,'click':click,'x':round(p['x']+1.5,2),'z':round(p['z'],2),'distance':1.5,**extra})
            if business=='ba:businesstype_school':
                thing('EducationDoorController','Market Demands','Click to learn')
                thing('EducationDoorController','Basic HR','Click to learn')
            if business=='ba:businesstype_recruitmentagency':
                thing('BusinessEmployeeController','Receptionist','Click to talk')
            for key,name,price,kind,_ in SHOPS.get(business,[]):
                if business not in FULL_SERVICE: thing('ItemController',name,None,sells=name,sells_key=key)
            if business in SHOPS: thing('CashRegisterController','Cash register','Click to order' if business in FULL_SERVICE else 'Click to purchase')
            for i,_ in enumerate(life['beds'].get(life['inside'],[])):
                thing('BedController','King size bed','Click to sleep')
            return out
        out.append({'kind':'TaxiController','name':'Taxi','click':'Click to use taxi','x':round(p['x']+8,2),'z':round(p['z'],2),'distance':8.})
        for b in CITY:
            x,z=b['x']+6.,b['z']; d=math.hypot(x-p['x'],z-p['z'])
            if d>radius: continue
            yours=b['key'] in life['homes']
            for_rent=b.get('buildingType')=='ba:buildingtype_residential' and not yours and not b.get('businessType')
            business=(b.get('businessType') or '').replace('ba:businesstype_','').title() or None
            out.append({'kind':'CityBuildingController','name':business or (b.get('buildingType') or 'building').replace('ba:buildingtype_','').title(),
                        'click':None,'x':round(x,2),'z':round(z,2),'distance':round(d,1),'address':b['key'],'business':business,'for_rent':for_rent,'yours':yours})
        return sorted(out,key=lambda t:t['distance'])[:40]

    def skip(self, minutes, regen=0.):
        # A time skip: the minutes pass at once, with what they bring (midnight, deliveries); energy builds up meanwhile.
        needs=self.state['player']['needs']
        for _ in range(int(round(minutes))):
            self.tick()
            if regen: needs['energy']=min(needs['max'],needs['energy']+regen+.056)

    def carry_guard(self):
        if self.time_skip: raise ValueError('Time is skipping (sleep, a course, a ride): carrying controls waits until it ends.')
        if self.clock_held_by() or self.dialog=='purchase': raise ValueError('Not now: close what is open first (ui escape).')

    def carry_command(self, cmd, args):
        self.require_ft(cmd)
        self.carry_guard()
        life=self.life; p=self.state['player']
        if cmd=='pickup':
            ident=num(args,'id')
            if ident is None: raise ValueError('pickup needs id from the last use list.')
            if ident!=int(ident) or not 1<=ident<=len(self.last_use) or self.last_use[int(ident)-1]['kind']!='DroppedContainer':
                raise ValueError("That isn't a placed box or bag in the last use list; list again.")
            if not any(b['id']==self.last_use[int(ident)-1]['box_id'] for b in life['dropped']):
                raise ValueError("That isn't a placed box or bag in the last use list; list again.")
            return self.life_command('use',{'op':'click','id':ident})
        hands=life['hands']
        if not hands: raise ValueError('Your hands are empty.')
        if hands['key']=='ba:itemname_mop':
            life['hands']=None
            return {'item':'mop','placed':True,'why':None,'notices':[]}
        x,z=num(args,'x'),num(args,'z')
        if (x is None)!=(z is None): raise ValueError('drop takes both x and z, or neither.')
        if life['inside'] not in life['homes']:
            raise ValueError('The game allows putting items down only inside a building you can edit; outside, load a hand truck instead.')
        if hands['key'] not in ('ba:itemname_closedcardboardbox','ba:itemname_paperbag') or (hands['key']=='ba:itemname_paperbag' and not hands['contents']):
            raise ValueError('The game offers no put-down action for this item; return it or load it into storage.')
        x,z=(p['x'],p['z']) if x is None else (x,z)
        placed=not life['drop_blocked']
        if placed:
            life['dropped'].append({'id':uuid.uuid4().hex,'inside':life['inside'],'x':x,'z':z,'hands':hands})
            life['hands']=None
        return {'item':hands['item'],'placed':placed,'still_placing':False,'why':None if placed else 'no room there (a wall or another thing is in the way)',
                'x':round(x,2),'z':round(z,2),'rotation':0.,'notices':[]}

    def near_handtrucks(self):
        p=self.state['player']
        return sorted((t for t in self.life['handtrucks'] if t['inside']==self.life['inside'] and abs(t['y']-p['y'])<=4 and
                       math.hypot(t['x']-p['x'],t['z']-p['z'])<=20),key=lambda t:math.hypot(t['x']-p['x'],t['z']-p['z']))

    def handtruck_entry(self, t):
        p=self.state['player']
        return {'id':t['id'],'name':t['name'],'pushing':p['in_vehicle']==t['id'],'distance':round(math.hypot(t['x']-p['x'],t['z']-p['z']),1),
                'contents':[{k:c[k] for k in ('item','key','amount','paid')} for c in t['contents'] if c['amount']>0]}

    def handtruck_load(self, truck):
        hands=self.life['hands']
        if not hands: return
        if hands['key']!='ba:itemname_closedcardboardbox':
            if len(truck['contents'])<truck['capacity']:
                truck['contents'].append({'key':hands['key'],'item':hands['item'],'amount':1,
                                          'paid':all(c['paid'] for c in hands['contents']),'held':hands})
                self.life['hands']=None
            return
        # The game may load only part of a box, leaving the rest in hands. Mock slots represent whole cargo boxes.
        while hands['contents'] and len(truck['contents'])<truck['capacity']:
            truck['contents'].append(hands['contents'].pop(0))
        if not hands['contents']: self.life['hands']=None

    def handtruck_command(self, args):
        op=args.get('op') or 'list'
        if op=='list':
            self.require_city('handtruck list')
            return {'handtrucks':[self.handtruck_entry(t) for t in self.near_handtrucks()]}
        self.require_ft('handtruck '+op)
        if op not in ('grab','release','load','take'): raise ValueError(f"Unknown handtruck op '{op}': list, grab, release, load, take.")
        self.carry_guard()
        if self.state['clock']['paused']: raise ValueError('The game is paused: set a speed before using a hand truck.')
        p=self.state['player']; active=p['in_vehicle']; life=self.life
        ident=args.get('id') or (active if op=='release' else None)
        if not ident: raise ValueError('handtruck needs id from handtruck list.')
        truck=next((t for t in self.near_handtrucks() if t['id']==ident),None)
        if not truck: raise ValueError("That hand truck isn't near you on this floor; list again.")
        if active and active!=ident: raise ValueError('Let go of your current vehicle first.')
        if op=='release' and active!=ident: raise ValueError("You aren't pushing that hand truck.")
        if op in ('grab','load') and (life['hands'] or {}).get('key') in ('ba:itemname_mop','ba:itemname_shoppingbasket'):
            raise ValueError('Return the mop or shopping basket before using a hand truck.')
        if op=='grab' and active==ident: raise ValueError("You're already pushing that hand truck.")
        if op=='load' and not life['hands']: raise ValueError('Your hands are empty.')
        if op in ('load','grab'):
            unpaid=next((c for c in (life['hands'] or {}).get('contents',[]) if c['amount']>0 and not c['paid']),None)
            if unpaid: raise ValueError(f"Pay for it first: {unpaid['item']}.")
        if op=='take' and life['hands']: raise ValueError('Empty your hands before taking a box.')
        done=True
        if op=='release': p['in_vehicle']=None; self.dialog='closed'
        elif op in ('load','grab'):
            self.handtruck_load(truck)
            done=not life['hands']
            if done and op=='grab': p['in_vehicle']=ident
        else:
            wanted=need(args,'item','a cargo item key or name from handtruck list')
            cargo=next((c for c in truck['contents'] if c['key']==wanted or c['item'].casefold()==wanted.casefold()),None)
            if not cargo: raise ValueError("That item isn't on the hand truck; list again.")
            truck['contents'].remove(cargo)
            life['hands']=cargo.get('held') or {'key':'ba:itemname_closedcardboardbox','item':'Closed cardboard box','contents':[cargo]}
            p['in_vehicle']=None; self.dialog='closed'
        return {'done':done,'why':None if done else "the hand truck couldn't take everything; remaining cargo stays in your hands",
                'handtruck':self.handtruck_entry(truck),'hands':copy.deepcopy(life['hands']),'notices':[]}

    # A small deliberately fake 6 x 5 m room on the native world lattice. No tuning or layout advice.
    @staticmethod
    def plan_column(n):
        word=''
        while n>=0:
            word=chr(65+n%26)+word; n=n//26-1
        return word

    def plan_square(self,x,z):
        col=math.floor(x/.5+.5)+1; row=math.floor(z/.5+.5)+1
        return self.plan_column(col)+str(row+1) if 0<=col<14 and 0<=row<12 else None

    def plan_point(self,square):
        m=re.fullmatch(r'([A-Za-z]+)([1-9][0-9]*)',square)
        if not m or len(m[1])>4: raise ValueError('A square is a column and row, for example C4; read floorplan first.')
        col=0
        for c in m[1].upper(): col=col*26+ord(c)-64
        row=int(m[2])
        if col>14 or row>12: raise ValueError(f'Square {square} is outside this floor plan; read floorplan again.')
        return (col-2)*.5,(row-2)*.5

    def plan_bed_geometry(self,x,z,rotation):
        # Fake collider and use target, transformed like an ordinary ground item around its anchor.
        angle=math.radians(rotation); cosine=math.cos(angle); sine=math.sin(angle)
        def world(a,b): return x+a*cosine+b*sine,z+b*cosine-a*sine
        polygon=[world(a,b) for a,b in ((-.25,-.25),(.75,-.25),(.75,1.25),(-.25,1.25))]
        axes=[(1.,0.),(0.,1.)]+[(polygon[(i+1)%4][1]-p[1],p[0]-polygon[(i+1)%4][0]) for i,p in enumerate(polygon)]
        squares=[]
        for row in range(12):
            for col in range(14):
                cx,cz=(col-1)*.5,(row-1)*.5
                for a,b in axes:
                    projection=[px*a+pz*b for px,pz in polygon]; centre=cx*a+cz*b; half=(abs(a)+abs(b))*.25
                    if max(projection)<=centre-half+1e-6 or min(projection)>=centre+half-1e-6: break
                else: squares.append(self.plan_column(col)+str(row+1))
        return squares,world(-.5,.5)

    def floorplan(self,args):
        self.require_ft('floorplan')
        if self.life['inside'] not in self.life['homes']: raise ValueError('floorplan needs the inside of a building you rent or can edit.')
        p=self.state['player']; y=p['y']; floor=2 if y>=3 else 1
        cells=[]; lines=[]; items=[]
        for row in range(12):
            line=[]
            for col in range(14):
                square=self.plan_column(col)+str(row+1)
                kind='wall' if col in (0,13) or row in (0,11) else 'floor'
                if square=='G1': kind='opening'
                if square=='L9': kind='blocked'
                if square=='M10': kind='void'
                cells.append({'square':square,'kind':kind})
                line.append({'wall':'#','floor':'.','opening':'=','blocked':'X','void':' '}[kind])
            lines.append(line)
        for i,(x,z,rotation) in enumerate(self.life['beds'].get(self.life['inside'],[])):
            if self.life['bed_floors'].get(self.life['inside'],{}).get(i,1)!=floor: continue
            label='ABCDEFGHIJKLMNOPQRSTUVWYZabcdefghijklmnopqrstuvwxyz0123456789'[i] if i<61 else '*'
            squares,(use_x,use_z)=self.plan_bed_geometry(x,z,rotation)
            use=self.plan_square(use_x,use_z)
            reachable=not self.life['floorplan_unreachable']
            items.append({'label':label,'id':f'mock-bed-{i+1}','item':'Bed (Individual Modern)','key':'ba:itemname_bedindividualmodern',
                          'anchor':{'square':self.plan_square(x,z),'x':x,'y':y,'z':z},'squares':squares,'rotation':rotation,
                          'use':[{'square':use,'x':use_x,'y':y,'z':use_z,'reachable':reachable,'wall_between':not reachable,
                                  'path':'PathComplete' if reachable else 'PathInvalid'}], 'reachable':reachable,'footprint':'fake room boxes'})
            for square in squares:
                a,b=self.plan_point(square); col=round(a/.5)+1; row=round(b/.5)+1
                lines[row][col]='*' if lines[row][col].isalnum() else label
        square=self.plan_square(p['x'],p['z'])
        if square:
            x,z=self.plan_point(square); lines[round(z/.5)+1][round(x/.5)+1]='@'
        return {'address':self.life['inside'],'session':self.session,'floor':floor,'building_size':'mock-small-room','building_version':1,
                'square_size':.5,'origin':{'square':'A1','x':-.5,'y':y,'z':-.5},'columns':[self.plan_column(i) for i in range(14)],'rows':12,
                'map':[''.join(line) for line in lines],'cells':cells,'items':items,'player':{'square':square,'x':p['x'],'y':y,'z':p['z']},
                'geometry':'fake room; native 0.5 m world-grid anchors; no game geometry or navigation simulated'}

    def place_furniture(self,args):
        life=self.life
        square=args.get('square')
        if square is not None and ('x' in args or 'z' in args): raise ValueError('place takes a square or x and z, not both.')
        if square is not None: x,z=self.plan_point(square)
        else:
            x,z=num(args,'x'),num(args,'z')
            if x is None or z is None: raise ValueError('place needs a square, or x and z.')
        if life['inside'] not in life['homes']: raise ValueError('You can place furniture only inside a building you rent.')
        if not all(math.isfinite(v) for v in (x,z,num(args,'rotation') or 0)): raise ValueError('Placement coordinates and rotation must be finite.')
        x=math.floor(x/.5+.5)*.5; z=math.floor(z/.5+.5)*.5
        rotation=round((num(args,'rotation') or 0)/45)*45%360
        if 'check' in args and not isinstance(args['check'],bool): raise ValueError('place check must be true or false.')
        move=args.get('move'); check=args.get('check') is True
        beds=life['beds'].get(life['inside']) or []
        floor=2 if self.state['player']['y']>=3 else 1
        on_floor=[i for i in range(len(beds)) if life['bed_floors'].get(life['inside'],{}).get(i,1)==floor]
        selected=min(on_floor,key=lambda i: math.hypot(beds[i][0]-self.state['player']['x'],beds[i][1]-self.state['player']['z'])) if on_floor else None
        if move:
            if selected is None or move.lower() not in 'bed (individual modern) ba:itemname_bedindividualmodern': raise ValueError(f"No furniture called '{move}' in this building.")
            name='Bed (Individual Modern)'
        else:
            hands=life['hands']
            if not hands or hands['key']!='ba:itemname_closedcardboardbox' or not hands['contents'] or not hands['contents'][0].get('furniture'):
                raise ValueError("You aren't holding a box of furniture (shops pack what you buy in a box).")
            if not hands['contents'][0]['paid']: raise ValueError("You haven't paid for it.")
            name=hands['contents'][0]['item']
        resolved=self.plan_square(x,z)
        kind=next((c['kind'] for c in self.floorplan({})['cells'] if c['square']==resolved),'void')
        fits=kind in ('floor','opening') and not life['floorplan_blocked']
        why=None if fits else 'that part of the floor can\'t take furniture' if kind=='blocked' else 'no room there (a wall or another thing is in the way)'
        if fits and not check:
            if move: beds[selected]=(x,z,rotation)
            else:
                life['beds'].setdefault(life['inside'],[]).append((x,z,rotation)); life['hands']=None
                life['bed_floors'].setdefault(life['inside'],{})[len(life['beds'][life['inside']])-1]=floor
            self.event(f'Test bridge: place {name} at x {x:.1f}, z {z:.1f}, rotation {rotation:.0f}: placed.')
        _,(use_x,use_z)=self.plan_bed_geometry(x,z,rotation)
        return {'item':name,'placed':fits and not check,'moved':bool(move),'reachable':None if kind in ('blocked','void') else not life['floorplan_unreachable'],
                'checked':check,'fits':fits,'restored':True if check or not fits else None,'blocked_by':'Mock pillar' if life['floorplan_blocked'] else 'Mock wall' if kind=='wall' else None,
                'id':f'mock-bed-{selected+1}' if move else f'mock-bed-{len(life['beds'][life['inside']])}' if fits and not check else None,
                'square':resolved,'position_resolved':kind not in ('blocked','void'),'requested_square':square.upper() if square else None,
                'floor':2 if self.state['player']['y']>=3 else 1,'use':[] if kind in ('blocked','void') else [{'square':self.plan_square(use_x,use_z),'x':use_x,'y':self.state['player']['y'],'z':use_z,
                    'reachable':not life['floorplan_unreachable'],'wall_between':life['floorplan_unreachable'],'path':'PathInvalid' if life['floorplan_unreachable'] else 'PathComplete'}],
                'still_placing':False,'why':why,'x':x,'y':self.state['player']['y'],'z':z,'rotation':float(rotation),'notices':[]}

    def life_command(self, cmd, args):
        life=self.life; p=self.state['player']
        if cmd=='use':
            op=args.get('op') or 'list'
            if op=='list':
                self.require_city('use list')
                radius=max(3.,min(80.,num(args,'radius') or 20.))
                things=self.things(radius)
                for i,t in enumerate(things): t['id']=i+1
                self.last_use=things
                return {'radius':radius,'inside':life['inside'],'things':copy.deepcopy(things)}
            if op!='click': raise ValueError(f"Unknown use op '{op}': list or click.")
            self.require_ft('use '+op)
            ident=num(args,'id')
            if ident is None: raise ValueError('use click needs "id" from the last use list.')
            if not 1<=int(ident)<=len(self.last_use): raise ValueError(f'No thing {int(ident)} in the last use list; list again.')
            if self.state['clock']['paused']: raise ValueError('The game is paused: the walk over takes real time. Set a speed first.')
            t=self.last_use[int(ident)-1]; before=life['inside']; start=self.seq
            why=self.building_use_blocker() if t['kind']=='CityBuildingController' else None
            handled=False if why else self.life_use(t)
            notices=[e['text'] for e in self.ring if e['seq']>start and e['kind']=='notice']
            opened=[x for x in [self.clock_held_by()] if x]
            if t['kind']=='CityBuildingController' and life['inside']==before and not opened:
                why=next(reversed(notices),None) or why or 'The building interaction ended without entering or opening a screen; inspect look before repeating.'
            elif not handled:
                why=next(reversed(notices),None) or why or "The game's click handler declined this interaction without giving a reason; inspect look and ui list."
            return {'clicked':t['name'],'kind':t['kind'],'click':t['click'],'handled':handled,'placing_cancelled':False,'still_walking':False,'inside':life['inside'],
                    'why':why,'still_entering':False,'inside_before':before,'open':opened,'notices':notices,
                    'x':round(p['x'],2),'z':round(p['z'],2)}
        self.require_ft(cmd)
        if cmd=='taxi':
            address=need(args,'address',"the building's address, ba:street_<name>#<number>")
            if not re.fullmatch(r'ba:street_[a-z0-9]+#[0-9]+',address): raise ValueError(f"address takes a building's address as the game writes it, ba:street_<name>#<number>; got '{address}'.")
            if self.dialog!='taxi_map' or not life['taxi']:
                raise ValueError('No taxi is waiting for you: click a taxi in the street first (use list shows the ones near you; use click gets in), then say where to.')
            x,z=self.door(address); d=math.hypot(x-p['x'],z-p['z'])
            fare=round(d*TAXI_PER_METRE,2); minutes=round(d*TAXI_MINUTES_PER_METRE); start=self.seq; money0=self.state['money']
            if self.state['money']<fare:
                self.event("You don't have enough money.",'notice')
                return {'done':False,'address':address,'fare':0.,'minutes':0,'money':self.state['money'],'notices':["You don't have enough money."],'x':p['x'],'z':p['z']}
            self.pay(-int(round(fare*100)),'ba:transaction_taxiride')
            self.dialog='closed'; life['taxi']=False
            self.skip(minutes)
            p.update(x=x,z=z)
            self.event(f'Test bridge: taxi to {address}: riding.')
            return {'done':True,'address':address,'fare':round(money0-self.state['money'],2),'minutes':minutes,'money':round(self.state['money'],2),
                    'notices':[e['text'] for e in self.ring if e['seq']>start and e['kind']=='notice'],'x':round(x,2),'z':round(z,2)}
        if cmd=='phone':
            app=need(args,'app','an app')
            apps=('persona','contacts','employees','bizman','econoview','market','rivals')
            if app not in apps: raise ValueError(f"No phone app '{app}': {', '.join(apps)}.")
            self.dialog='phone_app'; life['app']=app
            return {'app':app,'open':True,'notices':[]}
        if cmd=='call':
            contacts=self.contacts()
            if args.get('op')=='list': return {'contacts':contacts}
            wanted=need(args,'contact',"a contact's id or name (call list shows them)")
            match=[c for c in contacts if c['id']==wanted] or [c for c in contacts if c['name'].casefold()==wanted.casefold()]
            if not match: raise ValueError(f"No contact '{wanted}' in your phone (call list shows them).")
            if self.dialog in ('city','agency','agency_form','phone','order','confirm','items'): raise ValueError("You're in a call or a conversation already: finish it first (its own buttons, or ui escape).")
            contact=match[0]
            life['contact']=contact['id']; life['city_step']='start'
            if contact['id']=='the_city_of_new_york': self.dialog='city'
            elif contact['id'].startswith('foodtrucks_commissary_'): self.dialog='phone'
            else: self.agency_open()
            return {'contact':contact['id'],'name':contact['name'],'calling':True,'open':['phone','call'],'notices':[]}
        if cmd=='eat':
            hands=life['hands']
            if not hands: raise ValueError('Your hands are empty: food you buy comes in a bag to eat from.')
            if hands['key']!='ba:itemname_paperbag': raise ValueError(f"You're holding {hands['item']}, not a bag: only food in a paper bag is eaten from the hands.")
            foods=[c for c in hands['contents'] if c['food'] and c['paid'] and c['amount']>0]
            item=args.get('item')
            food=next((c for c in foods if item is None or item in (c['key'],c['item'])),None)
            if food is None: raise ValueError('Nothing in the bag can be eaten (unpaid, sealed or not food).' if not foods else f"No '{item}' in the bag: {', '.join(c['item'] for c in foods)}.")
            needs=p['needs']
            if round(needs['hunger'])>=100:
                self.event("You're too stuffed to eat this.",'notice')
                return {'item':food['item'],'done':False,'hunger':needs['hunger'],'energy':needs['energy'],'notices':["You're too stuffed to eat this."]}
            needs['hunger']=min(100.,needs['hunger']+food['saturation'])
            food['amount']-=1
            hands['contents']=[c for c in hands['contents'] if c['amount']>0]
            if not hands['contents']: life['hands']=None
            self.event(f"Test bridge: ate {food['key']}.")
            return {'item':food['item'],'done':True,'hunger':round(needs['hunger'],1),'energy':round(needs['energy'],1),'notices':[]}
        if cmd=='place': return self.place_furniture(args)

