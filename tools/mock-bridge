def minute(text):
    try:
        hour, mins = map(int, text.split(':'))
        if not 0 <= hour <= 23 or not 0 <= mins <= 59:
            raise ValueError()
        return hour * 60 + mins
    except (ValueError, AttributeError):
        raise ValueError('run_until.time must be "HH:MM".')


WEEK = ('monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday')


def week_route(open_minute, close_minute, x, z):
    """A one-stop route on every weekday, in the shape the bridge's state gives (`route`): today's stop count and next
    stop, the week plan Monday first (stops, route day in minutes from that day's midnight, gaps), the crew's shifts, and
    the route problem. The mock has no commissary, so the route day is the stop's own hours and nobody has shifts."""
    clock = lambda m: f'{(m % 1440) // 60:02d}:{m % 60:02d}'
    days = [{'day': d, 'closed': False, 'stops': [{'open': clock(open_minute), 'close': clock(close_minute), 'x': x, 'z': z}],
             'route_day': {'start': open_minute, 'end': close_minute}, 'gaps': []} for d in WEEK]
    return {'stops': 1, 'next': f'stop 1, {clock(open_minute)} to {clock(close_minute)} at x {x}, z {z}', 'week': days, 'shifts': [], 'problem': None}


def week_days(days):
    # "Monday to Friday", "Saturday and Sunday", "Monday, Wednesday and Friday" (Core RouteCause.Days).
    order=sorted(set(days),key=WEEK.index)
    parts=[]; i=0
    while i<len(order):
        j=i
        while j+1<len(order) and WEEK.index(order[j+1])==WEEK.index(order[j])+1: j+=1
        name=lambda d: LOCALE['foodtrucks:weekday_'+d]
        if j-i>=2: parts.append(LOCALE['foodtrucks:days_range'].format(first=name(order[i]),last=name(order[j])))
        else: parts.extend(name(d) for d in order[i:j+1])
        i=j+1
    return parts[0] if len(parts)==1 else LOCALE['foodtrucks:days_and'].format(list=', '.join(parts[:-1]),last=parts[-1])


def need(args, key, what):
    value = args.get(key)
    if value is None or isinstance(value, (dict, list)):
        raise ValueError(f'Missing "{key}": {what}.')
    return str(value)


def num(args, key):
    value = args.get(key)
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else None


def clean(text):
    return re.sub(r'\s+', ' ', re.sub(r'<[^>]+>', '', text)).strip()


def png(path, width, height, colour):
    def chunk(kind, data):
        return struct.pack('!I', len(data)) + kind + data + struct.pack('!I', zlib.crc32(kind + data) & 0xffffffff)
    pixels = b''.join(b'\0' + bytes(colour) * width for _ in range(height))
    Path(path).write_bytes(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('!IIBBBBB', width, height, 8, 2, 0, 0, 0)) + chunk(b'IDAT', zlib.compress(pixels)) + chunk(b'IEND', b''))


