        else:
            try: line['set_price']=round(float(text),2)
            except ValueError: return {'item':line['key'],'name':line['item'],'price':line.get('set_price'),'done':False,'notices':["That isn't a price."],'state':v}
        return {'item':line['key'],'name':line['item'],'price':line.get('set_price'),'done':True,'notices':[],'state':v}

    def route_command(self, args):
        op=need(args,'op','add_stop or paste_day')
        v=self.vehicle(need(args,'vehicle',"the food vehicle's id"))
        if not self.mod_loaded: raise ValueError("The mod's save data isn't loaded.")
        if not self.can_write: raise ValueError("The mod's save data is read-only.")
        def days(value, key, single=False):
            if not single and (value is None or value=='all'): return list(WEEK)
            names=[value] if isinstance(value,str) else value if isinstance(value,list) else []
            if not names or (single and len(names)!=1):
                raise ValueError(f'"{key}" is one weekday, monday to sunday.' if single else f'"{key}" is "all" or a list of weekdays, monday to sunday.')
            out=[]
            for name in names:
                if not isinstance(name,str) or name.lower() not in WEEK: raise ValueError(f"Unknown day '{name}': monday to sunday.")
                if name.lower() not in out: out.append(name.lower())
            return out
        stops=self.plans.setdefault(v['id'],[])
        start=self.seq
        if op=='add_stop':
            address=need(args,'address',"a building's address, ba:street_<name>#<number>")
            if not re.fullmatch(r'ba:street_[a-z0-9]+#[0-9]+',address):
                raise ValueError(f'"address" is a building\'s address as the game writes it, ba:street_<name>#<number>; got \'{address}\'.')
            chosen=days(args.get('days'),'days')
            def clock(key):
                text=args.get(key)
                if text is None: return None
                try: return minute(str(text))
                except ValueError: raise ValueError(f'"{key}" must be "HH:MM".')
            open_at,close_at=clock('open'),clock('close')
            if (open_at is None)!=(close_at is None): raise ValueError('Give both "open" and "close", or neither for the default hours.')
            if open_at is not None and close_at<=open_at: close_at+=1440
            building=next((b for b in CITY if b['key']==address),None)
            if building is None: raise ValueError(f'no building at {address} in this city')
            # The mock's spot: 6 m out from the building's centre on the street, the hatch to the pavement.
            x,z=round(building['x']+6.,2),round(building['z'],2)
            added=[]
            for day in chosen:
                taken=sorted((s['open'],s['close']) for s in stops if s['day']==day)
                if open_at is not None:
                    o,c=open_at,close_at
                else:
                    # RouteStops.AddWithDefaultTimes: from 11:00 or the first free time after it, for up to three hours.
                    o=660
                    for a,b in taken:
                        if a<=o<b: o=b
                    nxt=min((a for a,b in taken if a>=o),default=27*60)
                    c=min(o+180,nxt)
                ok=c>o and not any(a<c and o<b for a,b in taken) and len(taken)<TUNING['fleet'].get('maxStops',6)
                if ok:
                    stops.append({'day':day,'address':address,'x':x,'z':z,'open':o,'close':c})
                    self.event(f"Route: stop {address} at x {x:.1f}, z {z:.1f} {o//60:02d}:{o%60:02d}-{(c%1440)//60:02d}:{c%60:02d} added to {v['kind']} {v['id']} on {day.title()}; {len(taken)+1} stops that day.")
                else:
                    self.event(LOCALE['foodtrucks:notification_route_overlap'],'notice')
                added.append({'day':day,'added':ok,'stops':sum(1 for s in stops if s['day']==day)})
            v['route']=self.plan_route(v)
            self.event(f"Test bridge: route add_stop {v['id']} by {address} at x {x:.1f}, z {z:.1f}: {sum(a['added'] for a in added)} of {len(added)} days.")
            notices=[e['text'][8:] for e in self.ring if e['seq']>start and e['kind']=='notice']
            return {'done':all(a['added'] for a in added),'address':address,'x':x,'z':z,'heading':90.0,'distance':6.0,'days':added,
                    'notices':notices,'state':next(x for x in self.read_state()['vehicles'] if x['id']==v['id'])}
        if op=='paste_day':
            source=days(args.get('from'),'from',single=True)[0]
            targets=days(args.get('to'),'to')
            copy_stops=[dict(s) for s in stops if s['day']==source]
            for day in targets:
                if day==source: continue
                stops[:]=[s for s in stops if s['day']!=day]+[{**s,'day':day} for s in copy_stops]
            v['route']=self.plan_route(v)
            self.event(f"Test bridge: route paste_day {v['id']}: {source} onto {', '.join(targets)}: None.")
            return {'done':True,'problem':None,'notices':[],'state':next(x for x in self.read_state()['vehicles'] if x['id']==v['id'])}
        raise ValueError(f"Unknown route op '{op}': add_stop, paste_day.")

    def plan_route(self, v, shifts=None):
        # The bridge's route shape from the mock's stops: each day's route runs from the restock in the commissary bay an
        # hour before the first stop to the drive back half an hour after the last.
        stops=self.plans.get(v['id'],[])
        clock=lambda m: f'{(m % 1440) // 60:02d}:{m % 60:02d}'
        week=[]
        for d in WEEK:
            day=sorted((s for s in stops if s['day']==d),key=lambda s:s['open'])
            route_day={'start':day[0]['open']-60,'end':day[-1]['close']+30} if day else None
            week.append({'day':d,'closed':False,'stops':[{'open':clock(s['open']),'close':clock(s['close']),'x':s['x'],'z':s['z']} for s in day],
                         'route_day':route_day,'gaps':[]})
        today=WEEK[(self.state['clock']['day']-1)%7]
        todays=[s for s in sorted(stops,key=lambda s:s['open']) if s['day']==today]
        old=v.get('route') or {}
        return {'stops':len(todays),'next':(f"stop 1, {clock(todays[0]['open'])} to {clock(todays[0]['close'])} at x {todays[0]['x']}, z {todays[0]['z']}" if todays else None),
                'week':week,'shifts':shifts if shifts is not None else old.get('shifts',[]),'problem':None}

    def route_todos(self, v):
        # The route to-do with its cause, as the game side's VehicleTodos and Core RouteCause word it: here only whole
        # route days with nobody of the crew on shift.
        if not self.plans.get(v['id']) or not v['crew'] or not v['route']: return []
        shifts={x['day'] for e in v['route'].get('shifts',[]) if e['employee'] in v['crew'] for x in e['shifts']}
        bare=[d['day'] for d in v['route']['week'] if d['stops'] and d['day'] not in shifts]
        if not bare: return []
        text=LOCALE['foodtrucks:todo_route_problem'].format(cause=LOCALE['foodtrucks:route_cause_nobody'].format(days=week_days(bare)))
        return [{'kind':'route_problem','item':None,'text':text}]

    def plan_hour(self, day, m):
        # The planned vehicles at minute m of `day`: the morning restock in the bay, opening and closing at each stop, the
        # drive back; crew wages for every shift hour, worked or idle (Core CrewPay); sales one unit every ten minutes.
        weekday=WEEK[(day-1)%7]
        for v in self.state['vehicles']:
            stops=sorted((s for s in self.plans.get(v['id'],[]) if s['day']==weekday),key=lambda s:s['open'])
            shifts=[x for e in (v['route'] or {}).get('shifts',[]) for x in e['shifts'] if x['day']==weekday]
            if not stops or not v['crew'] or not shifts or self.state['player']['in_vehicle']==v['id']: continue
            on=any(x['start']*60<=m<x['end']*60 for x in shifts)
            site=next((s['site'] for s in self.state['commissary']['spaces'] if s['vehicle']==v['id']),None)
            if m==stops[0]['open']-60 and on and site and (v['commissary'] or {}).get('in_bay'):
                self.crew_restock(v,site)
            for i,stop in enumerate(stops):
                if m==stop['open'] and on and not v['open'] and any(s['amount']>0 for s in v['stock']) and v['pieces']:
                    v.update(x=stop['x'],z=stop['z'],legal=True,commissary={'site':site,'in_bay':False,'bay_site':None} if site else None)
                    self.event(f"Route: {v['kind']} {v['id']} arrived at stop {i+1}: legal parking, 0 m from the stop.")
                    v.update(open=True,serving='crew',queue={'length':0,'places':[]})
                    self.event(f"{v['kind'].title()} {v['id']} open by its crew at stop {i+1}; {min(len(v['crew']),STAFF[v['kind']])} serving.")
                if m==stop['close'] and v['open']:
                    v.update(open=False,serving='nobody',queue=None)
                    self.event(f"{v['kind'].title()} {v['id']} closed by its crew at stop {i+1}.")
                if v['open'] and stop['open']<=m<stop['close']:
                    visits=self.visits.setdefault(v['id'],{}).setdefault(str(day),{})
                    visits[str(i)]=visits.get(str(i),0)+1
            if m==stops[-1]['close']+30 and site:
                self.place_vehicle(v,site)
                self.event(f"Route: {v['kind']} {v['id']} back in the bay at {site}.")

    def crew_restock(self, v, site):
        # Core CrewRestock: food only, into the room each piece has, from the commissary's stock.
        loaded=[]
        for stock in self.state['commissary']['stock']:
            if stock['site']!=site or stock['key'] not in HOLDS or stock['amount']<=0: continue
            pool=next((p for p in v['pieces'] if p['item']==HOLDS[stock['key']]),None)
            if not pool: continue
            amount=min(stock['amount'],max(0,int(pool['cap']-pool['units'])))
            if amount<=0: continue
            pool['units']+=amount; stock['amount']-=amount
            cargo=next((s for s in v['stock'] if s['key']==stock['key']),None)
            if cargo: cargo['amount']+=amount
            else: v['stock'].append({'item':stock['item'],'key':stock['key'],'amount':amount})
            loaded.append(f"{amount} {stock['item']}")
        self.event(f"Crew restock: {v['kind']} {v['id']} at {site}: {', '.join(loaded) or 'nothing to load'}.")

    def pay_wages(self, day):
        # At midnight the game pays each hire for yesterday's shift hours, booked into yesterday as unassigned staff wages.
        weekday=WEEK[(day-1)%7]
        for v in self.state['vehicles']:
            if not self.plans.get(v['id']): continue
            for entry in (v['route'] or {}).get('shifts',[]):
                hours=sum(x['end']-x['start'] for x in entry['shifts'] if x['day']==weekday)
                if hours<=0 or entry['employee'] not in v['crew']: continue
                cents=hours*WAGE_CENTS
                self.pay(-cents,'ba:transaction_unassignedwage',day=day,employee=entry['employee'],businessName='Unassigned')
                self.book(day,v['id'],'wages',cents)
                self.event(f"Wage: {entry['employee']} ({v['id']}), day {day}: {hours} h, ${cents/100:.2f}.",day=day)

    def charge_rent(self, day):
        for space in self.state['commissary']['spaces']:
            v=next((x for x in self.state['vehicles'] if x['id']==space['vehicle']),None)
            if v is None: continue
            cents=int(TUNING['commissary']['rentPerMonthCents'][v['kind']]*12/365+.5)
            if self.state['money']*100>=cents:
                self.pay(-cents,'foodtrucks:transaction_commissary_rent',commissary=LOCALE['foodtrucks:commissary_'+space['site']])
                self.book(day,v['id'],'commissary_rent',cents)
            else: self.state['commissary']['unpaid']['rent']+=cents/100

    # Marketing (Core MarketingFees): a new day charges the day's fee for the booked level once its start day has come; a
    # refused fee turns it off. marketing_today follows the day: the paid level on a paid day, else none.
    def charge_marketing(self, day):
        levels={l['id']:l for l in TUNING['marketing']['levels']}
        for v in self.state['vehicles']:
            level=levels.get(v.get('marketing_level'))
            if not (level is None or level['id']=='none' or v['kind'] not in level['costPerDayCents'] or (v.get('marketing_paid_through_day') or 0)>=day
                    or (v.get('marketing_starts_day') or 0)>day):
                cents=level['costPerDayCents'][v['kind']]
                # A level priced at 0 runs without a payment, as Core's Renew.
                if cents<=0: v.update(marketing_paid_through_day=day,marketing_starts_day=None); self.marketing_paid[v['id']]=level['id']
                elif self.state['money']*100>=cents:
                    self.pay(-cents,'foodtrucks:transaction_marketing',vehicle=v['name'])
                    self.book(day,v['id'],'marketing',cents)
                    v.update(marketing_paid_through_day=day,marketing_starts_day=None); self.marketing_paid[v['id']]=level['id']
                else:
                    v.update(marketing_level=None,marketing_starts_day=None)
                    self.event(LOCALE['foodtrucks:notification_marketing_stopped'].format(vehicle=v['name'],fee=f'${cents/100:,.2f}'),'notice')
            v['marketing_today']=self.marketing_paid.get(v['id']) if v.get('marketing_paid_through_day')==day else None

    def marketing_command(self, args):
        v=self.vehicle(need(args,'vehicle',"the food vehicle's id"))
        if not self.mod_loaded: raise ValueError("The mod's save data isn't loaded.")
        if not self.can_write: raise ValueError("The mod's save data is read-only.")
        offered=[l for l in TUNING['marketing']['levels'] if l['id']=='none' or v['kind'] in l['costPerDayCents']]
        ids=', '.join(l['id'] for l in offered)
        wanted=need(args,'level','a marketing level: '+ids)
        level=next((l for l in offered if l['id']==wanted),None)
        if level is None: raise ValueError(f"no marketing level '{wanted}' for a {v['kind']}; levels: {ids}")
        day=self.state['clock']['day']
        start=self.seq
        # Booked from the next day (Core's Choose): nothing is charged now and today keeps what it paid for.
        if level['id']=='none': v.update(marketing_level=None,marketing_starts_day=None)
        else: v.update(marketing_level=level['id'],marketing_starts_day=day+1)
        notices=[e['text'][8:] for e in self.ring if e['seq']>start and e['kind']=='notice']
        return {'vehicle':v['id'],'level':v['marketing_level'] or 'none','done':True,'notices':notices,'state':v}

    def operation(self, cmd, args, expect_session=None):
        def refusal():
            if self.stopped: return {'ok':False,'session':self.session,'error':'the bridge stopped'}
            if expect_session is not None and expect_session != self.session:
                return {'ok':False,'session':self.session,'error':f'the bridge restarted (session {self.session}); reconnect first.'}
        with self.ops_lock:
            refused=refusal()
            if refused: return refused
        if self.stopped: return {'ok':False,'session':self.session,'error':'the bridge stopped'}
        if cmd=='op':
            identifier=num(args,'id')
            if identifier is None: return {'ok':False,'session':self.session,'error':'op needs "id": the number a /call reply gave as "op".'}
            with self.ops_lock:
                refused=refusal()
                if refused: return refused
                op=self.operations.get(int(identifier))
                if op is None: return {'ok':False,'session':self.session,'error':f'No operation {identifier:g} (the bridge keeps the last 500).'}
                return {'ok':True,'session':self.session,'result':copy.deepcopy(op)}
        with self.ops_lock:
            refused=refusal()
            if refused: return refused
            identifier=self.next_op
            self.next_op+=1
            session=self.session
            op={'id':identifier,'cmd':cmd,'status':'pending','session':session}
            self.operations[identifier]=op
            finished=threading.Event()
            files=[]
            self.operation_waiters[identifier]=(op,finished,files)
            lifecycle=self.lifecycle
        def work():
            try:
                with self.call_gate:
                    with self.lock:
                        if self.stopped or lifecycle!=self.lifecycle: raise ValueError('the bridge stopped')
                        result=copy.deepcopy(self.call(cmd,args))
                        if cmd=='shoot': files.append(Path(result['path']))
                # Deferred work lets the main thread and health/events keep running.
                delay=self.operation_delays.get(cmd,.12 if cmd=='shoot' else 0)
                if delay: finished.wait(delay)
                with self.ops_lock:
                    if op['status']=='pending': op.update(status='done',result=result)
            except Exception as exc:
                with self.ops_lock:
                    if op['status']=='pending': op.update(status='failed',error=str(exc))
            finally:
                with self.ops_lock:
                    self.operation_waiters.pop(identifier,None)
                    if self.operations.get(identifier) is op:
                        self.operations.pop(identifier)
                        self.operations[identifier]=op  # retention follows completion, not admission
                    completed=[key for key, item in self.operations.items() if item['status']!='pending']
                    for key in completed[:-500]: del self.operations[key]
                finished.set()
        threading.Thread(target=work,daemon=True).start()
        if not finished.wait(min(600,max(1,num(args,'timeout_s') if num(args,'timeout_s') is not None else 10))):
            return {'ok':False,'session':session,'op':identifier,'error':f'timed out on the main thread; the command goes on: ask {{"cmd": "op", "args": {{"id": {identifier}}}}} for its outcome'}
        with self.ops_lock:
            return {'ok':op['status']=='done','session':session,'op':identifier, **({'result':copy.deepcopy(op['result'])} if op['status']=='done' else {'error':op['error']})}

    def unload(self):
        with self.lock:
            with self.ops_lock:
                self.stopped=True
                self.lifecycle+=1
                for op,waiter,files in self.operation_waiters.values():
                    if op['status']=='pending':
                        op.update(status='failed',error='the bridge stopped')
                        for path in files: path.unlink(missing_ok=True)
                    waiter.set()
                self.operations.clear()
                self.operation_waiters.clear()
            self.ring.clear()
            self.seq=0
            self.last_ui=[]
            self.pending=[]
            self.walks=[]
            self.activity_starting=False
            self.load=None
            if self.until is not None: self.state['clock']['speed']=1
            self.until=None
            self.state['clock'].update(run_until=None,arrived_at=None)
            self.pause_menu_open=False
            self.confirmation_open=False

    def start_bridge(self):
        with self.lock:
            with self.ops_lock:
                self.session=uuid.uuid4().hex
                self.stopped=False

    def serving(self, v):
        player=self.state['player']
        if not v['open'] or player['in_vehicle']==v['id']: return 'nobody'
        if v['kind']=='truck' and player['at_hatch']==v['id']: return 'player'
        if v['kind']=='cart' and self.work and self.work['vehicle']==v['id'] and ((player['x']-v['x'])**2+(player['y']-v['y'])**2+(player['z']-v['z'])**2)**.5<=8: return 'player'
        return 'crew' if v['crew'] else 'nobody'

    def read_state(self):
        if self.state['scene'] == 'city':
            result=copy.deepcopy(self.state)
            result['load']=copy.deepcopy(self.load)
            result['transactions_today']=[t for t in result['transactions_today'] if t['day'] >= result['clock']['day']-1]
            assigned={name for v in result['vehicles'] for name in v['crew']}
            result['employees']=[{k:e[k] for k in ('id','name','skill','satisfaction','wage')} for e in self.employees if e['name'] not in assigned]
            player=result['player']
            player['activity']='driving' if player['in_vehicle'] and self.vehicle(player['in_vehicle'])['kind']=='truck' else 'pushing' if player['in_vehicle'] else 'starting' if self.activity_starting else 'at_hatch' if player['at_hatch'] else 'walking' if self.walks else 'on_foot'
            player['work']=copy.deepcopy(self.work)
            player['clock_held_by']=self.clock_held_by()
            player.update(hands=copy.deepcopy(self.life['hands']),inside=self.life['inside'],homes=list(self.life['homes']),riding=False)
            pushing=next((t for t in self.life['handtrucks'] if t['id']==player['in_vehicle']),None)
            player['handtruck']=self.handtruck_entry(pushing) if pushing else None
            needs=player['needs']
            needs['warnings']=[w for w in (('very_hungry' if needs['hunger']<=5 else 'hungry' if needs['hunger']<=25 else None),
                                            ('out_of_energy' if needs['energy']<=0 else 'exhausted' if needs['energy']<=5 else 'tired' if needs['energy']<=25 else None)) if w]
            # The mock's game camera hangs over the player; nothing is faded for it.
            result['game_camera']={'x':round(player['x'],2),'y':round(player['y']+18,2),'z':round(player['z']-12,2),'yaw':0.,'pitch':55.}
            result['view_blocked']=[]
            result['commissary']['bays']=self.bays()
            result['clock']['speed']=round(result['clock']['speed'],2)
            result['money']=round(result['money'],2)
            for order in result['commissary']['orders']:
                for key in ('goods','fee'): order.pop(key,None)
            for v in result['vehicles']:
                v['serving']=self.serving(v)
                v['todos']=v['todos']+self.route_todos(v)
                if v['kind']=='cart' and not v['open']: v['hatch_side']=None
            for position in [result['player'],*result['vehicles']]:
                for key in ('x','y','z','heading'):
                    if position[key] is not None: position[key]=round(position[key],2)
            if not self.mod_loaded: result.update(licence=None,vehicles=[],commissary=None,ledger_today=None,employees=[])
            return result
        return {'save': self.state['save'], 'scene':self.state['scene'], 'vehicles':[],
                'notices_recent':self.state['notices_recent'], 'load':copy.deepcopy(self.load), 'transactions_today':[], 'employees':[],
                'view_blocked':[], **{key:None for key in ('clock','money','player','licence','commissary','ledger_today','game_camera')}}

    def health(self):
        c = self.state['clock'] if self.state['scene'] == 'city' else {}
        if self.stopped:
            return dict(ok=True,session=self.session,mod_version='0.9.10',bridge_version=1,scene='menu',save=None,day=None,time=None,paused=None,time_skip=None,frame=0,load=None)
        return dict(ok=True, session=self.session, mod_version='0.9.10', bridge_version=1, scene=self.state['scene'],
                    save=self.state['save'], day=c.get('day'), time=c.get('time'), paused=c.get('paused'), time_skip=self.time_skip if self.state['scene']=='city' else None,
                    frame=self.frame, load=None if self.load is None else {k:self.load[k] for k in ('name','status')})

    def events(self, since):
        since = max(since, 1)
        oldest = self.ring[0]['seq'] if self.ring else self.seq + 1
        return {'ok': True, 'session':self.session, 'next': self.seq + 1, 'dropped': max(0, oldest - since),
                'events': [event for event in self.ring if event['seq'] >= since]}

    def vehicle(self, identifier=None):
        identifier = identifier or self.state['player']['in_vehicle'] or self.selected
        found = next((v for v in self.state['vehicles']+self.life['handtrucks'] if v['id'] == identifier), None)
        if found is None:
            ids = ', '.join(v['id'] for v in self.state['vehicles']) or 'none'
            raise ValueError(f"No food cart or truck with id '{identifier}'. Food vehicles: {ids}.")
        return found

    def spawn(self, kind, announce=True):
        identifier = f'{kind}-{len(self.state["vehicles"])+1}'
        v = dict(id=identifier,kind=kind,name='Food '+kind,x=0.,y=0.,z=0.,heading=0.,legal=True,
                 legal_reason='wheel parking test: legal, mock wheels' if kind=='truck' else 'pavement rule: legal; nearest entrance 10.0 m',hatch_side='right' if kind=='truck' else None,
                 hatch_to_pavement=True if kind=='truck' else None, open=False,serving='nobody',crew=[],pieces=[],stock=[],
                 queue=None,commissary=None,route=None,parking={'state':'Legal','neighbourhood':'ba:neighborhood_hellskitchen','hourly_price':5.0,'unpaid':0.},
                 todos=[],marketing_level=None,marketing_starts_day=None,marketing_paid_through_day=None,marketing_today=None)
        self.state['vehicles'].append(v)
        self.selected = identifier
        self.event(f'Spawned foodtrucks:vehicletype_food{kind}: id {identifier}, controller mock.')
        if announce: self.event(f'Spawned Food {kind}.', 'notice')
        return v

    def place_vehicle(self, v, site):
        index = SITES.index(site)
        v.update(x=393.2+index*100,y=0.,z=217.6,heading=0.,legal=v['kind']=='truck',legal_reason='wheel parking test: legal, mock wheels' if v['kind']=='truck' else 'pavement rule: inside a parking lane')
        space = next((s['site'] for s in self.state['commissary']['spaces'] if s['vehicle']==v['id']), None)
        v['commissary'] = {'site':space,'in_bay':True,'bay_site':site}

    def add_order(self, site, boxes, emit=True, item='ba:itemname_hotdog'):
        self.order_number += 1
        name,box,price=CATALOG[item]
        units=boxes*box
        goods=round(units*price,2)
        # The fee is set on delivery (one per commissary and morning); a waiting order carries none.
        order = {'n':self.order_number, 'site':site, 'items':f'{units} {name}',
                 'item':item,'units':units,'goods':goods,'fee':0.0,'total':goods,
                 'due_day':self.state['clock']['day']+1}
        self.state['commissary']['orders'].append(order)
        if emit:
            self.event(f"Commissary order {order['n']}: {boxes} boxes, {units} {name} at {site} for ${goods:.2f}, paid on delivery; due day {order['due_day']} at 08:00.")
            self.event(LOCALE['foodtrucks:message_commissary_ordered'].format(units=units,item=name,total=f"${goods:.2f}",time='08:00'), 'phone')
        return order

    def deliver(self, force=False):
        c = self.state['clock']
        for order in list(self.state['commissary']['orders']):
            if not force and (order['due_day'] > c['day'] or c['time'] < '08:00'):
                continue
            self.state['commissary']['orders'].remove(order)
            units=order['units']
            name=CATALOG[order['item']][0]
            delivery=(order['site'],order['due_day'])
            goods=order['goods']; fee=0.0 if delivery in self.fees_paid else TUNING['commissary']['deliveryFeeCents']/100
            order['fee']=fee; order['total']=round(goods+fee,2)
            if self.state['money'] < order['total']:
                self.event(f"Commissary delivery: order {order['n']}, {units} {name} not delivered: the payment of ${order['total']:.2f} was refused (not enough money); the order is cancelled.")
                self.event(f"We couldn't deliver {units} {name}: the payment of ${order['total']:.2f} didn't go through. The order is cancelled; order again when you have the money.", 'phone')
            else:
                if fee: self.book_fee(c['day'],int(round(fee*100)))
                self.fees_paid.add(delivery)
                self.pay(-int(round(order['total']*100)),'foodtrucks:transaction_commissary_order', commissary=LOCALE['foodtrucks:commissary_'+order['site']])
                stock = next((s for s in self.state['commissary']['stock'] if s['site'] == order['site'] and s['key'] == order['item']), None)
                if stock:
                    stock['amount'] += units
                else:
                    self.state['commissary']['stock'].append({'site': order['site'], 'item': name, 'key':order['item'], 'amount': units})
                self.event(f"Commissary delivery: order {order['n']}, {units} {name} at {order['site']} (ordered day {order['due_day']-1}, due day {order['due_day']}), paid ${order['total']:.2f} on delivery (goods ${goods:.2f}, fee ${fee:.2f}).")
                self.event(LOCALE['foodtrucks:message_commissary_delivered_fee' if fee else 'foodtrucks:message_commissary_delivered'].format(units=units,item=name,commissary=LOCALE['foodtrucks:commissary_'+order['site']],total=f"${order['total']:.2f}",fee=f"${fee:.2f}"),'phone')

    def book_fee(self, day, cents):
        entry=self.ledger.setdefault(str(day),{'vehicles':{},'delivery_fees':0,'revenue':0,'stock_cost':0})
        entry['delivery_fees']+=cents

    def flush_hour(self, day, hour):
        for v in self.state['vehicles']:
            count = self.hours.pop(v['id'], 0)
            if count:
                self.event(f"Crew sales: {v['id']}, day {day} {hour:02d}:00 hour: {count} customers, {count} items, ${count*13:.2f}, paid in after midnight; {sum(s['amount'] for s in v['stock'])} units left.", day=day)

    def settle_takings(self, all=False):
        # Player and crew share one saved pot per vehicle/day. Removed vehicles refund today's pot too.
        owned = {v['id']: v for v in self.state['vehicles']}
        today = self.state['clock']['day']
        for (vid, day), total in sorted(list(self.takings.items()), key=lambda e: (e[0][1], e[0][0])):
            if not all and vid in owned and day >= today: continue
            name = owned[vid]['name'] if vid in owned else vid
            self.pay(total*SALE_CENTS, 'foodtrucks:transaction_crew_sales', day=day, vehicle=name, sales=total)
            self.takings.pop((vid, day))
            self.event(f"Street food sales paid in: {name} ({vid}), day {day}: {total} items, ${total*SALE_CENTS/100:.2f}.", day=day)
        waiting = sum(self.takings.values())*SALE_CENTS/100
        self.state['ledger_today']['sales_waiting'] = waiting
        self.state['ledger_today']['crew_waiting'] = waiting

    def spend_needs(self):
        # The game's average burn (0.056 energy a minute, 1.5 hunger per energy); the bridge tops both up below 40 while
        # keep_needs is on, as the game side does through the game's needs API.
        needs=self.state['player']['needs']
        needs['energy']=max(needs['collapse_at'],round(needs['energy']-.056,3))
        needs['hunger']=max(0.,round(needs['hunger']-.084,3))
        if self.state['clock']['keep_needs']:
            # Only for an FT save of a character with FT saves only, as the bridge checks every frame (review round 6).
            why=None
            if not (self.state['save'] or '').startswith('FT'): why=f"the save is now '{self.state['save']}', which doesn't start with FT"
            else:
                try: self.require_character()
                except ValueError: why='the save\'s character now also has a save not starting with FT'
            if why:
                self.state['clock']['keep_needs']=False
                self.event(f'Test bridge: needs top-ups stopped: {why}.')
        needs['kept_up']=self.state['clock']['keep_needs']
        if self.state['clock']['keep_needs'] and (needs['energy']<40 or needs['hunger']<40):
            energy,hunger=needs['energy'],needs['hunger']
            needs.update(energy=100.,hunger=100.)
            c=self.state['clock']
            self.event(f"Test bridge: needs topped up while the clock runs (energy {energy:.1f} to 100.0, hunger {hunger:.1f} to 100.0), day {c['day']} {c['time']}.")

    def tick(self):
        before = self.absolute
        self.absolute += 1
        c = self.state['clock']
        day = self.absolute // 1440 + 1
        m = self.absolute % 1440
        c.update(day=day, time=f'{m//60:02d}:{m%60:02d}', weekday=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'][(day-1)%7])
        self.spend_needs()
        if m % 60 == 0:
            self.flush_hour(before // 1440 + 1, (before % 1440) // 60)
            self.life_hour()
        if m == 0:
            for v in self.state['vehicles']:
                if v['crew'] and (v['route'] or {}).get('stops',0):
                    self.event(f"Route: truck {v['id']} caught up to minute {self.absolute} for the day's close.")
            self.settle_takings()
            self.pay_wages(day-1)
            self.charge_rent(day)
            self.charge_marketing(day)
            for vid in list(self.sold):
                self.sold[vid]={k:n for k,n in self.sold[vid].items() if int(k)>=day-1}
            self.state['ledger_today'] = {'street_food': 0., 'sales_waiting': 0., 'crew_waiting': 0.}
            self.event(f'Day summary: day {day-1}.')
        if m == 480:
            self.deliver()
        self.plan_hour(day, m)
        for v in self.state['vehicles']:
            route = self.routes.get(v['id'])
            if route and v['crew'] and self.state['player']['in_vehicle'] != v['id']:
                active = route[0] <= m < route[1] if route[1] > route[0] else m >= route[0] or m < route[1]
                if active and not v['open']:
                    self.event(f"Route: truck {v['id']} leaves for stop 1, arriving about {c['time']}.")
                    self.event(f"Route: truck {v['id']} arrived at stop 1: legal parking, 0 m from the stop.")
                    v.update(open=True, serving='crew', queue={'length':0,'places':[]})
                    self.event(f"Truck {v['id']} open by its crew at stop 1; 1 serving.")
                elif not active and v['open']:
                    v.update(open=False, serving='nobody', queue=None)
                    self.event(f"Truck {v['id']}: closing notice not shown (the crew's window, the player away or asleep).")
            if v['open'] and (self.state['licence']['until_day'] or 0)<day:
                v.update(open=False,serving='nobody',queue=None)
            v['serving']=self.serving(v)
            waiting = self.__dict__.get('paused_notice', set())
            if v['id'] in waiting:
                waiting.discard(v['id'])
                if v['open'] and v['serving'] == 'nobody':
                    self.event(LOCALE['foodtrucks:notification_paused_truck'], 'notice')
            if v['open'] and v['serving'] != 'nobody' and m % 10 == 0:
                # The food with the most on board sells (first listed on a tie).
                stock = max((s for s in v['stock'] if s['amount'] > 0), key=lambda s: s['amount'], default=None)
                if stock:
                    stock['amount'] -= 1
                    pool = next((p for p in v['pieces'] if p['item'] == HOLDS.get(stock['key'])), v['pieces'][0] if v['pieces'] else None)
                    if pool: pool['units'] = max(0, pool['units'] - 1)
                    self.state['ledger_today']['street_food'] += SALE_CENTS/100
                    self.book(day, v['id'], 'sales', SALE_CENTS)
                    self.book(day, v['id'], 'stock_cost', int(round(CATALOG.get(stock['key'], ('', 500, 1.5))[2]*100)))
                    sold = self.sold.setdefault(v['id'], {}).setdefault(str(day), {})
                    sold[stock['key']] = sold.get(stock['key'], 0) + 1
                    self.state['ledger_today']['sales_waiting'] += SALE_CENTS/100
                    self.state['ledger_today']['crew_waiting'] += SALE_CENTS/100
                    self.takings[(v['id'], day)] = self.takings.get((v['id'], day), 0) + 1
                    if v['serving'] == 'crew':
                        self.hours[v['id']] = self.hours.get(v['id'], 0) + 1
                    else:
                        self.event(f"Sale: {stock['key']} for ${SALE_CENTS/100:.2f} on day {day}, {stock['amount']} of it left.")
        if self.work:
            worked=self.vehicle(self.work['vehicle'])
            if not any(item['amount']>0 for item in worked['stock']):
                worked.update(open=False,serving='nobody',queue=None)
            if (not worked['open'] or self.state['player']['needs']['energy']<=0 or
                    self.work_goal is not None and self.absolute>=self.work_goal):
                self.state['player']['at_hatch']=None
                self.finish_work()
        self.settle_takings()
        if self.until is not None and self.absolute >= self.until:
            self.until = None
            c.update(paused=True, speed=1, run_until=None, arrived_at=f"day {c['day']} {c['time']}", keep_needs=False)
            self.event(f"Test bridge: run_until {self.until_text} reached at day {c['day']} {c['time']}; paused, speed 1.")

    def run_clock(self):
        previous = time.monotonic()
        credit = 0.
        while not self.stop.wait(.01):
            now = time.monotonic()
            with self.lock:
                if self.stopped:
                    credit=0
                    previous=now
                    continue
                self.frame += 1
                c = self.state['clock']
                for due, action in list(self.pending):
                    if now >= due:
                        self.pending.remove((due,action))
                        action()
                c = self.state['clock']
                for due, action in list(self.walks):
                    if c['paused']:
                        self.walks.remove((due,action))
                        self.walks.append((due+now-previous,action))
                    elif now >= due:
                        self.walks.remove((due,action))
                        action()
                work_skip = self.work_goal is not None and self.time_skip
                if (c['paused'] and not work_skip) or self.state['scene']!='city':
                    credit = 0
                else:
                    credit += (now - previous) * (60 if work_skip else c['speed']) * self.clock_rate
                    while credit >= 1 and (not c['paused'] or self.work_goal is not None):
                        self.tick()
                        credit -= 1
                        if work_skip and not self.time_skip:
                            credit=0
                            break
            previous = now

    def buttons(self):
        entries = []
        def add(text, kind='button', row=''):
            entries.append({'id':len(entries)+1, 'text':clean(text), 'kind':kind,
                            'path':f'Mock/{self.dialog}/{row or len(entries)}'})
        if self.state['player']['in_vehicle'] and not any(t['id']==self.state['player']['in_vehicle'] for t in self.life['handtrucks']) and self.dialog == 'closed':
            add(LOCALE['foodtrucks:itempanel_commissary_stock'])
        if not self.state['player']['in_vehicle'] and not self.state['player']['at_hatch'] and self.dialog == 'closed':
