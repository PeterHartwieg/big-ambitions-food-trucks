        elif self.dialog == 'order':
            add('ADD ITEM')
            add(LOCALE['foodtrucks:dialog_commissary_order_check'])
            add('Hang up')
        elif self.dialog == 'items':
            add(LOCALE['foodtrucks:commissary_form_item'].format(item='Hotdog',box=500,stock=0),'option')
            add('Confirm')
            add('Cancel')
        elif self.dialog == 'confirm':
