    def clock_held_by(self):
        if self.time_skip: return 'time skip'
        screens=[]
        if self.confirmation_open: screens.append('confirmation')
        if self.pause_menu_open: screens.append('pause menu')
        if self.dialog in ('crew','fleet'): screens.append('phone')
        elif self.dialog=='taxi_map': screens.append('map')
        elif self.dialog in ('phone_app','presentation'): screens.append('phone')
        elif self.dialog in LIFE_PANELS or self.dialog in ('purchase','course_choice','handtruck_cargo'): pass
        elif self.dialog not in ('closed','commissary','items','opens','closes'): screens.append('call')
        if self.activity_starting or self.state['player']['at_hatch'] or self.dialog in LIFE_PANELS: screens.append('activity panel')
        if self.dialog=='course_choice': screens.append('confirmation')
        return ', '.join(screens) if screens else None if self.dialog in ('closed','purchase','handtruck_cargo') else 'a screen'

