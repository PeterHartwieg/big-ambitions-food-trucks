        def lit(b):
            out=[]; btype=b.get('buildingType'); business=b.get('businessType')
            if not business and btype not in ('ba:buildingtype_special',None):
                out+=['for_rent','for_rent:'+btype]
            if business: out.append('business:'+business)
            # Core StreetFoodMap over AreaClassifier.RuleFor: a business's rule before its building's (data/demand.json).
            rule=CLASSIFIER['businessTypes'].get(business) if business else None
