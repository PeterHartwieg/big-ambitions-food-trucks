    def save_city(self, name):
        if self.save_in_progress: raise ValueError('A save is already being written; try again in a moment.')
        if self.save_failure=='refused':
            raise ValueError('The game refused to save here (inside the interior designer, placing an item, at school or on the casino boat?).')
        self.save_in_progress=True
        try:
            started=time.time()-2
            self.state['save']=name
            folder=self.shots/'saves'/re.sub(r'[^A-Za-z0-9._ -]','_',self.character)
            path=folder/(re.sub(r'[^A-Za-z0-9._ -]','_',name)+'.hsg')
            self.event(f"Test bridge: saving as '{name}' ({path}).")
            serialization_failed=self.save_failure=='serialization_then_compression'
            try:
                if self.save_failure=='serialization': raise ValueError('mock serialization failure')
                if serialization_failed:
                    self.event('SaveGame serialization failed: mock failure','unity_error')
                    data=b'{"incomplete":'
                else:
                    data=json.dumps(self.state,allow_nan=False).encode()
            except (ValueError,TypeError):
                self.event('Save game serialization failed: mock failure','unity_error')
                raise ValueError("The game's save failed while writing the city (see Player.log: Save game serialization failed).")
            try:
                if self.save_failure=='compression': raise ValueError('mock compression failure')
                packed=zlib.compress(data)
                folder.mkdir(parents=True,exist_ok=True)
                path.write_bytes(packed)
            except (OSError,ValueError,zlib.error):
                raise ValueError('The game\'s save failed while compressing (no "Compressed to" line).')
            if serialization_failed:
                raise ValueError("The game's save failed while writing the city (see Player.log: Save game serialization failed).")
            if not path.is_file(): raise ValueError(f"The save file isn't there: {path}.")
            if path.stat().st_mtime < started: raise ValueError(f"The save file wasn't written by this save: {path}.")
            size=path.stat().st_size
            if size==0: raise ValueError(f'The save file is empty: {path}.')
            self.store(name)
            self.event(f"Test bridge: saved '{name}', {size} bytes.")
            return {'name':name,'path':str(path),'bytes':size}
        finally: self.save_in_progress=False

    def restore(self, name, emit=True):
        if name not in self.saves:
            raise ValueError('No such mock save: use FT mock or save the current city first')
        arrived_at=self.state['clock'].get('arrived_at')
        for key, val in copy.deepcopy(self.saves[name]).items():
            setattr(self, key, val)
        self.until = None
        self.state['clock'].update(run_until=None,arrived_at=arrived_at,keep_needs=False)
        self.state['player'].setdefault('needs',{'energy': 100., 'hunger': 100., 'happiness': 80., 'happiness_modifiers': [], 'max': 100., 'collapse_at': -20., 'energy_off': False, 'going_to_hospital': False, 'kept_up': False})
        self.state['player']['needs']['kept_up']=False
        self.dialog = 'closed'
        self.pending = []
        self.walks = []
        self.state['player']['at_hatch']=None
        self.activity_starting=False
        self.state['notices_recent']=list(self.recent)
        self.state['clock']['paused'] = True
        if emit: self.event(f"Test bridge: loading '{name}' (Mock character, day {self.state['clock']['day']}).")

    def event(self, text, kind='log', day=None, clock=None):
        if self.stopped: return
        if kind=='error' and not text.startswith('ERROR: '): text='ERROR: '+text
        self.seq += 1
        snapshot=self.state['clock'] if self.state['scene']=='city' else {}
        self.ring.append({'seq': self.seq, 'real': datetime.now(timezone.utc).isoformat(timespec='milliseconds').replace('+00:00', 'Z'),
                          'day': day if day is not None else snapshot.get('day'), 'time': clock if clock is not None else snapshot.get('time'),
                          'kind': kind, 'text': ('Notice: '+text if kind=='notice' else 'Phone: '+LOCALE['foodtrucks:commissary_hells-kitchen']+': '+text if kind=='phone' else text)})
        if kind == 'phone': self.phone_texts.append(text)
        if kind == 'notice':
            self.recent.append(text)
            self.state['notices_recent'] = list(self.recent)

