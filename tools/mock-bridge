    def click(self, args):
        if num(args, 'id') is not None:
            identifier = int(args['id'])
            entry = next((b for b in self.last_ui if b['id']==identifier),None)
            if not entry: raise ValueError(f'No entry {identifier} in the last ui list; list again.')
            buttons=self.buttons()
            current=next((b for b in buttons if b['path']==entry['path'] and b['kind']==entry['kind']),None)
            if current is None:
                if entry['kind']=='option' and any(b['kind']=='option' and b['path'].split('/option[')[0]==entry['path'].split('/option[')[0] for b in buttons):
                    raise ValueError(f"the control with id {identifier} now reads ''; list again.")
                raise ValueError(f"Entry {identifier} ({entry['text']}) is no longer on screen; list again.")
            if current['text'] != entry['text']:
                raise ValueError(f"the control with id {identifier} now reads '{current['text']}'; list again.")
        elif args.get('text') is not None:
            text = str(args['text'])
            self.last_ui = entries = self.buttons()
            matches = [b for b in entries if b['text'].casefold()==clean(text).casefold()]
            if not matches:
                near = [f"{b['id']} \"{b['text']}\"" for b in entries if clean(text).casefold() in b['text'].casefold()][:8]
                raise ValueError(f'No button or option reads "{text}"' + ('; close ones: '+', '.join(near) if near else '') + '.')
            if len(matches)>1:
                places = ', '.join(f"{b['id']} ({b['path']})" for b in matches)
                raise ValueError(f'{len(matches)} entries read "{text}": {places}; click by id.')
            entry = matches[0]
            current=entry
        else: raise ValueError('ui click needs "id" (from the last list) or "text".')
        text = current['text']
        native=re.search(r'(?:LoadGame|SaveGameCompatibilityUI|FuneralUI)',current['path'])
        in_pause=re.search(r'(?:MiniMenu|Pause)(?:/|$)',current['path'])
        confirm=re.search(r'(?:HudConfirm|Confirmation)',current['path'])
        if native or (in_pause and re.search(r'save|load',current['path']+' '+text,re.I)) or (self.pause_menu_open and self.confirmation_open and confirm):
            raise ValueError("ui click refuses the game's save and load controls; use the save and load commands.")
        if entry['kind']=='option':
            self.choice = text
            if self.dialog=='crew':
                v=self.vehicle()
                v['crew']=[] if text=='Unassigned' else [next(e['name'] for e in self.employees if e['label']==text)]
        elif text==LOCALE['foodtrucks:itempanel_commissary']:
            self.dialog='commissary'
        elif text==LOCALE['foodtrucks:itempanel_hires']:
            self.dialog='crew'
        elif text==LOCALE['foodtrucks:itempanel_addstop']:
            self.dialog='opens'
        elif text=='Confirm':
            if self.dialog=='commissary':
                if self.choice.startswith('Order stock for delivery'): self.dialog='phone'
                elif self.choice.startswith(('Rent a space','Move its space')):
                    self.operate(self.vehicle(),'rent_bay'); self.dialog='closed'
                elif self.choice.startswith('Give up its space'):
                    v=self.vehicle();v['commissary']['site']=None
                    self.state['commissary']['spaces']=[s for s in self.state['commissary']['spaces'] if s['vehicle']!=v['id']]
                    self.dialog='closed'
                else: self.operate(self.vehicle(),'restock');self.dialog='closed'
            elif self.dialog=='items':
                self.boxes=max(1,self.boxes)
                self.dialog='order'
            elif self.dialog=='opens':
                self.open_minute=minute(self.choice)
                self.dialog='closes'
            elif self.dialog=='closes':
                v=self.vehicle()
                end=minute(self.choice)
                if end<=self.open_minute: end+=1440
                self.routes[v['id']]=(self.open_minute,end)
                v['route']={'stops':1,'next':f'stop 1, {self.open_minute//60:02d}:00 to {self.choice} at x {v["x"]}, z {v["z"]}'}
                self.dialog='closed'
        elif text==LOCALE['foodtrucks:dialog_commissary_order_stock']:
            self.dialog='order'; self.boxes=0
        elif text=='ADD ITEM': self.dialog='items'
        elif text==LOCALE['foodtrucks:dialog_commissary_order_check']:
            if self.boxes: self.dialog='confirm'
            else: self.event(LOCALE['foodtrucks:notification_commissary_order_empty'],'notice')
        elif text==LOCALE['foodtrucks:dialog_commissary_order_confirm']:
            self.add_order(self.vehicle()['commissary']['bay_site'], self.boxes)
            self.dialog='phone'
        elif text==LOCALE['foodtrucks:dialog_commissary_order_change']: self.dialog='order'
        elif text==LOCALE['foodtrucks:bizman_page_back']: self.dialog='fleet'
        elif text in ('Hang up', 'Cancel'): self.dialog='closed'
        elif text==LOCALE['foodtrucks:itempanel_open']: self.operate(self.vehicle(),'open')
        self.event(f'Test bridge: clicked "{entry["text"]}" ({entry["path"]}).')
        return {'clicked':entry['text']}

    def at_hatch(self, v, how):
        self.activity_starting=False
        self.state['player'].update(in_vehicle=None, at_hatch=v['id'])
        v['serving']='player'
        self.event(f"Truck window: player placed at the hatch of truck {v['id']} ({how}) at (0, 0, 0).")

    def operate(self, v, op):
        player = self.state['player']
        start=self.seq
        why=None
        cargo_before=copy.deepcopy(v['stock'])
        space_before=(v['commissary'] or {}).get('site')
        if not self.mod_loaded: raise ValueError("The mod's save data isn't loaded.")
        label={'open':'Open here','exit':'Park','rent_bay':'Commissary','restock':'Commissary'}.get(op)
        if label and player['in_vehicle'] != v['id']:
            raise ValueError(f"{label} is on the vehicle's panel, shown while the player drives the truck or pushes the cart: vehicle enter first.")
        if op=='open':
            if self.state['clock']['paused']:
                raise ValueError("Open parks with the game's Park button, which doesn't work while paused: unpause first (time).")
            expiry=self.state['licence']['until_day']
            reason=None
            if not v['pieces']: reason='notification_open_no_equipment'
            elif not any(s['amount']>0 for s in v['stock']): reason='notification_open_no_stock'
            elif expiry is None: reason='notification_open_no_licence'
            elif expiry<self.state['clock']['day']: reason='notification_open_licence_expired'
            elif not v['hatch_to_pavement'] and v['kind']=='truck': reason='legality_truck_hatch'
            if reason:
                self.event(LOCALE.get('foodtrucks:'+reason, LOCALE['foodtrucks:legality_truck_parking']).format(vehicle=v['kind']),'notice')
            else:
                v.update(open=True, serving='nobody',queue={'length':0,'places':[]})
                player['in_vehicle']=None
                if v['kind']=='truck':
                    self.activity_starting=True
                    self.walks.append((time.monotonic()+.05,lambda:self.at_hatch(v,'opened')))
                else: v.update(serving='player',hatch_side='right')
        elif op=='back_to_hatch':
            if v['kind']!='truck' or not v['open'] or player['in_vehicle'] or player['carrying'] or player['at_hatch'] or self.walks:
                raise ValueError("Back to the hatch isn't offered now: it needs an open truck and the player on foot, empty-handed and not at a hatch.")
            self.event(f"Truck window: back to the hatch of truck {v['id']}: walking to the rear door.")
            self.walks.append((time.monotonic()+.05,lambda:self.at_hatch(v,'back to the hatch')))
        elif op=='step_out':
            if player['at_hatch']!=v['id']: raise ValueError(f"The player isn't at the hatch of {v['id']}.")
            player['at_hatch']=None
            v['serving']='crew' if v['crew'] else 'nobody'
            self.event(f"Truck window: player stepped out of truck {v['id']} at (0, 0, 0) (stepped out).")
            if not v['crew']:
                self.event(f"Window {v['id']}: nobody serving the truck; the player left the hatch: stepped out.")
                # As in game: the notice comes from the next per-minute sales check, not with the step-out.
                self.__dict__.setdefault('paused_notice', set()).add(v['id'])
        elif op=='close':
            if not v['open']: raise ValueError(f"Vehicle {v['id']} isn't open.")
            v.update(open=False,serving='nobody',queue=None)
            if player['at_hatch']==v['id']: player['at_hatch']=None
        elif op=='enter':
            if player['in_vehicle']==v['id']: raise ValueError(f"The player is in {v['id']} already.")
            if player['in_vehicle']: raise ValueError(f"The player is in another vehicle ({player['in_vehicle']}): vehicle exit first.")
            def arrive():
                player.update(in_vehicle=v['id'],at_hatch=None,x=v['x'],y=v['y'],z=v['z'])
                v.update(open=False,serving='nobody',queue=None)
            if ((player['x']-v['x'])**2+(player['z']-v['z'])**2)**.5>2.5:
                self.walks.append((time.monotonic()+.05,arrive))
            else: arrive()
        elif op=='exit':
            if self.state['clock']['paused']: raise ValueError("The game's Park button refused: paused, no parking here, or the panel isn't showing.")
            player['in_vehicle']=None
        elif op in ('rent_bay','restock'):
            c=v['commissary']
            if not self.can_write:
                why='the Commissary button refused (see the notice)'
                self.event(LOCALE['foodtrucks:notification_data_readonly'],'notice')
            elif not c or not c['in_bay']:
                why='the Commissary button refused (see the notice)'
                self.event(LOCALE['foodtrucks:notification_commissary_not_here'].format(vehicle=v['kind']),'notice')
            elif op=='rent_bay' and c['site']==c['bay_site']:
                offered='release, '+('restock' if any(stock['site']==c['bay_site'] and stock['amount']>0 for stock in self.state['commissary']['stock']) else 'nostock')+', order'
                why=f'the Commissary button offers {offered} here, not rent or move'
            else:
                self.commissary_panel(v,op)
        else: raise ValueError(f"Unknown op '{op}': open, close, step_out, back_to_hatch, enter, exit, restock or rent_bay.")
        done = {'open':v['open'], 'close':not v['open'], 'step_out':player['at_hatch']!=v['id'],
                'back_to_hatch':bool(self.walks) or player['at_hatch']==v['id'],
                'enter':player['in_vehicle']==v['id'] or bool(self.walks), 'exit':player['in_vehicle']!=v['id'],
                'restock':v['stock']!=cargo_before,
                'rent_bay':(v['commissary'] or {}).get('site') is not None and (v['commissary'] or {}).get('site')!=space_before}[op]
        self.event(f"Test bridge: vehicle {v['id']} {op}: {'done' if done else 'not done'}.")
        notices=[e['text'][8:] for e in self.ring if e['seq']>start and e['kind']=='notice']
        return {'done':done,'why':None if done else why,'notices':notices,'state':next(vehicle for vehicle in self.read_state()['vehicles'] if vehicle['id']==v['id'])}

    def commissary_panel(self, v, op):
        c=v['commissary']
        site=c['bay_site']
        if op=='rent_bay':
            if c['site']==site:
                return
            self.state['commissary']['spaces']=[s for s in self.state['commissary']['spaces'] if s['vehicle']!=v['id']]+[{'site':site,'vehicle':v['id']}]
            previous=c['site']
            c['site']=site
            monthly=TUNING['commissary']['rentPerMonthCents'][v['kind']]
            charge=int(monthly*12/365+.5)/100
            if previous is None:
                if self.state['money']>=charge:
                    self.state['money']-=charge
                    self.transaction('foodtrucks:transaction_commissary_rent',-charge,commissary=LOCALE['foodtrucks:commissary_'+site])
                else: self.state['commissary']['unpaid']['rent']+=charge
                text=LOCALE['foodtrucks:notification_commissary_rented'].format(vehicle=v['kind'],commissary=LOCALE['foodtrucks:commissary_'+site],rent=f'${monthly/100:,.2f}')
            else:
                text=LOCALE['foodtrucks:notification_commissary_moved'].format(vehicle=v['kind'],commissary=LOCALE['foodtrucks:commissary_'+site],**{'from':LOCALE['foodtrucks:commissary_'+previous]})
            self.event(text,'notice')
        elif not any(s['site']==site and s['amount']>0 for s in self.state['commissary']['stock']):
            self.event(LOCALE['foodtrucks:notification_commissary_nostock'].format(commissary=LOCALE['foodtrucks:commissary_'+site]),'notice')
        else:
            loaded=[]
            for stock in self.state['commissary']['stock']:
                if stock['site']!=site: continue
                holds={'Hotdog':'hotdoggrill','Tacos':'griddle'}.get(stock['item'])
                pool=next((p for p in v['pieces'] if p['item']==holds),None)
                if not pool: continue
                amount=min(stock['amount'],max(0,int(pool['cap']-pool['units'])))
                pool['units']+=amount; stock['amount']-=amount
                cargo=next((s for s in v['stock'] if s['key']==stock['key']),None)
                if cargo: cargo['amount']+=amount
                else: v['stock'].append({'item':stock['item'],'key':stock['key'],'amount':amount})
                if amount: loaded.append(f'{amount} {stock["item"]}')
            left=sum(s['amount'] for s in self.state['commissary']['stock'] if s['site']==site)
            if loaded: self.event(LOCALE['foodtrucks:notification_commissary_restocked'].format(vehicle=v['kind'],loaded=', '.join(loaded),full='',left=left),'notice')
            else: self.event(LOCALE['foodtrucks:notification_commissary_restock_full'].format(vehicle=v['kind'],left=left),'notice')

    # The fixture and logistics commands (docs/test-bridge.md): a warehouse, a headquarters and a plan to a commissary,
    # kept as one record per save; the run moves what is missing up to each target from the warehouse to the commissary.
    FIXTURE_STEPS = ('commissary_space','warehouse','pallets','stock','headquarters','logistics_manager','vehicle','driver','plan')
    ITEM_NAMES = {'ba:itemname_hotdog':'Hotdog'}

    def fixture(self, args):
        name=need(args,'name',"the fixture's name: logistics")
        if name!='logistics': raise ValueError(f"No fixture '{name}'. Fixtures: logistics.")
        if self.inside_building:
            raise ValueError("The player is inside a building; the game places furniture and vehicles only in buildings the player isn't in. Teleport the player outside first.")
        site=args.get('site') or 'hells-kitchen'
        if site not in SITES: raise ValueError(f"No commissary '{site}'. Commissaries: {', '.join(SITES)}.")
        def rows(key, amount, default):
            value=args.get(key)
            if value is None: return default
            if not isinstance(value,list) or not value: raise ValueError(f'"{key}" is a list: [ {{ "item", "{amount}" }} ].')
            return [(r['item'],int(r[amount])) for r in value]
        stock=rows('stock','units',[('ba:itemname_hotdog',200)])
        targets=rows('targets','amount',[('ba:itemname_hotdog',40)])
        steps=[]
        def step(name,status,detail):
            steps.append({'step':name,'status':status,'detail':detail})
            self.event(f'Test bridge: fixture logistics, {name}: {status}: {detail}')
        spaces=self.state['commissary']['spaces']
        if any(s['site']==site for s in spaces):
            step('commissary_space','already',f'{site} has a space')
        else:
            free=[v for v in self.state['vehicles'] if not any(s['vehicle']==v['id'] for s in spaces)]
            if not free:
                step('commissary_space','failed','no food cart or truck in this save; a space is rented for a vehicle (debug spawn truck, or buy one), then run the fixture again')
                for rest in self.FIXTURE_STEPS[1:]: step(rest,'not_run','an earlier step failed')
                return {'fixture':'logistics','complete':False,'site':site,'steps':steps,'warehouse':None,'headquarters':None,'plan':None}
            v=free[0]
            spaces.append({'site':site,'vehicle':v['id']})
            v['commissary']={**(v['commissary'] or {'in_bay':False,'bay_site':None}),'site':site}
            step('commissary_space','done',f"{v['kind']} {v['id']} rented a space at {site}")
        made=self.logistics is None
        if made:
            self.logistics={'warehouse':{'name':'FT Fixture Warehouse','address':'ba:street_mockstreet#2','type':'ba:businesstype_warehouse'},
                            'headquarters':{'name':'FT Fixture HQ','address':'ba:street_mockstreet#4','type':'ba:businesstype_headquarters'},
                            'stock':{}, 'plan':{'id':'mockplan','destinations':[]}}
        lg=self.logistics
        for name in ('warehouse','pallets'): step(name,'done' if made else 'already','mock')
        added=[f'{amount-lg["stock"].get(item,0)} {item}' for item,amount in stock if lg['stock'].get(item,0)<amount]
        for item,amount in stock: lg['stock'][item]=max(amount,lg['stock'].get(item,0))
        step('stock','done' if added else 'already',', '.join(added) or 'mock')
        for name in ('headquarters','logistics_manager','vehicle','driver'): step(name,'done' if made else 'already','mock')
        dest=next((d for d in lg['plan']['destinations'] if d['site']==site),None)
        changed=dest is None
        if dest is None:
            dest={'site':site,'targets':{}}
            lg['plan']['destinations'].append(dest)
        for item,amount in targets:
            if dest['targets'].get(item)!=amount: dest['targets'][item]=amount; changed=True
        step('plan','done' if changed else 'already',f'destination {lg["plan"]["destinations"].index(dest)+1} of 1')
        return {'fixture':'logistics','complete':True,'site':site,'steps':steps,'warehouse':lg['warehouse'],'headquarters':lg['headquarters'],
                'plan':self.plan_json()}

    def held(self, site, item):
        return sum(s['amount'] for s in self.state['commissary']['stock'] if s['site']==site and s.get('key')==item)

    def plan_json(self):
        lg=self.logistics
        items=sorted({item for d in lg['plan']['destinations'] for item in d['targets']})
        return {'id':lg['plan']['id'],'headquarters':lg['headquarters']['address'],
                'warehouse':{**{k:lg['warehouse'][k] for k in ('name','address')},'stock':[{'item':i,'amount':lg['stock'].get(i,0)} for i in items]},
                'manager':{'id':'mockmanager','name':'Mock Manager','skill':60.0},'max_destinations':1,
                'destinations':[{'index':n+1,'site':d['site'],'address':None,
                                 'targets':[{'item':i,'target':t,'held':self.held(d['site'],i)} for i,t in d['targets'].items()]}
                                for n,d in enumerate(lg['plan']['destinations'])]}

    def logistics_command(self, args):
        op=need(args,'op','status or run')
        only=args.get('warehouse')
        plans=lambda: [self.plan_json()] if self.logistics and only in (None,self.logistics['warehouse']['address']) else []
        if op=='status': return {'plans':plans()}
        if op!='run': raise ValueError(f"Unknown logistics op '{op}': status, run.")
        self.require_ft('logistics run')
        before=plans()
        planned=0
        if self.logistics:
            lg=self.logistics
            for d in lg['plan']['destinations'][:1]:
                planned+=1
                moved=[]
                for item,target in d['targets'].items():
                    take=min(max(0,target-self.held(d['site'],item)),lg['stock'].get(item,0))
                    if take<=0: continue
                    lg['stock'][item]-=take
                    line=next((s for s in self.state['commissary']['stock'] if s['site']==d['site'] and s.get('key')==item),None)
                    if line: line['amount']+=take
                    else: self.state['commissary']['stock'].append({'site':d['site'],'item':self.ITEM_NAMES.get(item,item),'key':item,'amount':take})
                    moved.append((item,take))
                text=', '.join(f'{n} {i}' for i,n in moved) if moved else 'nothing brought'
                self.event(f"Commissary logistics: {lg['warehouse']['name']} to {d['site']}: {text} ({sum(n for _,n in moved)} units).")
        c=self.state['clock']
        self.event(f"Test bridge: logistics run now (the game's 02:00 warehouse deliveries), day {c['day']} {c['time']}: {planned} destinations planned.")
        return {'deliveries':planned,'before':before,'after':plans()}

    def require_city(self, cmd):
        scene=self.state['scene']
        if scene!='city': raise ValueError(f'{cmd} works in the city only; the game is at the {scene} now.')

    def require_ft(self, cmd):
        self.require_city(cmd)
        name=self.state['save'] or ''
        if not name.startswith('FT'):
            raise ValueError(f"{cmd} changes the save, and the loaded save '{name}' doesn't start with FT: load an FT save first.")
        self.require_character()

    def require_character(self, character=None):
        character = self.character if character is None else character
        other = next(iter(sorted(name for name,save in self.saves.items() if save['character']==character and not name.startswith('FT') and not re.fullmatch(r'Recover (#\d+|Midnight)',name))),None)
        if other is not None:
            raise ValueError(f"This save's character also has saves not starting with FT ({other}); make FT saves with a character of their own.")

    def require_ui(self):
        if self.state['scene']!='city' or not (self.state['save'] or '').startswith('FT'):
            raise ValueError('ui works only in a loaded FT city; use load from the main menu.')
        self.require_character()

    def call(self, cmd, args):
        if self.stopped: raise ValueError('the bridge stopped')
        if cmd in ('console','debug','time','money','teleport','vehicle','commissary','crew','fixture','save'): self.require_ft(cmd)
        if cmd=='state': return self.read_state()
        if cmd=='fixture': return self.fixture(args)
        if cmd=='logistics':
            self.require_city(cmd)
            return self.logistics_command(args)
        if cmd=='parks':
            self.require_city(cmd)
            return self.parks()
        if cmd in ('load','save'):
            name=need(args,'name',"the save's name")
            if not name.startswith('FT'):
                if cmd=='load': raise ValueError(f"The bridge loads only saves whose name starts with FT, not '{name}'.")
                raise ValueError(f"The bridge saves only under names that start with FT, not '{name}'.")
            if cmd=='save':
                return self.save_city(name)
            if self.state['scene']=='loading': raise ValueError('The game is loading; wait until /health says menu or city.')
            if self.load and self.load['status']=='pending': raise ValueError(f"A load of '{self.load['name']}' is under way; wait for it (state.load).")
            if self.state['scene']=='city' and not (self.state['save'] or '').startswith('FT'):
                raise ValueError(f"The loaded save '{self.state['save']}' doesn't start with FT, and leaving it would skip the game's question about unsaved changes: go to the main menu by hand, or load from an FT save.")
            if name not in self.saves: raise ValueError(f"No save named '{name}'. FT saves: {', '.join(n for n in self.saves if n.startswith('FT')) or 'none'}.")
            self.require_character(self.saves[name]['character'])
            if self.state['scene']=='city': self.require_character()
            if self.state['scene']=='menu' and self.character_creator: raise ValueError('load works from the main menu or the city, not the character creator.')
            self.load={'name':name,'status':'pending','error':None}
            self.state['scene']='loading'
            self.event(f"Test bridge: loading '{name}' (Mock character, day {self.saves[name]['state']['clock']['day']}).")
            self.pending.append((time.monotonic()+.05,lambda:self.finish_load(name)))
            return {'loading':True,'name':name,'character':'Mock character'}
        if cmd=='new_game':
            name=args.get('name')
            if name is not None and not str(name).startswith('FT'):
                raise ValueError(f"The bridge starts only games whose name starts with FT, not '{name}'.")
            raise ValueError("new_game isn't available: the game builds a new game's character only in the character creator's screens (MainMenuController.StartNewGame, then the Intro scene), which the bridge can't fill in reliably. Start a game by hand once, save it under an FT name, and use load.")
        if cmd=='money':
            balance=num(args,'set')
            if balance is None: raise ValueError('money needs "set": the new balance.')
            self.state['money']=round(balance,2)
            return {'money':self.state['money']}
        if cmd=='time':
            c=self.state['clock']
            if self.time_skip: raise ValueError('A time skip (sleep, a paid activity) is running; wait for it to end.')
            pause=args.get('pause') if isinstance(args.get('pause'),bool) else None
            speed=num(args,'speed')
            until=args.get('run_until') if isinstance(args.get('run_until'),dict) else None
            keep=args.get('keep_needs')
            if keep is not None and not isinstance(keep,bool): raise ValueError('keep_needs must be true or false.')
            if pause is None and speed is None and until is None: raise ValueError('time needs "pause", "speed" or "run_until".')
            if speed is not None and not 0<speed<=60: raise ValueError('speed must be above 0 and at most 60.')
            unpausing=until is not None or pause is False or (speed is not None and pause is not True)
            if unpausing and self.clock_held_by():
                raise ValueError('A screen holds the clock (the phone, the map, a call, an activity or a menu): close it first (ui escape).')
            # The whole request is checked before anything changes, as the bridge does (review round 6).
            target=None
            if until is not None:
                day=until.get('day',c['day'])
                try:
                    day=c['day']+int(day[1:]) if isinstance(day,str) and day.startswith('+') else int(str(day))
                except ValueError: raise ValueError('run_until.day must be a day number or "+N".')
                if 'time' not in until: raise ValueError('run_until needs "time" ("HH:MM").')
                mins=minute(str(until['time']))
                text=f'day {day} {mins//60:02d}:{mins%60:02d}'
                target=(day-1)*1440+mins
                if target<=self.absolute: raise ValueError(f"{text} has passed already: it is day {c['day']} {c['time']}.")
            self.until=None
            c.update(run_until=None,arrived_at=None)
            c['keep_needs']=bool(unpausing and pause is not True and (keep if keep is not None else until is not None))
            if target is not None:
                self.until=target; self.until_text=text
                c['run_until']=text
                c.update(speed=speed if speed is not None else 1,paused=False)
                self.event(f'Test bridge: running the clock at speed {c["speed"]} until {text}.')
            else:
                if speed is not None: c['speed']=speed
                if pause is not None: c['paused']=pause
                elif speed is not None: c['paused']=False
            return copy.deepcopy(c)
        if cmd=='debug':
            start=self.seq
            action=need(args,'action',"the debug action's name")
            if action in ('spawn truck','spawn cart'): self.spawn(action.split()[-1])
            elif action=='licence':
                self.state['licence'].update(until_day=self.state['clock']['day']-1+TUNING['fleet']['licenceDays'],permits=len(self.state['vehicles']))
                self.event(LOCALE['foodtrucks:notification_debug_licence'].format(day=self.state['licence']['until_day'],count=len(self.state['vehicles'])),'notice')
            elif action=='new items':
                v=self.vehicle()
                v['pieces']=[{'item':'griddle','units':160,'cap':160}]
                v['stock']=[{'item':'Tacos','key':'foodtrucks:itemname_tacos','amount':160}]
            elif action=='hire':
                name=f'Mock worker {len(self.employees)+1}'
                self.employees.append({'id':f'worker-{len(self.employees)+1}','name':name,'skill':60.,'satisfaction':100.,'wage':10.,'label':LOCALE['foodtrucks:bizman_page_crew_option'].format(name=name,skill=60,satisfaction=100,wage='$10.00')})
                self.event(f'Debug: hired {name} (worker1), customer service 60, $10.00 an hour.')
                self.event(f'Hired {name}, customer service 60.','notice')
            elif action=='commissary deliveries':
                n=len(self.state['commissary']['orders']); self.deliver(True)
                self.event(f'Debug: {n} commissary orders brought forward and delivered (paid on delivery).')
            elif action in ('status','demand here','commissary bays','overnight check','grip','zone point','tax statement','tax fixture','event here','gig here','uninstall','spawn hand truck'):
                self.event(f'Debug: {action} completed in mock.')
            else:
                names='spawn truck, licence, spawn cart, spawn hand truck, new items, hire, status, demand here, grip, zone point, event here, gig here, tax statement, tax fixture, commissary bays, commissary deliveries, overnight check, uninstall'
                raise ValueError(f"No debug action '{action}'. Actions: {names}.")
            return {'action':action,'notices':[e['text'][8:] for e in self.ring if e['seq']>start and e['kind']=='notice']}
        if cmd=='teleport':
            who=need(args,'who',"\"player\" or a food vehicle's id")
            obj=self.state['player'] if who=='player' else self.vehicle(who)
            place=args.get('place'); heading=num(args,'heading')
            if place is not None:
                kind,_,identifier=str(place).partition(':')
                if kind in ('bay','commissary'):
                    if kind=='commissary' and who!='player': raise ValueError('commissary: places the player at the door; a vehicle goes to bay:<site>.')
                    if identifier not in SITES: raise ValueError(f"No commissary '{identifier}'. Commissaries: {', '.join(SITES)}.")
                    if kind=='bay': self.require_bay(identifier)
                    x,z=393.2+SITES.index(identifier)*100,217.6
                elif kind=='vehicle':
                    if who!='player': raise ValueError('vehicle: places the player beside a vehicle.')
                    v=self.vehicle(identifier); x,z=v['x']+(2.6 if v['kind']=='truck' else 2.1),v['z']
                else: raise ValueError(f"Unknown place '{place}': use bay:<site>, commissary:<site> or vehicle:<id>.")
            surface=None
            if place is None:
                x,z=num(args,'x'),num(args,'z')
                if x is None or z is None: raise ValueError('teleport needs "x" and "z", or "place".')
                # The mock's city is flat: one walkable surface at y 0 (the bridge stacks every ground surface and picks).
                y=num(args,'y')
                what='walkable surface' if who=='player' else 'surface'
                # For the player the bridge checks walking routes from where they stand, when they stand on the NavMesh.
                far=who=='player' and math.hypot(obj['x']-x,obj['z']-z)>100
                route=('' if who!='player' else "; walking routes not checked (the player isn't on the NavMesh)" if obj['in_vehicle']
                       else "; walking routes not checked (more than 100 m from the player)" if far else "; walking routes checked from the player's place")
                if y is not None and abs(y)>1.5:
                    walk='walkable ' if who=='player' else ''
                    raise ValueError(f"No {walk}ground at x {x:.1f}, z {z:.1f} near y {y:.2f}: no {what} within 1.5 m of the y asked for ({y:.2f}); surfaces there: 0.00 walkable{route}.")
                surface=(f"the {what} nearest the y asked for ({y:.2f}) of 1: 0.00 walkable" if y is not None else 'the only ground surface, walkable')+route
            if who!='player' and obj['open']: raise ValueError(f"Vehicle {who} is open for business: close it first (vehicle close).")
            if who=='player':
                self.walks=[]
                self.activity_starting=False
                if obj['at_hatch']: self.operate(self.vehicle(obj['at_hatch']),'step_out')
                obj.update(in_vehicle=None,at_hatch=None)
            if who!='player' and place and str(place).startswith('bay:'): self.place_vehicle(obj,identifier)
            else:
                obj.update(x=float(x),y=0.,z=float(z),heading=heading if heading is not None else obj['heading'])
                if who!='player': obj['commissary']=None
            obj['heading']=obj['heading']%360
            if heading is not None: obj['heading']=heading%360
            reply={key:round(obj[key],2) for key in ('x','y','z','heading')}
            if who!='player': reply['in_the_way_after']=[]
            if surface is not None: reply['surface']=surface
            return reply
        if cmd=='vehicle':
            return self.operate(self.vehicle(need(args,'id',"the food vehicle's id")),need(args,'op','open, close, step_out, back_to_hatch, enter, exit, restock or rent_bay'))
        if cmd=='commissary':
            op=need(args,'op','order or bay_candidates')
            if op=='bay_candidates': return self.bay_candidates(args)
            if op!='order': raise ValueError(f"Unknown commissary op '{op}': order, bay_candidates.")
            site=need(args,'site',"the commissary's id")
            rows=args.get('items')
            if not isinstance(rows,list) or not rows: raise ValueError('order needs "items": [ { "item", "boxes" } ].')
            requests=[]
            for row in rows:
                if not isinstance(row,dict): continue
                item=need(row,'item','an item key or name')
                boxes=num(row,'boxes')
                if boxes is None: raise ValueError('Each item needs "boxes".')
                requests.append((item,max(0,int(boxes))))
            if site not in SITES: raise ValueError(f'no commissary {site}')
            if not self.mod_loaded or not self.can_write: raise ValueError("the commissary can't take orders now (data not loaded, read-only or uninstalled)")
            if not any(s['site']==site for s in self.state['commissary']['spaces']):
                raise ValueError(f"no space rented at {site} (or it isn't unlocked): rent a space first")
            merged={}
            for item,boxes in requests:
                key=item if item in CATALOG else next((key for key,(name,_,_) in CATALOG.items() if name.casefold()==item.casefold()),None)
                if key is None: raise ValueError(f"{item} isn't on the commissary's list")
                if boxes: merged[key]=merged.get(key,0)+boxes
            if not sum(merged.values()): raise ValueError('the order has no boxes')
            if sum(merged.values())>10: raise ValueError('more than 10 boxes in one order')
            tomorrow=self.state['clock']['day']+1
            shared=any(o['site']==site and o['due_day']==tomorrow for o in self.state['commissary']['orders'])
            fee=0.0 if shared else TUNING['commissary']['deliveryFeeCents']/100
            orders=[self.add_order(site,boxes,item=item) for item,boxes in merged.items()]
            # As the game side: the first order shows the fee this quote adds, paid with it on delivery.
            rows=[{k:order[k] for k in ('n','site','item','units','goods','due_day')} for order in orders]
            for i,row in enumerate(rows):
                row['fee']=fee if i==0 else 0.0; row['total']=round(row['goods']+row['fee'],2)
            return {'orders':rows,'delivery_fee':fee}
        if cmd=='crew':
            op=need(args,'op','assign or unassign')
            identifier=need(args,'vehicle',"the food vehicle's id")
            employee_id=need(args,'employee_id',"the employee's id (state.employees)")
            v=self.vehicle(identifier)
            if not self.mod_loaded: raise ValueError("The mod's save data isn't loaded.")
            if not self.can_write: raise ValueError("The mod's save data is read-only.")
            employee=next((e for e in self.employees if e['id']==employee_id),None)
            name=employee['name'] if employee else None
            if op=='assign':
                if name in v['crew']: raise ValueError(f'{employee_id} is on {identifier} already.')
                if employee is None or any(name in other['crew'] for other in self.state['vehicles']):
                    raise ValueError(f"{employee_id} isn't an unassigned hire (see state.employees).")
                if len(v['crew']) >= (3 if v['kind']=='truck' else 1): raise ValueError(f"{identifier} has its full crew ({len(v['crew'])}).")
                v['crew'].append(name)
            elif op=='unassign':
                if name not in v['crew']: raise ValueError(f"{employee_id} isn't on {identifier}.")
                v['crew'].remove(name)
            else: raise ValueError(f"Unknown crew op '{op}': assign or unassign.")
            notice=LOCALE['foodtrucks:notification_crew_added' if op=='assign' else 'foodtrucks:notification_crew_letgo'].format(name=name,vehicle=v['kind'])
            self.event(notice,'notice')
            return {'done':True,'notices':[notice],'state':next(vehicle for vehicle in self.read_state()['vehicles'] if vehicle['id']==identifier)}
        if cmd=='ui':
            op=need(args,'op','list, click or escape')
            if op=='list':
                self.last_ui=self.buttons()
                texts=self.state['notices_recent'][-2:] + ([clean(t) for t in self.phone_texts[-20:]] if self.dialog in ('phone','order','confirm','items') else [])
                if self.dialog=='confirm':
                    goods=self.boxes*750;per=TUNING['commissary']['deliveryFeeCents']/100
                    # The mock reads back the unshared quote: one flat fee for tomorrow's delivery.
                    fee=per
                    texts=[clean(LOCALE['foodtrucks:dialog_commissary_quote'].format(items='Hotdog',goods=f'${goods:.2f}',fee=f'${fee:.2f}',perDelivery=f'${per:.2f}',total=f'${goods+fee:.2f}',time='08:00'))]
                return {'buttons':self.last_ui,'texts':texts}
            if op=='click':
                self.require_ui()
                return self.click(args)
            if op=='escape':
                self.require_ui()
                if self.dialog not in ('commissary','items','opens','closes'):
                    if self.confirmation_open:
                        self.confirmation_open=False
                        return {'closed':'confirmation'}
                    if self.pause_menu_open:
                        self.pause_menu_open=False
                        return {'closed':'pause menu'}
                if self.dialog=='closed':
                    hatch=self.state['player']['at_hatch']
                    if hatch:
                        self.operate(self.vehicle(hatch),'step_out'); return {'closed':'activity panel'}
                    raise ValueError('Nothing is open to close (Esc would open the pause menu).')
                closed='list picker' if self.dialog in ('commissary','items','opens','closes') else 'phone'
                self.dialog='closed'; self.event(f'Test bridge: escape: {closed}.')
                return {'closed':closed}
            raise ValueError(f"Unknown ui op '{op}': list, click or escape.")
        if cmd=='shoot':
            self.require_city(cmd)
            name=need(args,'name',"the picture's file name, without .png")
            if not re.fullmatch(r'[A-Za-z0-9._-]{1,80}',name): raise ValueError("name may use letters, digits, '.', '_' and '-' only.")
            width,height=int(num(args,'width') if num(args,'width') is not None else 1600),int(num(args,'height') if num(args,'height') is not None else 900)
            if not 16<=width<=3840 or not 16<=height<=2160: raise ValueError('width and height must be between 16 and 3840 by 2160.')
            pose=args.get('pose')
            if pose is not None:
                target=need(args,'target','a vehicle id, bay:<site> or commissary:<site>')
                if target.startswith('bay:') and pose not in ('bay-pavement','bay-road'): raise ValueError(f'A bay takes the poses bay-pavement and bay-road, not {pose}.')
                if target.startswith('commissary:') and pose!='door': raise ValueError(f'A commissary takes the pose door, not {pose}.')
                if target.startswith(('bay:','commissary:')):
                    site=target.split(':',1)[1]
                    if site not in SITES: raise ValueError(f"No commissary '{site}'. Commissaries: {', '.join(SITES)}.")
                    if target.startswith('bay:'): self.require_bay(site)
                else:
                    self.vehicle(target)
                    if pose not in POSES: raise ValueError(f"A vehicle takes the poses hatch-pavement, hatch-close, vehicle-side, vehicle-overhead, queue and cart-counter, not {pose}.")
            fov=num(args,'fov')
            fov=60 if fov is None else fov
            if not 5<=fov<=120: raise ValueError('fov must be 5 to 120 degrees.')
            camera={'x':0.,'y':1.65,'z':-6.,'yaw':0.,'pitch':0.,'fov':fov}
            if pose is None:
                if any(num(args,k) is None for k in ('x','y','z')): raise ValueError('shoot needs "pose" and "target", or "x", "y", "z" (with "yaw" and "pitch", or "look_at", and "fov").')
                camera.update(x=round(num(args,'x'),2),y=round(num(args,'y'),2),z=round(num(args,'z'),2))
                look=args.get('look_at')
                if look is not None:
                    if not isinstance(look,dict): raise ValueError('look_at must be an object { "x", "y", "z" }.')
                    if 'yaw' in args or 'pitch' in args: raise ValueError('shoot takes "look_at" or "yaw" and "pitch", not both.')
                    if any(num(look,k) is None for k in ('x','y','z')): raise ValueError('look_at needs "x", "y" and "z".')
                    dx,dy,dz=(num(look,k)-camera[k] for k in ('x','y','z'))
                    if dx*dx+dy*dy+dz*dz<1e-4: raise ValueError('look_at is where the camera stands; give a point away from it.')
                    camera.update(yaw=round(math.degrees(math.atan2(dx,dz))%360,2),pitch=round(-math.degrees(math.atan2(dy,math.hypot(dx,dz))),2))
                else:
                    camera.update(yaw=round((num(args,'yaw') or 0)%360,2),pitch=round(num(args,'pitch') or 0,2))
            frames=num(args,'frames')
            if frames is not None and (frames!=int(frames) or not 8<=frames<=240): raise ValueError('frames must be a whole number from 8 to 240.')
            for flag in ('compare','game_view'):
                if args.get(flag) is not None and not isinstance(args.get(flag),bool): raise ValueError(f'{flag} must be true or false.')
            path=self.shots/(name+'.png')
            colour=(180,190,200) if self.state['clock']['time']<'20:00' else (35,45,65)
            png(path,width,height,colour)
            # The mock has no walls, fades or outlines: a named pose always stands clear (pose_note null), and nothing is
            # uncovered or outlined.
            reply={'path':str(path),'camera':camera,'pose_note':None,'uncovered':[],'outlined':[],'hovered':[],'asis_path':None,'game_path':None,'game_error':None}
            if args.get('compare'):
                asis=self.shots/(name+'-asis.png'); png(asis,width,height,colour)
                reply.update(asis_path=str(asis),asis_uncovered=[],asis_outlined=[],asis_hovered=[])
            if args.get('game_view'):
                game=self.shots/(name+'-game.png'); png(game,width,height,colour)
                reply['game_path']=str(game)
            return reply
        if cmd=='console':
            line=need(args,'line','the console line to run')
            self.event(f'Mock console: {line}')
            return {'output':[f'Mock console accepted: {line}']}
        if cmd=='quit': return {}
        raise ValueError(f"Unknown command '{cmd}'. Commands: state, console, debug, time, money, teleport, vehicle, commissary, crew, fixture, logistics, parks, ui, shoot, save, load, new_game, quit, op.")


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def reply(self, data, status=200):
        data.setdefault('session',self.server.mock.session)
        payload = json.dumps(data).encode()
        self.send_response(status)
        self.send_header('Content-Type','application/json; charset=utf-8')
        self.send_header('Content-Length',str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self):
        url = urlsplit(self.path)
        try:
            with self.server.mock.lock:
                if url.path.rstrip('/') == '/health':
                    result = self.server.mock.health()
                elif url.path.rstrip('/') == '/events':
                    try: since=int(parse_qs(url.query).get('since',['0'])[0])
                    except ValueError: since=0
                    if not -(2**63)<=since<2**63: since=0
                    result = self.server.mock.events(since)
                else:
                    self.reply({'ok':False,'error':'Unknown endpoint: use GET /health, POST /call or GET /events?since=N.'},404)
                    return
                self.reply(result)
        except (ValueError, TypeError) as exc:
            self.reply({'ok':False,'error':f'Cannot read endpoint: {exc}; use /health or /events?since=<sequence>'})

    def do_POST(self):
        try:
            if urlsplit(self.path).path.rstrip('/') != '/call':
                self.reply({'ok':False,'error':'Unknown endpoint: use GET /health, POST /call or GET /events?since=N.'},404)
                return
            if self.headers.get('Origin') is not None or self.headers.get('Sec-Fetch-Site') is not None:
                self.reply({'ok':False,'error':'Browser-origin calls are refused; use the CLI or MCP bridge client.'},403)
                return
            if self.headers.get('Content-Type','').split(';',1)[0].strip().lower() != 'application/json':
                self.reply({'ok':False,'error':'POST /call requires Content-Type: application/json.'},415)
                return
            size = int(self.headers.get('Content-Length',0))
            if not 0 < size <= 1048576:
                raise ValueError('Invalid request size: send a JSON object smaller than 1 MB')
            body = json.loads(self.rfile.read(size))
            if not isinstance(body,dict): raise ValueError('The body is not a JSON object: expected an object.')
            if not body.get('cmd'): raise ValueError('The body has no "cmd".')
            args=body.get('args') if isinstance(body.get('args'),dict) else {}
            result=self.server.mock.operation(body['cmd'],args,body.get('expect_session'))
            self.reply(result)
            if body['cmd'] == 'quit' and result['ok']:
                threading.Timer(.5, self.server.shutdown).start()
        except (ValueError, KeyError, TypeError, AttributeError) as exc:
            message = str(exc)
            self.reply({'ok':False,'error':message})


def stop_server(signum, frame):
    raise KeyboardInterrupt


def main():
    signal.signal(signal.SIGTERM, stop_server)
    parser = argparse.ArgumentParser(description='Local fake Food Trucks bridge')
    parser.add_argument('--port',type=int,default=8330)
    parser.add_argument('--clock-rate',type=float,default=1,help='Normal game minutes per real second, like Options game speed')
    args = parser.parse_args()
    with tempfile.TemporaryDirectory(prefix='foodtrucks-mock-') as shots:
        server = ThreadingHTTPServer(('127.0.0.1',args.port),Handler)
        server.mock = Mock(shots, args.clock_rate)
        thread = threading.Thread(target=server.mock.run_clock,daemon=True)
        thread.start()
        print(f'Mock bridge at http://127.0.0.1:{server.server_port}',flush=True)
        try:
            server.serve_forever(poll_interval=.1)
        except KeyboardInterrupt:
            pass
        finally:
            server.mock.unload()
            server.mock.stop.set()
            thread.join()
            server.server_close()


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as exc:
        sys.exit(f'Could not start mock bridge: {exc}; use a free --port')
