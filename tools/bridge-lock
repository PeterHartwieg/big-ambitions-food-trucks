#!/usr/bin/env python3
import argparse
import json
import sys
from ftlib import locks
p=argparse.ArgumentParser(description='Independent normal/agent1 ownership, including while the game is stopped')
p.add_argument('action', choices=['setup','status','acquire','release','assert','exec','guarded-exec'])
p.add_argument('--instance',choices=['normal','agent1'],default='normal')
p.add_argument('--owner');p.add_argument('--purpose',default='');p.add_argument('--script');p.add_argument('--parameters',default='{}')
a=p.parse_args()
try:
    if a.action=='setup': locks.provision(); print('Bridge lock controller ready')
    elif a.action in ('exec','guarded-exec'):
        if not a.script: p.error('--script is required')
        print(locks.invoke(a.script,json.loads(a.parameters),a.instance,timeout=600,guarded=a.action=='guarded-exec'))
    else: print(locks.lock_action(a.instance,a.action,a.owner,a.purpose))
except (RuntimeError,ValueError) as e: print(str(e),file=sys.stderr);sys.exit(1)
