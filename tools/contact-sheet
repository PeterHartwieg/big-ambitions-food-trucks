#!/usr/bin/env python3
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ftlib.shots import contact_sheet
if len(sys.argv) != 2:
    sys.exit('Usage: tools/contact-sheet <dir>')
try:
    print(contact_sheet(sys.argv[1]))
except (OSError, ValueError) as exc:
    sys.exit(f'Could not build contact sheet: {exc}; check the folder and report.json')
