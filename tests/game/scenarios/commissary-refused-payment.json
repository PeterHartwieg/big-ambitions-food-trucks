{
  "name": "commissary-refused-payment",
  "checks": "CHECKS.md, Commissary look and payment (0.9.10), row 3",
  "needs": {
    "scene": "city",
    "save_prefix": "FT"
  },
  "steps": [
    {
      "call": "time",
      "args": {
        "pause": true
      }
    },
    {
      "call": "debug",
      "args": {
        "action": "spawn truck"
      }
    },
    {
      "remember": "truck",
      "from": "state",
      "path": "vehicles[kind=truck].id"
    },
    {
      "call": "teleport",
      "args": {
        "who": "$truck",
        "place": "bay:hells-kitchen"
      }
    },
    {
      "call": "debug",
      "args": {
        "action": "licence"
      }
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+1",
          "time": "07:00"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "07:00"
    },
    {
      "call": "money",
      "args": {
        "set": 20000
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "enter"
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "rent_bay"
      }
    },
    {
      "remember": "money",
      "from": "state",
      "path": "money"
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Order stock for delivery to Hell's Kitchen Commissary (opens its texts)"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Order stock"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "ADD ITEM"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Hotdog, box of 500 (0 here)"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "ADD ITEM"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Hotdog, box of 500 (0 here)"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "ORDER"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "list"
      }
    },
    {
      "expect": "result",
      "path": "texts",
      "matches": "paid on delivery here at 08:00 tomorrow"
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Confirm order"
      }
    },
    {
      "wait_event": "Commissary order \\d+: 2 boxes"
    },
    {
      "expect": "state",
      "path": "money",
      "equals": "$money"
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+1",
          "time": "07:59"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "call": "money",
      "args": {
        "set": 1
      }
    },
    {
      "remember": "short_money",
      "from": "state",
      "path": "money"
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+0",
          "time": "08:05"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "08:05"
    },
    {
      "wait_event": "Commissary delivery: order \\d+, .+ not delivered: the payment of \\$.+ was refused \\(not enough money\\); the order is cancelled\\."
    },
    {
      "expect": "state",
      "path": "money",
      "equals": "$short_money"
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 0
    },
    {
      "expect": "state",
      "path": "commissary.stock",
      "length": 0
    },
    {
      "call": "money",
      "args": {
        "set": 20000
      }
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+1",
          "time": "08:05"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "08:05"
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 0
    },
    {
      "expect": "state",
      "path": "commissary.stock",
      "length": 0
    },
    {
      "no_event": "Commissary delivery:.*paid \\$",
      "from_step": 36
    },
    {
      "note": "Money must stay unchanged during refusal. Live daily rent or fines may also change the balance at 04:00; inspect those separately if that check fails."
    }
  ]
}
