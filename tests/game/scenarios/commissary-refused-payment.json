{
  "name": "commissary-refused-payment",
  "checks": "CHECKS.md, Commissary look and payment (0.9.10), row 3",
  "needs": {},
  "steps": [
    {
      "note": "Before running, prepare and save 'FT commissary-refused-payment' by hand: one rented truck, one confirmed two-box Hotdog order due tomorrow, no other orders or commissary stock, with the phone closed. Confirm the order with enough money; the scenario lowers the balance at 07:50 before delivery. The bridge cannot create a new game. This note is manual setup, not an automated check."
    },
    {
      "call": "load",
      "args": {
        "name": "FT commissary-refused-payment"
      }
    },
    {
      "wait_event": "Test bridge: loading 'FT\\ commissary\\-refused\\-payment'",
      "timeout_s": 180
    },
    {
      "wait_state": "scene",
      "timeout_s": 300,
      "equals": "city"
    },
    {
      "wait_state": "save",
      "timeout_s": 300,
      "equals": "FT commissary-refused-payment"
    },
    {
      "wait_state": "licence",
      "not_equals": null,
      "timeout_s": 300
    },
    {
      "call": "time",
      "args": {
        "pause": true
      }
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 1
    },
    {
      "remember": "due",
      "from": "state",
      "path": "commissary.orders.0.due_day"
    },
    {
      "remember": "stock_before",
      "from": "state",
      "path": "commissary.stock"
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "$due",
          "time": "07:00"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "$due",
          "time": "07:50"
        },
        "speed": 1
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "call": "money",
      "args": {
        "set": 1
      }
    },
    {
      "remember": "short_money",
      "from": "state",
      "path": "money"
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "$due",
          "time": "08:05"
        },
        "speed": 1
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "wait_event": "Commissary delivery: order \\d+, .+ not delivered: the payment of \\$.+ was refused \\(not enough money\\); the order is cancelled\\."
    },
    {
      "expect": "state",
      "path": "money",
      "equals": "$short_money"
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 0
    },
    {
      "expect": "state",
      "path": "commissary.stock",
      "equals": "$stock_before"
    },
    {
      "call": "money",
      "args": {
        "set": 20000
      }
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+1",
          "time": "08:05"
        },
        "speed": 1
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 0
    },
    {
      "expect": "state",
      "path": "commissary.stock",
      "equals": "$stock_before"
    },
    {
      "no_event": "Commissary delivery:.*paid \\$",
      "from_step": 26
    },
    {
      "note": "A person calls the commissary again to check zero orders on the way. The restore may pay outstanding rent or fines, so the later balance is not asserted."
    }
  ]
}
