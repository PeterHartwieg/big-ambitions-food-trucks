{
  "name": "commissary-pay-on-delivery",
  "checks": "CHECKS.md, Commissary look and payment (0.9.10), rows 1 and 2",
  "needs": {},
  "steps": [
    {
      "note": "Before running, prepare and save 'FT commissary-pay-on-delivery' by hand: one truck rented at Hell's Kitchen, one confirmed order of two boxes of Hotdog due tomorrow, no other orders or commissary stock, enough money, and the player nearby. Check that money is unchanged when confirming, then save with the phone closed. The bridge cannot create a new game. This note is manual setup, not an automated check."
    },
    {
      "call": "load",
      "args": {
        "name": "FT commissary-pay-on-delivery"
      }
    },
    {
      "wait_event": "Test bridge: loading 'FT\\ commissary\\-pay\\-on\\-delivery'",
      "timeout_s": 180
    },
    {
      "wait_state": "scene",
      "timeout_s": 300,
      "equals": "city"
    },
    {
      "wait_state": "save",
      "timeout_s": 300,
      "equals": "FT commissary-pay-on-delivery"
    },
    {
      "wait_state": "licence",
      "not_equals": null,
      "timeout_s": 300
    },
    {
      "call": "time",
      "args": {
        "pause": true
      }
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 1
    },
    {
      "remember": "due",
      "from": "state",
      "path": "commissary.orders.0.due_day"
    },
    {
      "remember": "truck",
      "from": "state",
      "path": "vehicles[kind=truck].id"
    },
    {
      "wait_state": "vehicles[kind=truck].heading",
      "not_equals": null,
      "timeout_s": 300
    },
    {
      "call": "teleport",
      "args": {
        "who": "player",
        "place": "vehicle:$truck"
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "enter"
      }
    },
    {
      "wait_state": "player.in_vehicle",
      "timeout_s": 300,
      "equals": "$truck"
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "restock"
      }
    },
    {
      "note": "Restock here runs the real nothing-in-stock notice. Ordering, read-back, quantities and confirmation were done by the person before this save; inspect their Phone lines for row 1."
    },
    {
      "call": "time",
      "args": {
        "pause": false
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "exit"
      }
    },
    {
      "wait_state": "player.in_vehicle",
      "timeout_s": 300,
      "equals": null
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "$due",
          "time": "07:00"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "$due",
          "time": "07:50"
        },
        "speed": 1
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "remember": "before_delivery",
      "from": "state",
      "path": "money"
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "$due",
          "time": "08:05"
        },
        "speed": 1
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "wait_event": "Commissary delivery: order \\d+, .+ paid \\$.+ on delivery \\(goods \\$.+, fee \\$.+\\)\\."
    },
    {
      "expect": "state",
      "path": "money",
      "less": "$before_delivery"
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 0
    },
    {
      "expect": "state",
      "path": "commissary.stock[site=hells-kitchen].amount",
      "greater": 0
    },
    {
      "note": "Review the bank transaction, deductible goods and delivery fee in Econoview. They are not in state. The game may overshoot 08:05 by a frame, so this scenario checks pause and normal speed rather than exact minutes."
    }
  ]
}
