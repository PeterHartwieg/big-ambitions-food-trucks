{
  "name": "commissary-pay-on-delivery",
  "checks": "CHECKS.md, Commissary look and payment (0.9.10), rows 1 and 2",
  "needs": {},
  "steps": [
    {
      "note": "Use FT saves from a new character of their own, never a series city saved under a new name. Prepare 'FT commissary-pay-on-delivery' by hand: exactly one licensed, closed truck with a space rented and the commissary unlocked at Hell's Kitchen, on foot nearby before delivery hour, no open screens, other orders, commissary stock or order transactions in the last two days. Do not confirm an order beforehand. The scenario creates one; new_game is unavailable."
    },
    {
      "call": "load",
      "args": {
        "name": "FT commissary-pay-on-delivery"
      }
    },
    {
      "wait_state": "load.status",
      "timeout_s": 300,
      "not_equals": "pending"
    },
    {
      "expect": "state",
      "path": "load.status",
      "equals": "done"
    },
    {
      "expect": "state",
      "path": "load.error",
      "equals": null
    },
    {
      "wait_state": "scene",
      "timeout_s": 300,
      "equals": "city"
    },
    {
      "expect": "state",
      "path": "save",
      "equals": "FT commissary-pay-on-delivery"
    },
    {
      "wait_state": "licence",
      "timeout_s": 300,
      "not_equals": null
    },
    {
      "call": "time",
      "args": {
        "pause": true
      }
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 0
    },
    {
      "expect": "state",
      "path": "commissary.stock",
      "length": 0
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_commissary_order"
      },
      "length": 0
    },
    {
      "remember": "order_money",
      "from": "state",
      "path": "money"
    },
    {
      "call": "commissary",
      "args": {
        "op": "order",
        "site": "hells-kitchen",
        "items": [
          {
            "item": "ba:itemname_hotdog",
            "boxes": 2
          }
        ]
      }
    },
    {
      "expect": "result",
      "path": "orders",
      "length": 1
    },
    {
      "expect": "result",
      "path": "orders.0.goods",
      "greater": 0
    },
    {
      "expect": "result",
      "path": "orders.0.fee",
      "greater": 0
    },
    {
      "remember": "order_charge",
      "from": "result",
      "path": "orders.0.total",
      "scale": -1
    },
    {
      "remember": "due",
      "from": "result",
      "path": "orders.0.due_day"
    },
    {
      "remember": "units",
      "from": "result",
      "path": "orders.0.units"
    },
    {
      "expect": "state",
      "path": "money",
      "equals": "$order_money"
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_commissary_order"
      },
      "length": 0
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 1
    },
    {
      "wait_event": "Commissary order [0-9]+: .+paid on delivery; due day",
      "after_step": 13
    },
    {
      "note": "Phone counterpart for row 1: a person calls Hell's Kitchen Commissary from Contacts, then uses 'Order stock', adds Hotdog and sets two boxes, 'Order', and 'Confirm order'. The bridge exposes no quantity inputs; the game's picker/item controls and confirm label still need a live ui list. Run that phone path separately from this payment run so it does not create a second order. The automatic order above uses the same quote/confirm code."
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "$due",
          "time": "07:59"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.run_until",
      "equals": null
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "07:59"
    },
    {
      "expect": "state",
      "path": "clock.arrived_at",
      "matches": "^day [0-9]+ 07:59$"
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_commissary_order"
      },
      "length": 0
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 1
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "$due",
          "time": "08:00"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.run_until",
      "equals": null
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "08:00"
    },
    {
      "expect": "state",
      "path": "clock.arrived_at",
      "matches": "^day [0-9]+ 08:00$"
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "wait_event": "Commissary delivery: order .+ paid .+ on delivery",
      "after_step": 33
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 0
    },
    {
      "expect": "state",
      "path": "commissary.stock[site=hells-kitchen].amount",
      "equals": "$units"
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_commissary_order",
        "day": "$due"
      },
      "length": 1
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_commissary_order",
        "day": "$due"
      },
      "pick": "[0].amount",
      "equals": "$order_charge"
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_commissary_order",
        "day": "$due"
      },
      "pick": "[0].time",
      "equals": "08:00"
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_commissary_order",
        "day": "$due"
      },
      "pick": "[0].label",
      "equals": "Commissary order from Hell's Kitchen Commissary"
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+0",
          "time": "08:05"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.run_until",
      "equals": null
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "08:05"
    },
    {
      "expect": "state",
      "path": "clock.arrived_at",
      "matches": "^day [0-9]+ 08:05$"
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_commissary_order",
        "day": "$due"
      },
      "length": 1
    },
    {
      "note": "A person checks the phone messages and day summary presentation. The automatic checks use exact transaction amounts, dates, labels and counts, independent of rent and other charges."
    }
  ]
}
