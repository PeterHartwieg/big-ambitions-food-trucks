{
  "name": "commissary-pay-on-delivery",
  "checks": "CHECKS.md, Commissary look and payment (0.9.10), rows 1 and 2",
  "needs": {
    "scene": "city",
    "save_prefix": "FT"
  },
  "steps": [
    {
      "call": "time",
      "args": {
        "pause": true
      }
    },
    {
      "call": "debug",
      "args": {
        "action": "spawn truck"
      }
    },
    {
      "remember": "truck",
      "from": "state",
      "path": "vehicles[kind=truck].id"
    },
    {
      "call": "teleport",
      "args": {
        "who": "$truck",
        "place": "bay:hells-kitchen"
      }
    },
    {
      "call": "debug",
      "args": {
        "action": "licence"
      }
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+1",
          "time": "07:00"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "07:00"
    },
    {
      "call": "money",
      "args": {
        "set": 20000
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "enter"
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "rent_bay"
      }
    },
    {
      "remember": "money",
      "from": "state",
      "path": "money"
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Order stock for delivery to Hell's Kitchen Commissary (opens its texts)"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Order stock"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "ADD ITEM"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Hotdog, box of 500 (0 here)"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "ADD ITEM"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Hotdog, box of 500 (0 here)"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "ORDER"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "list"
      }
    },
    {
      "expect": "result",
      "path": "texts",
      "matches": "paid on delivery here at 08:00 tomorrow"
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Confirm order"
      }
    },
    {
      "wait_event": "Commissary order \\d+: 2 boxes, .+ at .+ paid on delivery; due day \\d+ at 08:00\\."
    },
    {
      "expect": "state",
      "path": "money",
      "equals": "$money"
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 1
    },
    {
      "remember": "order_total",
      "from": "state",
      "path": "commissary.orders.0.total"
    },
    {
      "note": "Order setup uses the phone. Check the item label and quantity controls against the first live bridge run. Transaction history and delivery-fee accounting are not exposed by state."
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+1",
          "time": "07:59"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "07:59"
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 1
    },
    {
      "expect": "state",
      "path": "commissary.stock",
      "length": 0
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+0",
          "time": "08:05"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "08:05"
    },
    {
      "wait_event": "Commissary delivery: order \\d+, .+ at .+ \\(ordered day .+, due day \\d+\\), paid \\$.+ on delivery \\(goods \\$.+, fee \\$.+\\)\\."
    },
    {
      "expect": "state",
      "path": "money",
      "less": "$money"
    },
    {
      "expect": "state",
      "path": "commissary.orders",
      "length": 0
    },
    {
      "expect": "state",
      "path": "commissary.stock[site=hells-kitchen].amount",
      "greater": 0
    }
  ]
}
