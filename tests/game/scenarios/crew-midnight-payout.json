{
  "name": "crew-midnight-payout",
  "checks": "CHECKS.md, Commissary look and payment (0.9.10), rows 14 and 16",
  "needs": {
    "scene": "city",
    "save_prefix": "FT"
  },
  "steps": [
    {
      "call": "time",
      "args": {
        "pause": true
      }
    },
    {
      "call": "debug",
      "args": {
        "action": "spawn truck"
      }
    },
    {
      "remember": "truck",
      "from": "state",
      "path": "vehicles[kind=truck].id"
    },
    {
      "call": "teleport",
      "args": {
        "who": "$truck",
        "place": "bay:hells-kitchen"
      }
    },
    {
      "call": "debug",
      "args": {
        "action": "licence"
      }
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+1",
          "time": "07:00"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "07:00"
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "enter"
      }
    },
    {
      "call": "debug",
      "args": {
        "action": "new items"
      }
    },
    {
      "call": "debug",
      "args": {
        "action": "hire"
      }
    },
    {
      "wait_event": "Debug: hired .+ customer service 60"
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Hires"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Crew 1"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "list"
      }
    },
    {
      "expect": "result",
      "path": "buttons.1.text",
      "matches": "customer service|service"
    },
    {
      "remember": "worker_option",
      "from": "result",
      "path": "buttons.1.text"
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "$worker_option"
      }
    },
    {
      "wait_event": "Crew: .+ on truck .+"
    },
    {
      "expect": "state",
      "path": "vehicles[kind=truck].crew",
      "length": 1
    },
    {
      "call": "ui",
      "args": {
        "op": "escape"
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "enter"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Add stop here"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "08:30"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "00:00"
      }
    },
    {
      "expect": "state",
      "path": "vehicles[kind=truck].route.stops",
      "equals": 1
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "exit"
      }
    },
    {
      "call": "teleport",
      "args": {
        "who": "player",
        "x": 0,
        "z": 0
      }
    },
    {
      "remember": "morning_money",
      "from": "state",
      "path": "money"
    },
    {
      "note": "Crew option index 1 assumes one fresh unassigned hire. This is a provisional UI flow. The route uses the panel Add stop here flow. Stay awake and over 100 m away."
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+0",
          "time": "23:59"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "23:59"
    },
    {
      "expect": "state",
      "path": "vehicles[kind=truck].serving",
      "equals": "crew"
    },
    {
      "expect": "state",
      "path": "money",
      "equals": "$morning_money"
    },
    {
      "expect": "state",
      "path": "ledger_today.crew_waiting",
      "greater": 0
    },
    {
      "wait_event": "Crew sales: .+, day \\d+ \\d\\d:00 hour: .+ paid in after midnight;"
    },
    {
      "no_event": "Sale:|Notice:.*(?:sale|sold)",
      "from_step": 30
    },
    {
      "remember": "before_midnight",
      "from": "state",
      "path": "money"
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+1",
          "time": "00:05"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "00:05"
    },
    {
      "wait_event": "Crew sales: .+, day \\d+ 23:00 hour:"
    },
    {
      "wait_event": "Route: truck .+ caught up to minute \\d+ for the day\\x27s close\\."
    },
    {
      "wait_event": "Crew sales paid in: .+ \\(.+\\), day \\d+: \\d+ items, \\$.+\\."
    },
    {
      "expect": "state",
      "path": "money",
      "greater": "$before_midnight"
    },
    {
      "expect": "state",
      "path": "ledger_today.crew_waiting",
      "equals": 0
    },
    {
      "no_event": "Crew sales paid in:",
      "from_step": 45
    },
    {
      "note": "The payout checks one payment in this interval. The live wage, rent, transactions and day-summary values need review because state does not expose transaction history."
    }
  ]
}
