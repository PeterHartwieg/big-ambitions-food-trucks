{
  "name": "crew-midnight-payout",
  "checks": "CHECKS.md, Commissary look and payment (0.9.10), rows 14 and 16",
  "needs": {},
  "steps": [
    {
      "note": "Before running, prepare and save 'FT crew-midnight-payout' by hand: exactly one stocked, licensed truck with one crew member and a legal daily route 08:30 to midnight (select 00:00 in Closes at), enough stock for the day, at 07:00 with the player near it. Hire with debug hire, assign the worker in BizMan and confirm the route time pickers by hand before saving. Close the phone. The bridge cannot create a new game. This note is manual setup, not an automated check."
    },
    {
      "call": "load",
      "args": {
        "name": "FT crew-midnight-payout"
      }
    },
    {
      "wait_event": "Test bridge: loading 'FT\\ crew\\-midnight\\-payout'",
      "timeout_s": 180
    },
    {
      "wait_state": "scene",
      "timeout_s": 300,
      "equals": "city"
    },
    {
      "wait_state": "save",
      "timeout_s": 300,
      "equals": "FT crew-midnight-payout"
    },
    {
      "wait_state": "licence",
      "not_equals": null,
      "timeout_s": 300
    },
    {
      "call": "time",
      "args": {
        "pause": true
      }
    },
    {
      "remember": "truck",
      "from": "state",
      "path": "vehicles[kind=truck].id"
    },
    {
      "expect": "state",
      "path": "vehicles[kind=truck].crew",
      "length": 1
    },
    {
      "expect": "state",
      "path": "vehicles[kind=truck].route.stops",
      "equals": 1
    },
    {
      "wait_state": "vehicles[kind=truck].heading",
      "not_equals": null,
      "timeout_s": 300
    },
    {
      "call": "teleport",
      "args": {
        "who": "player",
        "place": "vehicle:$truck"
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "enter"
      }
    },
    {
      "wait_state": "player.in_vehicle",
      "timeout_s": 300,
      "equals": "$truck"
    },
    {
      "call": "ui",
      "args": {
        "op": "click",
        "text": "Hires"
      }
    },
    {
      "call": "ui",
      "args": {
        "op": "list"
      }
    },
    {
      "note": "The crew page has three copies of employee options. Assignment needs the right row id after inspecting ui list; the scenario uses the crew and route prepared in the save, rather than choosing an arbitrary option index."
    },
    {
      "call": "ui",
      "args": {
        "op": "escape"
      }
    },
    {
      "call": "time",
      "args": {
        "pause": false
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "exit"
      }
    },
    {
      "wait_state": "player.in_vehicle",
      "timeout_s": 300,
      "equals": null
    },
    {
      "call": "teleport",
      "args": {
        "who": "player",
        "place": "commissary:industry-city"
      }
    },
    {
      "remember": "morning_money",
      "from": "state",
      "path": "money"
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+0",
          "time": "23:00"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+0",
          "time": "23:50"
        },
        "speed": 1
      }
    },
    {
      "wait_state": "clock.paused",
      "equals": true,
      "timeout_s": 300
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "expect": "state",
      "path": "vehicles[kind=truck].serving",
      "equals": "crew"
    },
    {
      "expect": "state",
      "path": "ledger_today.crew_waiting",
      "greater": 0
    },
    {
      "wait_event": "Crew sales: .+, day \\d+ \\d\\d:00 hour: .+ paid in after midnight;"
    },
    {
      "no_event": "Sale:|Notice:.*(?:sale|sold)|Crew sales paid in:",
      "from_step": 23
    },
    {
      "remember": "before_midnight",
      "from": "state",
      "path": "money"
    },
    {
      "note": "Compare morning and evening money separately from vanilla parking or other charges. State exposes no transactions, so an unchanged net balance is not a reliable automated check of crew sales."
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+1",
          "time": "00:05"
        },
        "speed": 1
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "wait_event": "Crew sales: .+, day \\d+ 23:00 hour:"
    },
    {
      "wait_event": "Route: truck .+ caught up to minute \\d+ for the day\\x27s close\\."
    },
    {
      "wait_event": "Crew sales paid in: .+ \\(.+\\), day \\d+: \\d+ items, \\$.+\\."
    },
    {
      "expect": "state",
      "path": "ledger_today.crew_waiting",
      "equals": 0
    },
    {
      "no_event": "Crew sales paid in:",
      "from_step": 41
    },
    {
      "note": "Check the previous-day transaction date and day summary by hand. Net money may include simultaneous wages and other midnight payments."
    },
    {
      "note": "A person watches the crew at 23:59 at normal speed. The automated pre-midnight check stops at 23:50, not 23:59, because a frame of overshoot could otherwise pay the crew before that check."
    }
  ]
}
