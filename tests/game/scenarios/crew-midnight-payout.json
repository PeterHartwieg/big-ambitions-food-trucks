{
  "name": "crew-midnight-payout",
  "checks": "CHECKS.md, Commissary look and payment (0.9.10), rows 14 and 16",
  "needs": {},
  "steps": [
    {
      "note": "Use FT saves from a new character of their own, never a series city saved under a new name. Prepare 'FT crew-midnight-payout' by hand: exactly one licensed, stocked truck at a busy legal pitch, a single route stop from 08:30 through midnight (closes 00:00), no crew assigned, no other food vehicles, no unassigned hires or crew takings/transactions in the last two days. Set the route via the map by hand, then save on foot at 07:00 with all screens closed. The scenario hires and assigns its worker."
    },
    {
      "call": "load",
      "args": {
        "name": "FT crew-midnight-payout"
      }
    },
    {
      "wait_state": "load.status",
      "timeout_s": 300,
      "not_equals": "pending"
    },
    {
      "expect": "state",
      "path": "load.status",
      "equals": "done"
    },
    {
      "expect": "state",
      "path": "load.error",
      "equals": null
    },
    {
      "wait_state": "scene",
      "timeout_s": 300,
      "equals": "city"
    },
    {
      "expect": "state",
      "path": "save",
      "equals": "FT crew-midnight-payout"
    },
    {
      "wait_state": "licence",
      "timeout_s": 300,
      "not_equals": null
    },
    {
      "call": "time",
      "args": {
        "pause": true
      }
    },
    {
      "remember": "truck",
      "from": "state",
      "path": "vehicles[kind=truck].id"
    },
    {
      "remember": "truck_name",
      "from": "state",
      "path": "vehicles[kind=truck].name"
    },
    {
      "expect": "state",
      "path": "vehicles[kind=truck].crew",
      "length": 0
    },
    {
      "expect": "state",
      "path": "employees",
      "length": 0
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_crew_sales"
      },
      "length": 0
    },
    {
      "call": "debug",
      "args": {
        "action": "hire"
      }
    },
    {
      "remember": "worker",
      "from": "state",
      "path": "employees.0.id"
    },
    {
      "call": "crew",
      "args": {
        "op": "assign",
        "vehicle": "$truck",
        "employee_id": "$worker"
      }
    },
    {
      "expect": "result",
      "path": "done",
      "equals": true
    },
    {
      "call": "crew",
      "args": {
        "op": "auto_schedule",
        "vehicle": "$truck"
      }
    },
    {
      "expect": "result",
      "path": "done",
      "equals": true
    },
    {
      "expect": "state",
      "path": "vehicles[kind=truck].crew",
      "length": 1
    },
    {
      "expect": "state",
      "path": "employees",
      "length": 0
    },
    {
      "call": "crew",
      "args": {
        "op": "unassign",
        "vehicle": "$truck",
        "employee_id": "$worker"
      }
    },
    {
      "expect": "result",
      "path": "done",
      "equals": true
    },
    {
      "expect": "state",
      "path": "employees",
      "length": 1
    },
    {
      "call": "crew",
      "args": {
        "op": "assign",
        "vehicle": "$truck",
        "employee_id": "$worker"
      }
    },
    {
      "expect": "result",
      "path": "done",
      "equals": true
    },
    {
      "call": "crew",
      "args": {
        "op": "auto_schedule",
        "vehicle": "$truck"
      }
    },
    {
      "expect": "result",
      "path": "done",
      "equals": true
    },
    {
      "call": "teleport",
      "args": {
        "who": "player",
        "place": "commissary:industry-city"
      }
    },
    {
      "wait_state": "player.activity",
      "timeout_s": 300,
      "equals": "on_foot"
    },
    {
      "wait_state": "player.clock_held_by",
      "timeout_s": 300,
      "equals": null
    },
    {
      "remember": "sold_day",
      "from": "state",
      "path": "clock.day"
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+0",
          "time": "23:59"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.run_until",
      "equals": null
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "23:59"
    },
    {
      "expect": "state",
      "path": "clock.arrived_at",
      "matches": "^day [0-9]+ 23:59$"
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "expect": "state",
      "path": "vehicles[kind=truck].serving",
      "equals": "crew"
    },
    {
      "expect": "state",
      "path": "ledger_today.crew_waiting",
      "greater": 0
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_crew_sales"
      },
      "length": 0
    },
    {
      "wait_event": "Crew sales: .+, day [0-9]+ [0-9][0-9]:00 hour: .+ paid in after midnight;",
      "after_step": 29
    },
    {
      "no_event": "Sale:|Street food sales paid in:",
      "from_step": 29
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+1",
          "time": "00:00"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.run_until",
      "equals": null
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "00:00"
    },
    {
      "expect": "state",
      "path": "clock.arrived_at",
      "matches": "^day [0-9]+ 00:00$"
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "wait_event": "Crew sales: .+, day [0-9]+ 23:00 hour:",
      "after_step": 40
    },
    {
      "wait_event": "Route: truck .+ caught up to minute [0-9]+ for the day's close\\.",
      "after_step": 40
    },
    {
      "wait_event": "Street food sales paid in: .+ \\(.+\\), day (?P<day>[0-9]+): (?P<sales>[0-9]+) items, \\$(?P<amount>[0-9,]+\\.[0-9]{2})\\.",
      "captures": {
        "paid_amount": "amount",
        "paid_day": "day",
        "paid_sales": "sales"
      },
      "after_step": 40
    },
    {
      "expect": "state",
      "path": "ledger_today.crew_waiting",
      "equals": 0
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_crew_sales",
        "day": "$sold_day"
      },
      "length": 1
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_crew_sales",
        "day": "$sold_day"
      },
      "pick": "[0].amount",
      "equals": "$paid_amount"
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_crew_sales",
        "day": "$sold_day"
      },
      "pick": "[0].day",
      "equals": "$paid_day"
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_crew_sales",
        "day": "$sold_day"
      },
      "pick": "[0].label",
      "contains": "$truck_name"
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+0",
          "time": "00:05"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.run_until",
      "equals": null
    },
    {
      "expect": "state",
      "path": "clock.time",
      "equals": "00:05"
    },
    {
      "expect": "state",
      "path": "clock.arrived_at",
      "matches": "^day [0-9]+ 00:05$"
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "expect": "state",
      "path": "transactions_today",
      "where": {
        "type": "foodtrucks:transaction_crew_sales",
        "day": "$sold_day"
      },
      "length": 1
    },
    {
      "no_event": "Street food sales paid in:",
      "from_step": 54
    },
    {
      "note": "The payment amount is checked against the paid-in log, including the final minute, and there must be exactly one crew revenue transaction for the sold day. A person checks worker placement, wages and the displayed day summary."
    }
  ]
}
