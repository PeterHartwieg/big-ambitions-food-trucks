{
  "name": "hatch-only-selling",
  "checks": "CHECKS.md, Truck serves only from the hatch (0.9.8), rows 1, 2 and 3",
  "needs": {},
  "steps": [
    {
      "note": "Before running, prepare and save 'FT hatch-only-selling' by hand: exactly one stocked, licensed truck without crew, legal parking with the hatch to the pavement at a busy pitch, before lunch. Save on foot nearby with no screen open. The bridge cannot create a new game. This note is manual setup, not an automated check."
    },
    {
      "call": "load",
      "args": {
        "name": "FT hatch-only-selling"
      }
    },
    {
      "wait_event": "Test bridge: loading 'FT\\ hatch\\-only\\-selling'",
      "timeout_s": 180
    },
    {
      "wait_state": "scene",
      "timeout_s": 300,
      "equals": "city"
    },
    {
      "wait_state": "save",
      "timeout_s": 300,
      "equals": "FT hatch-only-selling"
    },
    {
      "wait_state": "licence",
      "not_equals": null,
      "timeout_s": 300
    },
    {
      "call": "time",
      "args": {
        "pause": true
      }
    },
    {
      "remember": "truck",
      "from": "state",
      "path": "vehicles[kind=truck].id"
    },
    {
      "wait_state": "vehicles[kind=truck].heading",
      "not_equals": null,
      "timeout_s": 300
    },
    {
      "call": "teleport",
      "args": {
        "who": "player",
        "place": "vehicle:$truck"
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "enter"
      }
    },
    {
      "wait_state": "player.in_vehicle",
      "timeout_s": 300,
      "equals": "$truck"
    },
    {
      "call": "time",
      "args": {
        "speed": 20
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "open"
      }
    },
    {
      "wait_state": "player.at_hatch",
      "timeout_s": 300,
      "equals": "$truck"
    },
    {
      "wait_state": "vehicles[kind=truck].serving",
      "timeout_s": 300,
      "equals": "player"
    },
    {
      "wait_event": "Sale:",
      "timeout_s": 300
    },
    {
      "call": "time",
      "args": {
        "pause": true
      }
    },
    {
      "remember": "stock_before",
      "from": "state",
      "path": "vehicles[kind=truck].stock"
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "step_out"
      }
    },
    {
      "wait_state": "player.at_hatch",
      "timeout_s": 300,
      "equals": null
    },
    {
      "expect": "state",
      "path": "vehicles[kind=truck].open",
      "equals": true
    },
    {
      "expect": "state",
      "path": "vehicles[kind=truck].serving",
      "equals": "nobody"
    },
    {
      "note": "No run_until is attempted at the hatch: an activity may hold the clock during its startup. On foot, advance to tomorrow at 11:00 so the waiting queue has time to leave."
    },
    {
      "call": "time",
      "args": {
        "run_until": {
          "day": "+1",
          "time": "11:00"
        },
        "speed": 20
      }
    },
    {
      "wait_state": "clock.paused",
      "timeout_s": 300,
      "equals": true
    },
    {
      "expect": "state",
      "path": "clock.speed",
      "equals": 1
    },
    {
      "expect": "state",
      "path": "vehicles[kind=truck].stock",
      "equals": "$stock_before"
    },
    {
      "no_event": "Sale:",
      "from_step": 19
    },
    {
      "call": "time",
      "args": {
        "speed": 20
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "back_to_hatch"
      }
    },
    {
      "wait_state": "player.at_hatch",
      "timeout_s": 300,
      "equals": "$truck"
    },
    {
      "wait_state": "vehicles[kind=truck].serving",
      "timeout_s": 300,
      "equals": "player"
    },
    {
      "wait_event": "Sale:",
      "timeout_s": 300
    },
    {
      "call": "time",
      "args": {
        "pause": true
      }
    },
    {
      "call": "vehicle",
      "args": {
        "id": "$truck",
        "op": "close"
      }
    },
    {
      "note": "A person judges queue abandonment, angry emoji and the position and styling of Back to the hatch. That button is not a driving-panel button."
    }
  ]
}
