<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>FoodTrucks.Core</RootNamespace>
    <AssemblyName>FoodTrucks.Core</AssemblyName>
    <Version>0.10.12</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="'$(FoodTrucksTestFaults)' == 'true'">
    <DefineConstants>$(DefineConstants);FOODTRUCKS_TEST_FAULTS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FoodTrucksTestContract2)' == 'true'">
    <DefineConstants>$(DefineConstants);FOODTRUCKS_TEST_CONTRACT2</DefineConstants>
  </PropertyGroup>
  <Target Name="FoodTrucksOneTestVariant" BeforeTargets="CoreCompile" Condition="'$(FoodTrucksTestFaults)' == 'true' And '$(FoodTrucksTestContract2)' == 'true'">
    <Error Text="FoodTrucksTestFaults and FoodTrucksTestContract2 are separate test builds; set one of them, not both." />
  </Target>
</Project>
